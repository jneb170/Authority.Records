<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Authority.Records.DataMigration" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings here are only for EF design-time CLI (migrations). -->
    <!-- Startup projects (UI, Api) own their own appsettings for publish. -->
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packages below are provided by the Microsoft.AspNetCore.App shared framework
         (referenced above), so they are intentionally NOT listed here:
         Microsoft.AspNetCore.Http, Microsoft.Extensions.Configuration(.FileExtensions/.Json),
         Microsoft.Extensions.Hosting.Abstractions, Microsoft.Extensions.Options.ConfigurationExtensions.
         Re-adding explicit PackageReferences triggers NU1510. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!-- Security pin (issue #102): Microsoft.Data.SqlClient 6.1.x (via EF Core SqlServer) pulls in
         System.Security.Cryptography.Pkcs 9.0.x, which has high/moderate advisories
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Reference the patched version directly so every
         project that depends on Shared.Infrastructure resolves it. Remove once SqlClient depends on a
         patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Polly" Version="8.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules.Records.Application\Modules.Records.Application.csproj" />
    <ProjectReference Include="..\Modules.Records.Domain\Modules.Records.Domain.csproj" />
  </ItemGroup>

</Project>

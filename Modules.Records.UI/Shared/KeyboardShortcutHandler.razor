@inject IJSRuntime JS
@inject IKeyboardShortcutService ShortcutService
@inject IHotkeyConfigService HotkeyConfig
@using Microsoft.JSInterop
@using Modules.Records.UI.Services
@implements IAsyncDisposable

@* Non-rendering component — manages the global keyboard shortcut JS listener. *@

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<KeyboardShortcutHandler>? _dotnetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var bindings = await HotkeyConfig.GetBindingsAsync();

        _dotnetRef = DotNetObjectReference.Create(this);
        _module    = await JS.InvokeAsync<IJSObjectReference>("import", "/js/shortcuts.js");
        await _module.InvokeVoidAsync("registerShortcuts", _dotnetRef, new
        {
            @new    = bindings.New,
            modify  = bindings.Modify,
            save    = bindings.Save,
            release = bindings.Release,
        });
    }

    [JSInvokable]
    public void InvokeShortcut(string key) => ShortcutService.Invoke(key);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterShortcuts");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        _dotnetRef?.Dispose();
    }
}

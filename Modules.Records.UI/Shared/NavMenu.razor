<a href="/" class="sidebar-brand" @onclick="OnNavClicked">
    <span class="sidebar-brand-icon-wrap">
        <img src="/favicon.svg" width="24" height="24" alt="AR" />
    </span>
    <span class="sidebar-brand-text">
        Authority Records
        <span class="sidebar-brand-sub">Records Management</span>
    </span>
</a>

<nav class="nav flex-column px-0 pb-2 sidebar-nav">
    <AuthorizeView Roles="Admin,Supervisor,Officer,Dispatcher">
        <div class="sidebar-section">
            <button type="button"
                    class="sidebar-section-toggle"
                    aria-expanded="@_operationsExpanded"
                    @onclick="ToggleOperations">
                <span>Operations</span>
                <i class="bi bi-chevron-down sidebar-section-chevron" aria-hidden="true"></i>
            </button>

            <div class="@GetSectionContentClass(_operationsExpanded)">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="OnNavClicked" title="Home">
                    <i class="bi bi-house-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Home</span>
                        <span class="nav-label-short">Home</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="incidents" @onclick="OnNavClicked" title="Incidents">
                    <i class="bi bi-clipboard2-pulse-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Incidents</span>
                        <span class="nav-label-short">Incidents</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="arrests" @onclick="OnNavClicked" title="Arrests">
                    <i class="bi bi-person-badge-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Arrests</span>
                        <span class="nav-label-short">Arrests</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="citations" @onclick="OnNavClicked" title="Citations">
                    <i class="bi bi-file-earmark-text-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Citations</span>
                        <span class="nav-label-short">Citations</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="names" @onclick="OnNavClicked" title="Names (MNI)">
                    <i class="bi bi-people-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Names (MNI)</span>
                        <span class="nav-label-short">Names</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="locations" @onclick="OnNavClicked" title="Locations (MLI)">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Locations (MLI)</span>
                        <span class="nav-label-short">Locations</span>
                    </span>
                </NavLink>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Supervisor">
        <div class="sidebar-section">
            <button type="button"
                    class="sidebar-section-toggle"
                    aria-expanded="@_administrationExpanded"
                    @onclick="ToggleAdministration">
                <span>Administration</span>
                <i class="bi bi-chevron-down sidebar-section-chevron" aria-hidden="true"></i>
            </button>

            <div class="@GetSectionContentClass(_administrationExpanded)">
                <NavLink class="nav-link" href="admin/configurations" @onclick="OnNavClicked" title="Configurations">
                    <i class="bi bi-gear-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Configurations</span>
                        <span class="nav-label-short">Config</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="admin/picklists" @onclick="OnNavClicked" title="Picklist Items">
                    <i class="bi bi-list-ul"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Picklist Items</span>
                        <span class="nav-label-short">Picklists</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="admin/charges" @onclick="OnNavClicked" title="Charges">
                    <i class="bi bi-exclamation-diamond-fill"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Charges</span>
                        <span class="nav-label-short">Charges</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="admin/test-data" @onclick="OnNavClicked" title="Test Data">
                    <i class="bi bi-flask"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Test Data</span>
                        <span class="nav-label-short">Test Data</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="admin/read-model-rebuild" @onclick="OnNavClicked" title="Read Model Rebuild">
                    <i class="bi bi-arrow-repeat"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Read Model Rebuild</span>
                        <span class="nav-label-short">Rebuild</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="admin/logs" @onclick="OnNavClicked" title="Logs">
                    <i class="bi bi-journal-text"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Logs</span>
                        <span class="nav-label-short">Logs</span>
                    </span>
                </NavLink>

                <AuthorizeView Roles="Admin" Context="adminContext">
                    <NavLink class="nav-link" href="admin/agencies" @onclick="OnNavClicked" title="Agencies">
                        <i class="bi bi-building-fill"></i>
                        <span class="nav-link-label">
                            <span class="nav-label-full">Agencies</span>
                            <span class="nav-label-short">Agencies</span>
                        </span>
                    </NavLink>
                    <NavLink class="nav-link" href="admin/users" @onclick="OnNavClicked" title="Users">
                        <i class="bi bi-person-lines-fill"></i>
                        <span class="nav-link-label">
                            <span class="nav-label-full">Users</span>
                            <span class="nav-label-short">Users</span>
                        </span>
                    </NavLink>
                    <NavLink class="nav-link" href="admin/hotkeys" @onclick="OnNavClicked" title="Hotkey Settings">
                        <i class="bi bi-keyboard"></i>
                        <span class="nav-link-label">
                            <span class="nav-label-full">Hotkey Settings</span>
                            <span class="nav-label-short">Hotkeys</span>
                        </span>
                    </NavLink>
                    <NavLink class="nav-link" href="admin/location-settings" @onclick="OnNavClicked" title="Location Settings">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span class="nav-link-label">
                            <span class="nav-label-full">Location Settings</span>
                            <span class="nav-label-short">Location</span>
                        </span>
                    </NavLink>
                </AuthorizeView>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="Super">
        <div class="sidebar-section">
            <button type="button"
                    class="sidebar-section-toggle"
                    aria-expanded="@_superAdminExpanded"
                    @onclick="ToggleSuperAdmin">
                <span>Super Admin</span>
                <i class="bi bi-chevron-down sidebar-section-chevron" aria-hidden="true"></i>
            </button>

            <div class="@GetSectionContentClass(_superAdminExpanded)">
                <NavLink class="nav-link" href="super/jurisdictions" @onclick="OnNavClicked" title="Jurisdictions">
                    <i class="bi bi-bank"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Jurisdictions</span>
                        <span class="nav-label-short">Jurisdictions</span>
                    </span>
                </NavLink>
                <NavLink class="nav-link" href="super/logs" @onclick="OnNavClicked" title="Logs">
                    <i class="bi bi-journal-richtext"></i>
                    <span class="nav-link-label">
                        <span class="nav-label-full">Logs</span>
                        <span class="nav-label-short">Logs</span>
                    </span>
                </NavLink>
            </div>
        </div>
    </AuthorizeView>
</nav>

<div class="sidebar-footer">
    <div class="sidebar-footer-label">Session</div>
    <a href="/account/logout" class="nav-link" title="Sign Out" @onclick="OnNavClicked">
        <i class="bi bi-box-arrow-left"></i>
        <span class="nav-link-label">
            <span class="nav-label-full">Sign Out</span>
            <span class="nav-label-short">Sign Out</span>
        </span>
    </a>
</div>

@code {
    [Parameter] public EventCallback OnNavLinkClicked { get; set; }

    private bool _operationsExpanded = true;
    private bool _administrationExpanded = true;
    private bool _superAdminExpanded = true;

    private string GetSectionContentClass(bool isExpanded)
        => isExpanded ? "sidebar-section-content expanded" : "sidebar-section-content collapsed";

    private void ToggleOperations() => _operationsExpanded = !_operationsExpanded;
    private void ToggleAdministration() => _administrationExpanded = !_administrationExpanded;
    private void ToggleSuperAdmin() => _superAdminExpanded = !_superAdminExpanded;
    private void OnNavClicked() => OnNavLinkClicked.InvokeAsync();
}

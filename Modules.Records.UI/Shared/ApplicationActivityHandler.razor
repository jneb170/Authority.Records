@inject IJSRuntime JS
@inject NavigationManager Nav
@inject global::Shared.Infrastructure.Maintenance.IApplicationActivityTracker ActivityTracker
@using Microsoft.JSInterop
@implements IAsyncDisposable
@implements IDisposable

@code {
    private const int ActivityThrottleMilliseconds = 15000;

    private IJSObjectReference? _module;
    private DotNetObjectReference<ApplicationActivityHandler>? _dotnetRef;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        ActivityTracker.RecordActivity();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotnetRef = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/applicationActivity.js");
        await _module.InvokeVoidAsync("registerActivityTracking", _dotnetRef, ActivityThrottleMilliseconds);
    }

    [JSInvokable]
    public void RecordClientActivity() => ActivityTracker.RecordActivity();

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
        => ActivityTracker.RecordActivity();

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterActivityTracking");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }

        _dotnetRef?.Dispose();
    }
}

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Shared.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            @* Interactive (client-side) navigation to an unknown in-app URL. Full page loads of unknown
               URLs are handled by Pages/Error.cshtml via UseStatusCodePagesWithReExecute. *@
            <PageTitle>Page not found — Authority Records</PageTitle>
            <LayoutView Layout="typeof(Shared.MainLayout)">
                <div class="empty-state" role="alert">
                    <i class="bi bi-signpost-split" aria-hidden="true"></i>
                    <h1 class="h4">Page not found</h1>
                    <p>There's nothing at this address. Check the link, or head back to the dashboard.</p>
                    <a href="/" class="btn btn-primary">Back to the dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

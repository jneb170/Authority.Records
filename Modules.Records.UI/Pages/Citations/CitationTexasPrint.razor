@page "/citations/{RecordNumber:long}/texas-print"
@layout PrintLayout
@attribute [Authorize(Roles = "Admin,Supervisor,Dispatcher,Officer")]
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Modules.Records.UI.Shared

<PageTitle>Citation #@RecordNumber</PageTitle>

<div class="pdf-launcher">
    <div class="pdf-toolbar">
        <a class="pdf-btn pdf-btn-primary" href="@DownloadUrl">⬇ Download PDF</a>
        <button class="pdf-btn" @onclick="PrintAsync">🖨 Print</button>
        <button class="pdf-btn" @onclick="CloseWindow">✕ Close</button>
        <span class="pdf-hint">The Print dialog lists your available printers and a “Save as PDF” option.</span>
    </div>

    <iframe class="pdf-frame" src="@ViewUrl" title="Citation #@RecordNumber PDF"></iframe>
</div>

<style>
    .pdf-launcher {
        display: flex;
        flex-direction: column;
        height: 100vh;
        margin: 0;
    }

    .pdf-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
        padding: .55rem .8rem;
        background: #f3f3f3;
        border-bottom: 1px solid #ccc;
    }

    .pdf-btn {
        border: 1px solid #333;
        background: #fff;
        padding: .4rem .85rem;
        cursor: pointer;
        font: inherit;
        text-decoration: none;
        color: #111;
        border-radius: 3px;
    }

    .pdf-btn:hover { background: #f0f0f0; }

    .pdf-btn-primary {
        background: #0b5ed7;
        border-color: #0b5ed7;
        color: #fff;
    }

    .pdf-btn-primary:hover { background: #0a53be; }

    .pdf-hint {
        margin-left: .25rem;
        font-size: .8rem;
        color: #555;
    }

    .pdf-frame {
        flex: 1 1 auto;
        width: 100%;
        border: 0;
    }
</style>

@code {
    [Parameter] public long RecordNumber { get; set; }

    private IJSObjectReference? _printModule;

    private string ViewUrl => $"/citations/{RecordNumber}/texas-pdf";
    private string DownloadUrl => $"/citations/{RecordNumber}/texas-pdf?download=1";

    private async Task PrintAsync()
    {
        try
        {
            _printModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/print.js");
            await _printModule.InvokeVoidAsync("printPdf", ViewUrl);
        }
        catch
        {
            // Best-effort: if the print module fails to load, the embedded viewer's own controls
            // and the Download button remain available.
        }
    }

    private void CloseWindow()
        => JS.InvokeVoidAsync("window.close");

    public async ValueTask DisposeAsync()
    {
        if (_printModule is not null)
        {
            try
            {
                await _printModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. tab closed) — nothing to dispose.
            }
        }
    }
}

@page "/citations"
@implements IDisposable
@inject ICitationService CitationService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject IUserLookupService UserLookupService
@using Modules.Records.UI.Services

<PageTitle>Citations</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-file-earmark-text-fill"></i> Citations</h2>
        <div class="page-header-sub">Citation Records</div>
    </div>
    <a class="btn btn-primary" href="/citations/create"><i class="bi bi-plus-lg me-1"></i>New Citation</a>
</div>

<!-- Search / Filter Panel -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer;" @onclick="() => _filterExpanded = !_filterExpanded">
        <span class="fw-semibold text-uppercase" style="font-size:0.8rem;letter-spacing:0.05em;">
            <i class="bi bi-search me-1"></i>Search / Filter
        </span>
        <i class="bi @(_filterExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size:0.8rem;"></i>
    </div>
@if (_filterExpanded)
{
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-6 col-md-4">
                <label class="form-label mb-1">Description contains</label>
                <input class="form-control form-control-sm" @bind="_filterDescription" placeholder="Description…" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Issue date from</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateFrom.HasValue ? _filterDateFrom.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateFrom = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Issue date to</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateTo.HasValue ? _filterDateTo.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateTo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label mb-1">Issued</label>
                <select class="form-select form-select-sm" @bind="_filterIsIssued">
                    <option value="">All</option>
                    <option value="true">Issued</option>
                    <option value="false">Pending</option>
                </select>
            </div>
        </div>
        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-sm btn-primary" @onclick="ApplySearch">Search</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    </div>
}
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_citations is not null)
{
    @if (!_citations.Any())
    {
        <p class="text-muted">No citations recorded.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width:3rem"></th>
                    <SortableColumnHeader ColumnKey="num"         Label="#"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="citationnum" Label="Citation #"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="description" Label="Description"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="issuedate"   Label="Issue Date"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="issued"      Label="Issued"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <th>Lock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in SortedCitations)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" title="Delete"
                                    @onclick="() => InitiateDelete(c.Id, c.CitationNum)"><i class="bi bi-trash3"></i></button>
                        </td>
                        <td><a href="/citations/@c.RecordNumber">@c.RecordNumber</a></td>
                        <td><a href="/citations/@c.RecordNumber">@c.CitationNum</a></td>
                        <td>@c.Description</td>
                        <td>@c.IssueDate.ToShortDateString()</td>
                        <td>@(c.IsIssued ? "✅" : "⏳")</td>
                        <td><LockBadge IsLocked="@c.IsLocked" LockedByName="@GetLockName(c.LockedByUserId)" Compact="true" /></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="Delete Citation"
               Message="@($"Are you sure you want to delete citation \"{_deleteTargetName}\"?")"
               OnConfirm="ExecuteDeleteAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private bool _filterExpanded = false;
    private IReadOnlyList<CitationDto>? _citations;
    private Dictionary<Guid, string> _lockUserNames = [];
    private bool _loading = true;
    private string? _error;

    // Delete state
    private bool   _showDeleteConfirm;
    private Guid   _deleteTargetId;
    private string _deleteTargetName = string.Empty;

    private string _sortColumn    = "num";
    private bool   _sortAscending = false;

    // Filter state
    private string    _filterDescription = string.Empty;
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;
    private string    _filterIsIssued     = string.Empty;

    private IEnumerable<CitationDto> FilteredCitations =>
        _citations is null ? [] :
        _citations.Where(c =>
            (string.IsNullOrWhiteSpace(_filterDescription) || (c.Description?.Contains(_filterDescription, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!_filterDateFrom.HasValue || c.IssueDate.Date >= _filterDateFrom.Value.Date) &&
            (!_filterDateTo.HasValue   || c.IssueDate.Date <= _filterDateTo.Value.Date) &&
            (string.IsNullOrWhiteSpace(_filterIsIssued)    || (bool.TryParse(_filterIsIssued, out var issued) && c.IsIssued == issued)));

    private IEnumerable<CitationDto> SortedCitations =>
        (_sortColumn, _sortAscending) switch
        {
            ("num",         true)  => FilteredCitations.OrderBy(x => x.RecordNumber),
            ("num",         false) => FilteredCitations.OrderByDescending(x => x.RecordNumber),
            ("citationnum", true)  => FilteredCitations.OrderBy(x => x.CitationNum),
            ("citationnum", false) => FilteredCitations.OrderByDescending(x => x.CitationNum),
            ("description", true)  => FilteredCitations.OrderBy(x => x.Description),
            ("description", false) => FilteredCitations.OrderByDescending(x => x.Description),
            ("issuedate",   true)  => FilteredCitations.OrderBy(x => x.IssueDate),
            ("issuedate",   false) => FilteredCitations.OrderByDescending(x => x.IssueDate),
            ("issued",      true)  => FilteredCitations.OrderBy(x => x.IsIssued),
            _                      => FilteredCitations.OrderByDescending(x => x.IsIssued),
        };

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    protected override async Task OnInitializedAsync()
    {
        ShortcutService.OnNew += HandleShortcutNew;
        try
        {
            _citations = await CitationService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleShortcutNew() => InvokeAsync(() => Nav.NavigateTo("/citations/create"));

    public void Dispose() => ShortcutService.OnNew -= HandleShortcutNew;

    private string? GetLockName(Guid? userId) =>
        userId.HasValue ? _lockUserNames.GetValueOrDefault(userId.Value) : null;

    private async Task ResolveLockedNamesAsync()
    {
        if (_citations is null) return;
        var ids = _citations.Where(c => c.IsLocked && c.LockedByUserId.HasValue)
                            .Select(c => c.LockedByUserId!.Value).Distinct();
        _lockUserNames = await UserLookupService.GetDisplayNamesAsync(ids);
    }

    private void InitiateDelete(Guid id, string name)
    {
        _deleteTargetId    = id;
        _deleteTargetName  = name;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        _showDeleteConfirm = false;
        try
        {
            await CitationService.SoftDeleteAsync(_deleteTargetId);
            _citations = await CitationService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void ApplySearch() => StateHasChanged();

    private void ClearFilters()
    {
        _filterDescription = string.Empty;
        _filterDateFrom    = null;
        _filterDateTo      = null;
        _filterIsIssued    = string.Empty;
        StateHasChanged();
    }
}

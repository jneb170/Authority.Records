@page "/citations/create"
@page "/incidents/{IncidentRecordNumber:long}/citations/create"
@implements IAsyncDisposable
@inject ICitationService CitationService
@inject IChargeService ChargeService
@inject IIncidentService IncidentService
@inject IAgencyConfigurationService ConfigService
@inject IActiveAgencyContext ActiveAgencyContext
@inject IKeyboardShortcutService ShortcutService
@inject NavigationManager Nav
@using Modules.Records.UI.Services

<PageTitle>New Citation</PageTitle>

<div class="page-header record-page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-file-earmark-text-fill"></i> New Citation</h2>
        <div class="page-header-sub">Create a citation record and connect it to the related incident when applicable.</div>
    </div>
</div>

@if (_vm.ErrorMessage is not null)
{
    <div class="alert alert-danger">@_vm.ErrorMessage</div>
}
@if (AgencyBlockingMessage is not null)
{
    <div class="alert alert-warning">@AgencyBlockingMessage</div>
}

<div class="record-form-shell">
<EditForm Model="_vm" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="record-validation-summary" />
    <div class="card record-form-card mb-3">
        <div class="card-body">
            <div class="record-form-header">
                <h6 class="card-title">Citation Details</h6>
                <p class="record-form-note">Record the enforcement details first, then link the citation to the related incident when case association is needed.</p>
            </div>
            <div class="record-grid-2">
                <div class="mb-0 record-field-span-2">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" @bind-Value="_vm.Description" rows="3" />
                    <ValidationMessage For="() => _vm.Description" />
                </div>
                <div class="mb-0">
                    <label class="form-label">Issue Date</label>
                    <InputDate class="form-control" @bind-Value="_vm.IssueDate" />
                    <ValidationMessage For="() => _vm.IssueDate" />
                </div>
                <div class="mb-0">
                    <label class="form-label">Citation Number <span class="text-muted">(auto-generated if blank)</span></label>
                    <div class="input-group">
                        <InputText class="form-control" @bind-Value="_vm.CitationNum" placeholder="e.g. CT-2026-000001" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="GenerateCitationNumAsync" disabled="@(_generatingNum || !CanCreateAgencyOwnedRecord)">
                            @(_generatingNum ? "…" : "🔁 Generate")
                        </button>
                    </div>
                </div>
                @if (_incidents is not null && _incidents.Any())
                {
                    <div class="mb-0 record-field-span-2">
                        <label class="form-label">Link to Incident <span class="text-muted">(optional)</span></label>
                        <select class="form-select" multiple @onchange="OnIncidentSelectionChanged">
                            @foreach (var i in _incidents)
                            {
                                <option value="@i.RecordNumber" selected="@(_selectedIncidentRecordNumbers.Contains(i.RecordNumber))">
                                    @i.RecordNumber — @i.Details.IncidentNum (@i.Status)
                                </option>
                            }
                        </select>
                        <div class="form-text">Hold Ctrl/Cmd to select multiple</div>
                    </div>
                }
                <div class="mb-0 record-field-span-2">
                    <label class="form-label">Charges <span class="text-muted">(optional)</span></label>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showChargeModal = true">
                            <i class="bi bi-search me-1"></i>Add Charge
                        </button>
                        <span class="small text-muted">@_selectedCharges.Count charge(s) selected</span>
                    </div>
                    @if (_selectedCharges.Count == 0)
                    {
                        <div class="form-text">Only citation-eligible charges are shown in the search dialog.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush border rounded">
                            @foreach (var charge in _selectedCharges)
                            {
                                <div class="list-group-item py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@charge.OffenseName</div>
                                        <div class="small text-muted">UCR @charge.UcrCode · @charge.ChargeLevel</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCharge(charge.Id)">Remove</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="record-form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(_submitting || !CanCreateAgencyOwnedRecord)">
            @(_submitting ? "Creating…" : "Create Citation")
        </button>
        @if (IncidentRecordNumber.HasValue)
        {
            <a class="btn btn-secondary" href="/incidents/@IncidentRecordNumber">Cancel</a>
        }
        else
        {
            <a class="btn btn-secondary" href="/citations">Cancel</a>
        }
    </div>
</EditForm>
</div>

<UnsavedChangesDialog Visible="_showCancelConfirm"
                      SaveLabel="Submit Record"
                      DiscardLabel="Discard"
                      ActionDescription="leaving the form"
                      OnSaveAndRelease="SubmitFromDialogAsync"
                      OnDiscard="DiscardAndCancelAsync"
                      OnCancel="() => _showCancelConfirm = false" />

<ChargeSearchModal Visible="_showChargeModal"
                   CitationEligibleOnly="true"
                   OnSelected="OnChargeSelected"
                   OnCancelled="() => _showChargeModal = false" />

@code {
    [Parameter] public long? IncidentRecordNumber { get; set; }

    private readonly CreateCitationViewModel _vm = new();
    private bool _submitting;
    private bool _generatingNum;
    private bool _showCancelConfirm;
    private bool _showChargeModal;
    private IReadOnlyList<IncidentDto>? _incidents;
    private readonly List<long> _selectedIncidentRecordNumbers = new();
    private readonly List<ChargeDto> _selectedCharges = [];
    private IDisposable? _agencySelectionLock;

    private bool HasEnteredData =>
        !string.IsNullOrEmpty(_vm.Description) ||
        !string.IsNullOrEmpty(_vm.CitationNum) ||
        _selectedIncidentRecordNumbers.Count > 0 ||
        _selectedCharges.Count > 0;
    private bool CanCreateAgencyOwnedRecord => ActiveAgencyContext.HasSelectedAgency;
    private string? AgencyBlockingMessage =>
        CanCreateAgencyOwnedRecord
            ? null
            : "No active agency is available. Record creation is disabled until an administrator assigns you a default agency and agency access.";

    private string CancelUrl =>
        IncidentRecordNumber.HasValue ? $"/incidents/{IncidentRecordNumber}" : "/citations";

    protected override Task OnInitializedAsync()
    {
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
        return Task.CompletedTask;
    }

    private void HandleShortcutSave()
        => InvokeAsync(async () => { await SubmitAsync(); StateHasChanged(); });

    private void HandleShortcutRelease()
        => InvokeAsync(() => { HandleEscape(); StateHasChanged(); });

    private void HandleEscape()
    {
        if (HasEnteredData)
            _showCancelConfirm = true;
        else
            Nav.NavigateTo(CancelUrl);
    }

    private async Task SubmitFromDialogAsync()
    {
        _showCancelConfirm = false;
        await SubmitAsync();
    }

    private void DiscardAndCancelAsync() => Nav.NavigateTo(CancelUrl);

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        _agencySelectionLock?.Dispose();
        _agencySelectionLock = null;
        return ValueTask.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        _agencySelectionLock ??= ActiveAgencyContext.AcquireSelectionLock();
        await ActiveAgencyContext.EnsureLoadedAsync();
        _incidents = await IncidentService.GetByJurisdictionAsync();

        if (IncidentRecordNumber.HasValue)
        {
            _selectedIncidentRecordNumbers.Clear();
            _selectedIncidentRecordNumbers.Add(IncidentRecordNumber.Value);
        }
    }

    private void OnIncidentSelectionChanged(ChangeEventArgs e)
    {
        _selectedIncidentRecordNumbers.Clear();
        if (e.Value is string[] selected)
        {
            foreach (var s in selected)
                if (long.TryParse(s, out var rn))
                    _selectedIncidentRecordNumbers.Add(rn);
        }
    }

    private async Task GenerateCitationNumAsync()
    {
        if (!CanCreateAgencyOwnedRecord)
            return;

        _generatingNum = true;
        try { _vm.CitationNum = await ConfigService.GenerateCitationNumAsync(); }
        catch (Exception ex) { _vm.ErrorMessage = ex.Message; }
        finally { _generatingNum = false; }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _vm.ErrorMessage = null;

        try
        {
            if (!CanCreateAgencyOwnedRecord)
                throw new InvalidOperationException("Select an active agency before creating a citation.");

            var recordNumber = await CitationService.CreateAsync(
                _vm.Description,
                _vm.IssueDate,
                _selectedIncidentRecordNumbers.AsReadOnly(),
                _vm.CitationNum);

            if (_selectedCharges.Count > 0)
            {
                var citation = await CitationService.GetByRecordNumberAsync(recordNumber)
                    ?? throw new InvalidOperationException("Citation was created but could not be reloaded for charge linking.");

                foreach (var charge in _selectedCharges)
                    await ChargeService.LinkToCitationAsync(citation.Id, charge.Id);
            }

            if (IncidentRecordNumber.HasValue)
                Nav.NavigateTo($"/incidents/{IncidentRecordNumber}");
            else
                Nav.NavigateTo($"/citations/{recordNumber}?autoModify=true");
        }
        catch (Exception ex)
        {
            _vm.ErrorMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private Task OnChargeSelected(ChargeDto charge)
    {
        if (_selectedCharges.All(c => c.Id != charge.Id))
            _selectedCharges.Add(charge);

        _showChargeModal = false;
        return Task.CompletedTask;
    }

    private void RemoveCharge(Guid chargeId)
    {
        var existing = _selectedCharges.FirstOrDefault(c => c.Id == chargeId);
        if (existing is not null)
            _selectedCharges.Remove(existing);
    }
}


    private async Task ResolveAtTimeOfLabelsAsync()
    {
        if (_editAtTimeOfCopiedAtUtc.HasValue && _citation?.AtTimeOfName?.LastCopiedByUserId is Guid copiedBy)
        {
            _editAtTimeOfCopiedByName = await UserLookupService.GetDisplayNameAsync(copiedBy);
        }
        else
        {
            _editAtTimeOfCopiedByName = null;
        }

        var ids = new[]
        {
            _editAtTimeOfSexId,
            _editAtTimeOfRaceId,
            _editAtTimeOfDriversLicenseStateId
        }
        .Where(id => id.HasValue)
        .Select(id => id!.Value)
        .Distinct()
        .ToArray();

        if (ids.Length == 0)
        {
            _atTimeOfSexLabel = null;
            _atTimeOfRaceLabel = null;
            _atTimeOfDriversLicenseStateLabel = null;
            return;
        }

        var labels = await PicklistService.GetItemsByIdsAsync(ids);
        _atTimeOfSexLabel = _editAtTimeOfSexId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfSexId.Value) : null;
        _atTimeOfRaceLabel = _editAtTimeOfRaceId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfRaceId.Value) : null;
        _atTimeOfDriversLicenseStateLabel = _editAtTimeOfDriversLicenseStateId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfDriversLicenseStateId.Value) : null;
    }

    private async Task ResolveVehicleLabelsAsync()
    {
        if (!_editVehiclePlateStateId.HasValue)
        {
            _vehiclePlateStateLabel = null;
            return;
        }

        var labels = await PicklistService.GetItemsByIdsAsync([_editVehiclePlateStateId.Value]);
        _vehiclePlateStateLabel = labels.GetValueOrDefault(_editVehiclePlateStateId.Value);
    }

    private async Task ResolveTexasLabelsAsync()
    {
        var ids = new[]
        {
            _editTexasViolationSourceTypeId,
            _editTexasViolationGroupId,
            _editTexasSpeedBandId
        }
        .Where(id => id.HasValue)
        .Select(id => id!.Value)
        .Distinct()
        .ToArray();

        if (ids.Length == 0)
        {
            _texasViolationSourceTypeLabel = null;
            _texasViolationGroupLabel = null;
            _texasSpeedBandLabel = null;
        }
        else
        {
            var labels = await PicklistService.GetItemsByIdsAsync(ids);
            _texasViolationSourceTypeLabel = _editTexasViolationSourceTypeId.HasValue ? labels.GetValueOrDefault(_editTexasViolationSourceTypeId.Value) : null;
            _texasViolationGroupLabel = _editTexasViolationGroupId.HasValue ? labels.GetValueOrDefault(_editTexasViolationGroupId.Value) : null;
            _texasSpeedBandLabel = _editTexasSpeedBandId.HasValue ? labels.GetValueOrDefault(_editTexasSpeedBandId.Value) : null;
        }

        await ResolveTexasAppearanceLocationDisplayAsync();
    }

    private async Task ResolveTexasAppearanceLocationDisplayAsync()
    {
        if (_editTexasCourtAppearanceLocationId.HasValue)
        {
            var location = await LocationService.GetByIdAsync(_editTexasCourtAppearanceLocationId.Value);
            _editTexasCourtAppearanceLocationDisplay = location is null ? null : FormatLocationDisplay(location);
            return;
        }

        _editTexasCourtAppearanceLocationDisplay = null;
    }

    private void OnTexasCourtAppearanceChanged(ChangeEventArgs e)
    {
        if (DateTimeLocalInputHelper.TryParse(e.Value?.ToString(), out var value))
        {
            _editTexasCourtAppearanceDateTime = value;
        }
        else
        {
            _editTexasCourtAppearanceDateTime = null;
        }
    }

    private void OnTexasAffidavitSignedDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var value))
        {
            _editTexasAffidavitSignedDate = value.Date;
        }
        else
        {
            _editTexasAffidavitSignedDate = null;
        }
    }

    private void OnTexasAppearanceLocationSelected(LocationDto location)
    {
        _editTexasCourtAppearanceLocationId = location.Id;
        _editTexasCourtAppearanceLocationDisplay = FormatLocationDisplay(location);
        _showTexasAppearanceLocationModal = false;
    }

    private Task OnTexasAppearanceLocationCreatedAsync(LocationDto location)
    {
        TrackCreatedForeignRecord($"Location #{location.RecordNumber} was created. If you discard this page, it will remain in the system but will not be linked to this citation.");
        return Task.CompletedTask;
    }

    private void OnTexasAppearanceLocationCleared()
    {
        _editTexasCourtAppearanceLocationId = null;
        _editTexasCourtAppearanceLocationDisplay = null;
        _showTexasAppearanceLocationModal = false;
    }

    private void ClearTexasAppearanceLocation()
    {
        _editTexasCourtAppearanceLocationId = null;
        _editTexasCourtAppearanceLocationDisplay = null;
    }

    private void OnAtTimeOfDateOfBirthChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var value))
        {
            _editAtTimeOfDateOfBirth = value;
        }
        else
        {
            _editAtTimeOfDateOfBirth = null;
        }
    }

    private static string FormatLocationDisplay(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber))  parts.Add(loc.StreetNumber);
        if (!string.IsNullOrWhiteSpace(loc.StreetAddress)) parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))          parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    private static string? NullIfWhiteSpace(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private IReadOnlyList<RecordChargeDto>? VisibleCharges =>
        _charges is null
            ? null
            : _charges
                .Where(c => !_pendingChargeRemoves.Contains(c.ChargeId))
                .Concat(_pendingChargeAdds.Values
                    .Where(p => _charges.All(existing => existing.ChargeId != p.Charge.Id))
                    .Select(p => MapCharge(p.Charge, p.LinkedAtUtc)))
                .OrderByDescending(c => c.LinkedAtUtc)
                .ToList();

    private IReadOnlyList<IncidentCitationLinkDto>? VisibleLinkedIncidents =>
        _linkedIncidents is null
            ? null
            : _linkedIncidents
                .Where(link => !_pendingIncidentLinkRemoves.Contains(link.IncidentId))
                .Concat(_pendingIncidentLinkAdds.Values
                    .Where(p => _linkedIncidents.All(existing => existing.IncidentId != p.Incident.Id))
                    .Select(p => MapIncidentLink(p.Incident, p.LinkedAtUtc)))
                .OrderByDescending(link => link.LinkedAtUtc)
                .ToList();

    private static RecordChargeDto MapCharge(ChargeDto charge, DateTime linkedAtUtc) =>
        new(
            charge.Id,
            charge.OffenseName,
            charge.UcrCode,
            charge.ChargeLevel,
            charge.StateClass,
            charge.IsCitationEligible,
            charge.IsActive,
            linkedAtUtc);

    private static IncidentCitationLinkDto MapIncidentLink(IncidentDto incident, DateTime linkedAtUtc) =>
        new(
            Guid.Empty,
            incident.Id,
            incident.RecordNumber,
            string.IsNullOrWhiteSpace(incident.Details.IncidentNum) ? $"Incident #{incident.RecordNumber}" : incident.Details.IncidentNum,
            Guid.Empty,
            linkedAtUtc);

    private string? GetReleaseWarningMessage() =>
        _createdForeignRecords.Count == 0 ? null : string.Join(" ", _createdForeignRecords);

    private void TrackCreatedForeignRecord(string message)
    {
        if (!_createdForeignRecords.Contains(message, StringComparer.Ordinal))
            _createdForeignRecords.Add(message);
    }

    private void ClearPendingChanges()
    {
        _pendingChargeAdds.Clear();
        _pendingChargeRemoves.Clear();
        _pendingIncidentLinkAdds.Clear();
        _pendingIncidentLinkRemoves.Clear();
        _createdForeignRecords.Clear();
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        return ValueTask.CompletedTask;
    }
}

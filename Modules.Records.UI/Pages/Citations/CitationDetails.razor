@page "/citations/{RecordNumber:long}"
@page "/incidents/{IncidentRecordNumber:long}/citations/{RecordNumber:long}"
@implements IAsyncDisposable
@inject ICitationService CitationService
@inject IIncidentService IncidentService
@inject IChargeService ChargeService
@inject INameService NameService
@inject IPicklistService PicklistService
@inject IAgencyConfigurationService ConfigService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject ILocationService LocationService
@using Modules.Records.Domain.Common
@using Modules.Records.Application.DTOs
@using Modules.Records.UI.Services
@using System.Text.Json

<PageTitle>Citation Details</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_citation is not null)
{
    <nav aria-label="breadcrumb" class="record-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/citations">Citations</a></li>
            @if (IncidentRecordNumber.HasValue)
            {
                <li class="breadcrumb-item"><a href="/incidents/@IncidentRecordNumber">Incident</a></li>
            }
            <li class="breadcrumb-item active">Citation #@RecordNumber</li>
        </ol>
    </nav>

    <div class="page-header record-page-header">
        <div>
            <h2 class="page-header-title"><i class="bi bi-file-earmark-text-fill"></i> Citation Record</h2>
            <div class="page-header-sub">
                @(string.IsNullOrWhiteSpace(_citation.CitationNum)
                    ? $"Citation #{RecordNumber}"
                    : _citation.CitationNum)
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center record-header-meta">
            <a class="btn btn-outline-secondary btn-sm"
               href="/citations/@RecordNumber/texas-print"
               target="_blank"
               rel="noopener">
                <i class="bi bi-printer-fill me-1"></i>Print Texas Citation
            </a>
            <span class="record-pill @(_citation.IsIssued ? "record-pill-success" : "record-pill-warning")">
                <i class="bi @(_citation.IsIssued ? "bi-check2-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                <span>@(_citation.IsIssued ? "Issued" : "Pending")</span>
            </span>
            <LockBadge IsLocked="@_citation.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    <RecordDetailsTabs DetailsUrl="@DetailsTabUrl"
                       RelationshipsUrl="@RelationshipsTabUrl"
                       ActiveTab="Details" />

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="record-toolbar mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2 record-mode-banner">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <div class="record-mode-actions">
                    <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync"><i class="bi bi-floppy-fill me-1"></i>Save</button>
                    <button class="btn btn-sm btn-outline-dark" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release</button>
                </div>
            </div>
        }
        else if (_citation.IsLocked && _citation.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify</button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar record-action-bar mb-4 d-flex flex-wrap gap-2">
            @if (!_citation.IsIssued)
            {
                <button class="btn btn-success btn-sm" @onclick="IssueAsync">Issue Citation</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Citation"
                   Message="Are you sure you want to delete this citation?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          WarningMessage="@GetReleaseWarningMessage()"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Citation Fields (always visible; inputs become editable in modify mode) -->
    <div class="card record-content-card mb-4">
        <div class="card-body">
            <h6 class="card-title">Citation Details</h6>
            <div class="record-grid-3">
                <div>
                    <label class="form-label mb-1">Citation Number</label>
                    @if (_modifyMode)
                    {
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control form-control-sm"
                                   @bind="_editCitationNum" placeholder="e.g. CT-2026-000001" />
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="GenerateCitationNumAsync" disabled="@_generatingCitationNum">
                                @(_generatingCitationNum ? "…" : "🔁")
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(string.IsNullOrWhiteSpace(_citation.CitationNum) ? "—" : _citation.CitationNum)</p>
                    }
                </div>
                <div class="record-field-span-2">
                    <label class="form-label mb-1">Defendant</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">
                            @if (!_modifyMode && _editNameRecordNumber.HasValue)
                            {
                                <a href="/names/@_editNameRecordNumber" class="record-reference-link">@(_editNameDisplay ?? "— None —")</a>
                            }
                            else
                            {
                                @(_editNameDisplay ?? "— None —")
                            }
                        </span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showNameModal = true">
                                <i class="bi bi-people me-1"></i>@(_editNameId.HasValue ? "Change" : "Assign") Name
                            </button>
                            @if (_editNameId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned name" title="Clear assigned name" @onclick="ClearName">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="record-field-span-2">
                    <label class="form-label mb-1">Description</label>
                    <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editDescription" placeholder="—" />
                </div>
                <div>
                    <label class="form-label mb-1">Issue Date</label>
                    <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           value="@DateTimeLocalInputHelper.Format(_editIssueDate)"
                           @onchange="OnIssueDateChanged" />
                </div>
                <div>
                    <label class="form-label mb-1">Court</label>
                    @if (_modifyMode)
                    {
                        <PicklistSelect PicklistType="@PicklistTypes.Court"
                                        @bind-Value="_editCourtId"
                                        IsRequired="@_courtRequired" />
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(_courtLabel ?? "—")</p>
                    }
                </div>
                <div>
                    <label class="form-label mb-1">Issued</label>
                    <div class="form-control-plaintext form-control-sm ps-0 mb-0">
                        <span class="record-pill @(_citation.IsIssued ? "record-pill-success" : "record-pill-warning")">
                            <i class="bi @(_citation.IsIssued ? "bi-check2-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                            <span>@(_citation.IsIssued ? "Issued" : "Pending")</span>
                        </span>
                    </div>
                </div>
                <div class="record-field-span-full">
                    <label class="form-label mb-1">Location</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">@(_editLocationDisplay ?? "— None —")</span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showLocationModal = true">
                                <i class="bi bi-geo-alt me-1"></i>@(_editLocationId.HasValue ? "Change" : "Assign") Location
                            </button>
                            @if (_editLocationId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned location" title="Clear assigned location" @onclick="ClearLocation">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                    <LocationMiniMap LocationId="_editLocationId" />
                </div>
            </div>
        </div>
    </div>

    <div class="card record-content-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h6 class="card-title mb-1">At Time Of Name</h6>
                    <div class="text-muted small">Historical defendant snapshot stored on this citation.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (_modifyMode)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CopyCurrentNameToAtTimeOfAsync"
                                disabled="@(!_editNameId.HasValue)">
                            <i class="bi bi-arrow-repeat me-1"></i>Copy current Name
                        </button>
                    }
                </div>
            </div>

            @if (_editAtTimeOfCopiedAtUtc.HasValue)
            {
                <div class="text-muted small mb-3">
                    Last copied @(_editAtTimeOfCopiedAtUtc.Value.ToLocalTime().ToString("g"))
                    @if (!string.IsNullOrWhiteSpace(_editAtTimeOfCopiedByName))
                    {
                        <span>by @_editAtTimeOfCopiedByName</span>
                    }
                </div>
            }

            @if (!HasAtTimeOfNameData && !_modifyMode)
            {
                <div class="record-related-empty-state">
                    <div class="empty-state">
                        <i class="bi bi-person-vcard"></i>
                        <div class="fw-medium">No At Time Of data stored.</div>
                        <div class="small mt-1">Enter modify mode and copy the current linked Name to capture a historical snapshot.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Name Type</label>
                        @if (_modifyMode)
                        {
                            <select class="form-select form-select-sm" @bind="_editAtTimeOfNameType">
                                <option value="@NameTypes.Person">Person</option>
                                <option value="@NameTypes.Business">Business</option>
                            </select>
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0">@(_editAtTimeOfNameType == NameTypes.Business ? "Business" : "Person")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">@(_editAtTimeOfNameType == NameTypes.Business ? "Business Name" : "Last Name")</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editAtTimeOfLastOrBusinessName"
                               placeholder="—" />
                    </div>
                    @if (_editAtTimeOfNameType == NameTypes.Person)
                    {
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">First Name</label>
                            <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   readonly="@(!_modifyMode)"
                                   @bind="_editAtTimeOfFirstName"
                                   placeholder="—" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Middle Name</label>
                            <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   readonly="@(!_modifyMode)"
                                   @bind="_editAtTimeOfMiddleName"
                                   placeholder="—" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Date of Birth</label>
                            <input type="date" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   readonly="@(!_modifyMode)"
                                   value="@(_editAtTimeOfDateOfBirth?.ToString("yyyy-MM-dd"))"
                                   @onchange="OnAtTimeOfDateOfBirthChanged" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Sex</label>
                            @if (_modifyMode)
                            {
                                <PicklistSelect PicklistType="@PicklistTypes.Sex" @bind-Value="_editAtTimeOfSexId" />
                            }
                            else
                            {
                                <p class="form-control-plaintext form-control-sm ps-0">@(_atTimeOfSexLabel ?? "—")</p>
                            }
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Race</label>
                            @if (_modifyMode)
                            {
                                <PicklistSelect PicklistType="@PicklistTypes.Race" @bind-Value="_editAtTimeOfRaceId" />
                            }
                            else
                            {
                                <p class="form-control-plaintext form-control-sm ps-0">@(_atTimeOfRaceLabel ?? "—")</p>
                            }
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Driver License</label>
                            <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   readonly="@(!_modifyMode)"
                                   @bind="_editAtTimeOfDriversLicenseNumber"
                                   placeholder="—" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">DL State</label>
                            @if (_modifyMode)
                            {
                                <PicklistSelect PicklistType="@PicklistTypes.State" @bind-Value="_editAtTimeOfDriversLicenseStateId" />
                            }
                            else
                            {
                                <p class="form-control-plaintext form-control-sm ps-0">@(_atTimeOfDriversLicenseStateLabel ?? "—")</p>
                            }
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Height (in)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_editAtTimeOfHeightInches" disabled="@(!_modifyMode)" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">Weight (lbs)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_editAtTimeOfWeightLbs" disabled="@(!_modifyMode)" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label mb-1">SSN</label>
                            <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   readonly="@(!_modifyMode)"
                                   @bind="_editAtTimeOfSocialSecurityNumber"
                                   placeholder="—" />
                        </div>
                    }
                    <div class="col-12">
                        <label class="form-label mb-1">Primary Address</label>
                        <textarea rows="2"
                                  class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                  readonly="@(!_modifyMode)"
                                  @bind="_editAtTimeOfPrimaryLocationAddress"
                                  placeholder="—"></textarea>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card record-content-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h6 class="card-title mb-1">Officer / Complainant</h6>
                    <div class="text-muted small">Printable complainant details stored directly on this citation.</div>
                </div>
            </div>

            @if (!HasOfficerProfileData && !_modifyMode)
            {
                <div class="record-related-empty-state">
                    <div class="empty-state">
                        <i class="bi bi-person-badge"></i>
                        <div class="fw-medium">No officer data stored.</div>
                        <div class="small mt-1">Enter modify mode to assign an officer and store badge, title, and unit details.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label mb-1">Source Name</label>
                        <div class="d-flex align-items-center gap-2">
                            <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">
                                @if (!_modifyMode && _editOfficerSourceRecordNumber.HasValue)
                                {
                                    <a href="/names/@_editOfficerSourceRecordNumber" class="record-reference-link">@(_editOfficerSourceDisplay ?? "— None —")</a>
                                }
                                else
                                {
                                    @(_editOfficerSourceDisplay ?? "— None —")
                                }
                            </span>
                            @if (_modifyMode)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showOfficerNameModal = true">
                                    <i class="bi bi-person-lines-fill me-1"></i>@(_editOfficerSourceNameId.HasValue ? "Change" : "Assign") Officer
                                </button>
                                @if (_editOfficerSourceNameId.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned officer source" title="Clear assigned officer source" @onclick="ClearOfficerSource">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Officer / Complainant Name</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editOfficerName"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Title</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editOfficerTitle"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label mb-1">Badge / ID</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editOfficerBadgeOrIdentifier"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label mb-1">Unit</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editOfficerUnitNumber"
                               placeholder="—" />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card record-content-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h6 class="card-title mb-1">Vehicle</h6>
                    <div class="text-muted small">Texas citation vehicle details stored directly on this citation.</div>
                </div>
            </div>

            @if (!HasVehicleData && !_modifyMode)
            {
                <div class="record-related-empty-state">
                    <div class="empty-state">
                        <i class="bi bi-car-front"></i>
                        <div class="fw-medium">No vehicle data stored.</div>
                        <div class="small mt-1">Enter modify mode to add the plate, state, make, style, and commercial flags needed for Texas printing.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Plate Number</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editVehiclePlateNumber"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Plate State</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.State" @bind-Value="_editVehiclePlateStateId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0">@(_vehiclePlateStateLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Plate Year</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_editVehiclePlateYear" disabled="@(!_modifyMode)" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Model Year</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_editVehicleModelYear" disabled="@(!_modifyMode)" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Make</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editVehicleMake"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Style / Body</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editVehicleStyle"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Color</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editVehicleColor"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" @bind-Value="_editVehicleIsCommercial" disabled="@(!_modifyMode)" />
                            <label class="form-check-label">Commercial vehicle</label>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input" @bind-Value="_editVehicleCarriesHazardousMaterial" disabled="@(!_modifyMode)" />
                            <label class="form-check-label">Carries hazardous material</label>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card record-content-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h6 class="card-title mb-1">Texas Citation Mapping</h6>
                    <div class="text-muted small">Core Texas offense, appearance, bond, and signature fields used by the printable UTC layout.</div>
                </div>
            </div>

            @if (!HasTexasDetailsData && !_modifyMode)
            {
                <div class="record-related-empty-state">
                    <div class="empty-state">
                        <i class="bi bi-journal-text"></i>
                        <div class="fw-medium">No Texas citation mapping data stored.</div>
                        <div class="small mt-1">Enter modify mode to capture violation, appearance, and signature fields for Texas printing.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Docket Number</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasDocketNumber"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label mb-1">Page Number</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasPageNumber"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Violation Source</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.ViolationSourceType" @bind-Value="_editTexasViolationSourceTypeId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0">@(_texasViolationSourceTypeLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Section</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasViolationSection"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Violation Group</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.ViolationGroup" @bind-Value="_editTexasViolationGroupId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0">@(_texasViolationGroupLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-8">
                        <label class="form-label mb-1">Primary Violation Description</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasPrimaryViolationDescription"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label mb-1">Speed</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_editTexasSpeedMph" disabled="@(!_modifyMode)" />
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="form-label mb-1">Zone</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_editTexasZoneMph" disabled="@(!_modifyMode)" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Speed Band</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.SpeedBand" @bind-Value="_editTexasSpeedBandId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0">@(_texasSpeedBandLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-1">Other Violations / Narrative</label>
                        <textarea rows="3"
                                  class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                  readonly="@(!_modifyMode)"
                                  @bind="_editTexasNarrativeOtherViolations"
                                  placeholder="—"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label mb-1">Occurred At Text</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasOccurredAtText"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Court Appearance</label>
                        <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               value="@(_editTexasCourtAppearanceDateTime.HasValue ? DateTimeLocalInputHelper.Format(_editTexasCourtAppearanceDateTime.Value) : string.Empty)"
                               @onchange="OnTexasCourtAppearanceChanged" />
                    </div>
                    <div class="col-sm-6 col-md-8">
                        <label class="form-label mb-1">Court Appearance Location</label>
                        <div class="d-flex align-items-center gap-2">
                            <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">@(_editTexasCourtAppearanceLocationDisplay ?? "— None —")</span>
                            @if (_modifyMode)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showTexasAppearanceLocationModal = true">
                                    <i class="bi bi-geo-alt me-1"></i>@(_editTexasCourtAppearanceLocationId.HasValue ? "Change" : "Assign") Location
                                </button>
                                @if (_editTexasCourtAppearanceLocationId.HasValue)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearTexasAppearanceLocation" title="Clear appearance location" aria-label="Clear appearance location">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Affidavit Signed Date</label>
                        <input type="date" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               value="@(_editTexasAffidavitSignedDate?.ToString("yyyy-MM-dd"))"
                               @onchange="OnTexasAffidavitSignedDateChanged" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Complainant Signature</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasComplainantSignatureText"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label mb-1">Defendant Signature</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasDefendantSignatureText"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label mb-1">Receipt Number</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasReceiptNumber"
                               placeholder="—" />
                    </div>
                    <div class="col-12 col-md-9">
                        <label class="form-label mb-1">Accepted Bond Notes</label>
                        <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editTexasAcceptedBondNotes"
                               placeholder="—" />
                    </div>
                </div>
            }
        </div>
    </div>

    <LocationSearchModal Visible="_showLocationModal"
                         CurrentLocationId="_editLocationId"
                         OnSelected="OnLocationSelected"
                         OnCreated="OnLocationCreatedAsync"
                         OnCleared="OnLocationCleared"
                         OnCancelled="() => _showLocationModal = false" />

    <NameSearchModal Visible="_showNameModal"
                     CurrentNameId="_editNameId"
                     OnSelected="OnNameSelected"
                     OnCleared="OnNameCleared"
                     OnCancelled="() => _showNameModal = false" />

    <NameSearchModal Visible="_showOfficerNameModal"
                     CurrentNameId="_editOfficerSourceNameId"
                     OnSelected="OnOfficerNameSelected"
                     OnCleared="OnOfficerNameCleared"
                     OnCancelled="() => _showOfficerNameModal = false" />

    <LocationSearchModal Visible="_showTexasAppearanceLocationModal"
                         CurrentLocationId="_editTexasCourtAppearanceLocationId"
                         OnSelected="OnTexasAppearanceLocationSelected"
                         OnCreated="OnTexasAppearanceLocationCreatedAsync"
                         OnCleared="OnTexasAppearanceLocationCleared"
                         OnCancelled="() => _showTexasAppearanceLocationModal = false" />

    <RecordChargesSection Title="Charges"
                          EmptyTitle="No charges linked."
                          EmptyHint="Add citation-eligible charges in modify mode for this citation."
                          Charges="VisibleCharges"
                          ModifyMode="_modifyMode"
                          CitationEligibleOnly="true"
                          OnChargeSelected="LinkChargeAsync"
                          OnChargeRemoved="UnlinkChargeAsync" />

    <!-- Linked Incidents -->
    <div class="record-related-section">
        <div class="record-related-header">
            <h4 class="record-related-title">Linked Incidents</h4>
        </div>
        <div class="record-related-body">
        @if (VisibleLinkedIncidents is null)
        {
            <LoadingSpinner Message="Loading linked incidents..." />
        }
        else if (!VisibleLinkedIncidents.Any())
        {
            <div class="record-related-empty-state">
                <div class="empty-state">
                    <i class="bi bi-link-45deg"></i>
                    <div class="fw-medium">No linked incidents.</div>
                    <div class="small mt-1">Link this citation to an incident in modify mode when the record belongs to a larger case.</div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>#</th><th>Incident</th><th>Linked At</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in VisibleLinkedIncidents)
                    {
                        <tr>
                            <td>@link.IncidentRecordNumber</td>
                            <td>@link.IncidentNum</td>
                            <td>@link.LinkedAtUtc.ToShortDateString()</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" href="/incidents/@link.IncidentRecordNumber">View</a>
                                @if (_modifyMode)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => UnlinkFromIncidentAsync(link.IncidentId)">Unlink</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_modifyMode)
        {
            <div class="record-link-picker">
                <select class="form-select form-select-sm" @bind="_linkIncidentId">
                    <option value="@Guid.Empty">— select incident to link —</option>
                    @if (_allIncidents is not null)
                    {
                        @foreach (var i in _allIncidents)
                        {
                            <option value="@i.Id">@i.RecordNumber — @i.Details.IncidentNum</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="LinkToIncidentAsync"
                        disabled="@(_linkIncidentId == Guid.Empty)">+ Link</button>
            </div>
        }
        </div>
    </div>

    @if (_modifyMode)
    {
        <div class="record-save-row mb-4">
            <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync">
                <i class="bi bi-floppy-fill me-1"></i>Save
            </button>
        </div>
    }
    <AuditInfoSection CreatedAt="@_citation.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_citation.ModifiedBy.HasValue ? _citation.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
}

@code {
    [Parameter] public long? IncidentRecordNumber { get; set; }
    [Parameter] public long RecordNumber { get; set; }

    private string DetailsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/citations/{RecordNumber}"
            : $"/citations/{RecordNumber}";

    private string RelationshipsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/citations/{RecordNumber}/relationships"
            : $"/citations/{RecordNumber}/relationships";

    private Guid _citationId;
    private CitationDto? _citation;
    private IReadOnlyList<IncidentCitationLinkDto>? _linkedIncidents;
    private IReadOnlyList<RecordChargeDto>? _charges;
    private IReadOnlyList<IncidentDto>? _allIncidents;
    private Guid _linkIncidentId = Guid.Empty;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    private Guid? _editNameId;
    private string? _editNameDisplay;
    private long? _editNameRecordNumber;
    private bool _showNameModal;
    private Guid? _editOfficerSourceNameId;
    private string? _editOfficerSourceDisplay;
    private long? _editOfficerSourceRecordNumber;
    private string _editOfficerName = string.Empty;
    private string? _editOfficerTitle;
    private string? _editOfficerBadgeOrIdentifier;
    private string? _editOfficerUnitNumber;
    private bool _showOfficerNameModal;
    private string? _editTexasDocketNumber;
    private string? _editTexasPageNumber;
    private Guid? _editTexasViolationSourceTypeId;
    private string? _editTexasViolationSection;
    private Guid? _editTexasViolationGroupId;
    private string? _editTexasPrimaryViolationDescription;
    private int? _editTexasSpeedMph;
    private int? _editTexasZoneMph;
    private Guid? _editTexasSpeedBandId;
    private string? _editTexasNarrativeOtherViolations;
    private string? _editTexasOccurredAtText;
    private DateTime? _editTexasCourtAppearanceDateTime;
    private Guid? _editTexasCourtAppearanceLocationId;
    private string? _editTexasCourtAppearanceLocationDisplay;
    private bool _showTexasAppearanceLocationModal;
    private DateTime? _editTexasAffidavitSignedDate;
    private string? _editTexasComplainantSignatureText;
    private string? _editTexasDefendantSignatureText;
    private string? _editTexasAcceptedBondNotes;
    private string? _editTexasReceiptNumber;
    private string? _texasViolationSourceTypeLabel;
    private string? _texasViolationGroupLabel;
    private string? _texasSpeedBandLabel;
    private bool _hasExistingAtTimeOfNameSnapshot;
    private string _editAtTimeOfNameType = NameTypes.Person;
    private string _editAtTimeOfLastOrBusinessName = string.Empty;
    private string? _editAtTimeOfFirstName;
    private string? _editAtTimeOfMiddleName;
    private Guid? _editAtTimeOfSexId;
    private Guid? _editAtTimeOfRaceId;
    private DateTime? _editAtTimeOfDateOfBirth;
    private string? _editAtTimeOfDriversLicenseNumber;
    private Guid? _editAtTimeOfDriversLicenseStateId;
    private int? _editAtTimeOfHeightInches;
    private int? _editAtTimeOfWeightLbs;
    private Guid? _editAtTimeOfHairColorId;
    private Guid? _editAtTimeOfEyeColorId;
    private Guid? _editAtTimeOfSuffixId;
    private string? _editAtTimeOfPlaceOfBirth;
    private string? _editAtTimeOfFbiNumber;
    private string? _editAtTimeOfLocalNumber;
    private string? _editAtTimeOfPrimaryPhone;
    private string? _editAtTimeOfPrimaryPhoneExtension;
    private string? _editAtTimeOfWorkPhone;
    private string? _editAtTimeOfWorkPhoneExtension;
    private string? _editAtTimeOfOtherPhone;
    private string? _editAtTimeOfOtherPhoneExtension;
    private string? _editAtTimeOfSocialSecurityNumber;
    private bool _editAtTimeOfIsCitizen;
    private DateTime? _editAtTimeOfDeceasedDate;
    private Guid? _editAtTimeOfPrimaryLocationId;
    private long? _editAtTimeOfPrimaryLocationRecordNumber;
    private string? _editAtTimeOfPrimaryLocationAddress;
    private Guid? _editAtTimeOfSecondaryLocationId;
    private long? _editAtTimeOfSecondaryLocationRecordNumber;
    private string? _editAtTimeOfSecondaryLocationAddress;
    private DateTime? _editAtTimeOfCopiedAtUtc;
    private string? _editAtTimeOfCopiedByName;
    private string? _atTimeOfSexLabel;
    private string? _atTimeOfRaceLabel;
    private string? _atTimeOfDriversLicenseStateLabel;
    private string _editDescription = string.Empty;
    private DateTime _editIssueDate = DateTime.Now;
    private string _editCitationNum = string.Empty;
    private bool _generatingCitationNum;
    private Guid? _editCourtId;
    private string? _courtLabel;
    private bool _courtRequired;
    private Guid?  _editLocationId;
    private string? _editLocationDisplay;
    private bool   _showLocationModal;
    private string? _editVehiclePlateNumber;
    private Guid? _editVehiclePlateStateId;
    private int? _editVehiclePlateYear;
    private int? _editVehicleModelYear;
    private string? _editVehicleMake;
    private string? _editVehicleStyle;
    private string? _editVehicleColor;
    private bool _editVehicleIsCommercial;
    private bool _editVehicleCarriesHazardousMaterial;
    private string? _vehiclePlateStateLabel;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;
    private readonly Dictionary<Guid, (ChargeDto Charge, DateTime LinkedAtUtc)> _pendingChargeAdds = [];
    private readonly HashSet<Guid> _pendingChargeRemoves = [];
    private readonly Dictionary<Guid, (IncidentDto Incident, DateTime LinkedAtUtc)> _pendingIncidentLinkAdds = [];
    private readonly HashSet<Guid> _pendingIncidentLinkRemoves = [];
    private readonly List<string> _createdForeignRecords = [];

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveRecordAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_citation is not null && _citation.IsLocked && _citation.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            _editNameId = _citation.DefendantNameId;
            _editNameDisplay = _citation.DefendantName;
            _editNameRecordNumber = _citation.DefendantNameRecordNumber;
            _editDescription = _citation.Description;
            _editIssueDate   = _citation.IssueDate;
            _editCitationNum = _citation.CitationNum;
            _editCourtId     = _citation.CourtId;
            _editLocationId  = _citation.LocationId;
            LoadAtTimeOfName(_citation.AtTimeOfName);
            LoadOfficerProfile(_citation.OfficerProfile);
            LoadTexasDetails(_citation.TexasDetails);
            LoadVehicle(_citation.Vehicle);
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _citation = await CitationService.GetByRecordNumberAsync(RecordNumber);
            if (_citation is not null)
                _citationId = _citation.Id;
            if (_citation is null) _error = "Citation not found.";

            if (_citation is not null && !_modifyMode)
            {
                _editNameId = _citation.DefendantNameId;
                _editNameDisplay = _citation.DefendantName;
                _editNameRecordNumber = _citation.DefendantNameRecordNumber;
                _editDescription = _citation.Description;
                _editIssueDate   = _citation.IssueDate;
                _editCitationNum = _citation.CitationNum;
                _editCourtId     = _citation.CourtId;
                _editLocationId  = _citation.LocationId;
                LoadAtTimeOfName(_citation.AtTimeOfName);
                LoadOfficerProfile(_citation.OfficerProfile);
                LoadTexasDetails(_citation.TexasDetails);
                LoadVehicle(_citation.Vehicle);
                await ResolveLocationDisplayAsync();
                await ResolveTexasAppearanceLocationDisplayAsync();
            }

            if (_citation is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_citation.CreatedBy);
                _modifiedByName = _citation.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_citation.ModifiedBy.Value)
                    : null;
                _lockedByName = _citation.IsLocked && _citation.LockedByUserId.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_citation.LockedByUserId.Value)
                    : null;

                _linkedIncidents = await CitationService.GetLinkedIncidentsAsync(_citationId);
                _charges = await ChargeService.GetByCitationAsync(_citationId);

                if (_modifyMode)
                    _allIncidents = await IncidentService.GetByJurisdictionAsync();

                // Resolve Court label for read-only display
                var setting = await PicklistService.GetSettingAsync(PicklistTypes.Court);
                _courtRequired = setting?.IsRequired ?? false;
                if (_citation.CourtId.HasValue)
                {
                    var labels = await PicklistService.GetItemsByIdsAsync([_citation.CourtId.Value]);
                    _courtLabel = labels.GetValueOrDefault(_citation.CourtId.Value);
                }
                else
                {
                    _courtLabel = null;
                }

                await ResolveAtTimeOfLabelsAsync();
                await ResolveTexasLabelsAsync();
                await ResolveVehicleLabelsAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await CitationService.AcquireLockAsync(_citationId);
            _modifyMode = true;
            _editNameId = _citation?.DefendantNameId;
            _editNameDisplay = _citation?.DefendantName;
            _editNameRecordNumber = _citation?.DefendantNameRecordNumber;
            _editDescription = _citation?.Description ?? string.Empty;
            _editIssueDate   = _citation?.IssueDate ?? DateTime.Now;
            _editCitationNum = _citation?.CitationNum ?? string.Empty;
            _editCourtId     = _citation?.CourtId;
            _editLocationId  = _citation?.LocationId;
            LoadAtTimeOfName(_citation?.AtTimeOfName);
            LoadOfficerProfile(_citation?.OfficerProfile);
            LoadTexasDetails(_citation?.TexasDetails);
            LoadVehicle(_citation?.Vehicle);
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        ClearPendingChanges();
        try { await CitationService.ReleaseLockAsync(_citationId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§",
            _editNameId,
            _editDescription,
            _editIssueDate,
            _editCitationNum,
            _editCourtId,
            _editLocationId,
            JsonSerializer.Serialize(BuildAtTimeOfNameInput()),
            JsonSerializer.Serialize(BuildOfficerProfileInput()),
            JsonSerializer.Serialize(BuildTexasDetailsInput()),
            JsonSerializer.Serialize(BuildVehicleInput()));

    private bool HasPendingChanges =>
        _modifyMode &&
        (_editSnapshot != ComputeEditSnapshot()
         || _pendingChargeAdds.Count > 0
         || _pendingChargeRemoves.Count > 0
         || _pendingIncidentLinkAdds.Count > 0
         || _pendingIncidentLinkRemoves.Count > 0
         || _createdForeignRecords.Count > 0);

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/citations/create");
            }
        }
        else
        {
            Nav.NavigateTo("/citations/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
    }


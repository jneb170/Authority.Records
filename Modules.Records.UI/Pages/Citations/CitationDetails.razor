@page "/citations/{RecordNumber:long}"
@page "/incidents/{IncidentRecordNumber:long}/citations/{RecordNumber:long}"
@implements IAsyncDisposable
@inject ICitationService CitationService
@inject IIncidentService IncidentService
@inject IChargeService ChargeService
@inject IPicklistService PicklistService
@inject IAgencyConfigurationService ConfigService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject ILocationService LocationService
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Services

<PageTitle>Citation Details</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_citation is not null)
{
    <nav aria-label="breadcrumb" class="record-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/citations">Citations</a></li>
            @if (IncidentRecordNumber.HasValue)
            {
                <li class="breadcrumb-item"><a href="/incidents/@IncidentRecordNumber">Incident</a></li>
            }
            <li class="breadcrumb-item active">Citation #@RecordNumber</li>
        </ol>
    </nav>

    <div class="page-header record-page-header">
        <div>
            <h2 class="page-header-title"><i class="bi bi-file-earmark-text-fill"></i> Citation Record</h2>
            <div class="page-header-sub">
                @(string.IsNullOrWhiteSpace(_citation.CitationNum)
                    ? $"Citation #{RecordNumber}"
                    : _citation.CitationNum)
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center record-header-meta">
            <span class="record-pill @(_citation.IsIssued ? "record-pill-success" : "record-pill-warning")">
                <i class="bi @(_citation.IsIssued ? "bi-check2-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                <span>@(_citation.IsIssued ? "Issued" : "Pending")</span>
            </span>
            <LockBadge IsLocked="@_citation.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    <RecordDetailsTabs DetailsUrl="@DetailsTabUrl"
                       RelationshipsUrl="@RelationshipsTabUrl"
                       ActiveTab="Details" />

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="record-toolbar mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2 record-mode-banner">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <div class="record-mode-actions">
                    <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync"><i class="bi bi-floppy-fill me-1"></i>Save</button>
                    <button class="btn btn-sm btn-outline-dark" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release</button>
                </div>
            </div>
        }
        else if (_citation.IsLocked && _citation.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify</button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar record-action-bar mb-4 d-flex flex-wrap gap-2">
            @if (!_citation.IsIssued)
            {
                <button class="btn btn-success btn-sm" @onclick="IssueAsync">Issue Citation</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Citation"
                   Message="Are you sure you want to delete this citation?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          WarningMessage="@GetReleaseWarningMessage()"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Citation Fields (always visible; inputs become editable in modify mode) -->
    <div class="card record-content-card mb-4">
        <div class="card-body">
            <h6 class="card-title">Citation Details</h6>
            <div class="record-grid-3">
                <div>
                    <label class="form-label mb-1">Citation Number</label>
                    @if (_modifyMode)
                    {
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control form-control-sm"
                                   @bind="_editCitationNum" placeholder="e.g. CT-2026-000001" />
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="GenerateCitationNumAsync" disabled="@_generatingCitationNum">
                                @(_generatingCitationNum ? "…" : "🔁")
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(string.IsNullOrWhiteSpace(_citation.CitationNum) ? "—" : _citation.CitationNum)</p>
                    }
                </div>
                <div class="record-field-span-2">
                    <label class="form-label mb-1">Description</label>
                    <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editDescription" placeholder="—" />
                </div>
                <div>
                    <label class="form-label mb-1">Issue Date</label>
                    <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           value="@DateTimeLocalInputHelper.Format(_editIssueDate)"
                           @onchange="OnIssueDateChanged" />
                </div>
                <div>
                    <label class="form-label mb-1">Court</label>
                    @if (_modifyMode)
                    {
                        <PicklistSelect PicklistType="@PicklistTypes.Court"
                                        @bind-Value="_editCourtId"
                                        IsRequired="@_courtRequired" />
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(_courtLabel ?? "—")</p>
                    }
                </div>
                <div>
                    <label class="form-label mb-1">Issued</label>
                    <div class="form-control-plaintext form-control-sm ps-0 mb-0">
                        <span class="record-pill @(_citation.IsIssued ? "record-pill-success" : "record-pill-warning")">
                            <i class="bi @(_citation.IsIssued ? "bi-check2-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                            <span>@(_citation.IsIssued ? "Issued" : "Pending")</span>
                        </span>
                    </div>
                </div>
                <div class="record-field-span-full">
                    <label class="form-label mb-1">Location</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">@(_editLocationDisplay ?? "— None —")</span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showLocationModal = true">
                                <i class="bi bi-geo-alt me-1"></i>@(_editLocationId.HasValue ? "Change" : "Assign") Location
                            </button>
                            @if (_editLocationId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned location" title="Clear assigned location" @onclick="ClearLocation">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                    <LocationMiniMap LocationId="_editLocationId" />
                </div>
            </div>
        </div>
    </div>

    <LocationSearchModal Visible="_showLocationModal"
                         CurrentLocationId="_editLocationId"
                         OnSelected="OnLocationSelected"
                         OnCreated="OnLocationCreatedAsync"
                         OnCleared="OnLocationCleared"
                         OnCancelled="() => _showLocationModal = false" />

    <RecordChargesSection Title="Charges"
                          EmptyTitle="No charges linked."
                          EmptyHint="Add citation-eligible charges in modify mode for this citation."
                          Charges="VisibleCharges"
                          ModifyMode="_modifyMode"
                          CitationEligibleOnly="true"
                          OnChargeSelected="LinkChargeAsync"
                          OnChargeRemoved="UnlinkChargeAsync" />

    <!-- Linked Incidents -->
    <div class="record-related-section">
        <div class="record-related-header">
            <h4 class="record-related-title">Linked Incidents</h4>
        </div>
        <div class="record-related-body">
        @if (VisibleLinkedIncidents is null)
        {
            <LoadingSpinner Message="Loading linked incidents..." />
        }
        else if (!VisibleLinkedIncidents.Any())
        {
            <div class="record-related-empty-state">
                <div class="empty-state">
                    <i class="bi bi-link-45deg"></i>
                    <div class="fw-medium">No linked incidents.</div>
                    <div class="small mt-1">Link this citation to an incident in modify mode when the record belongs to a larger case.</div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>#</th><th>Incident</th><th>Linked At</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in VisibleLinkedIncidents)
                    {
                        <tr>
                            <td>@link.IncidentRecordNumber</td>
                            <td>@link.IncidentNum</td>
                            <td>@link.LinkedAtUtc.ToShortDateString()</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" href="/incidents/@link.IncidentRecordNumber">View</a>
                                @if (_modifyMode)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => UnlinkFromIncidentAsync(link.IncidentId)">Unlink</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_modifyMode)
        {
            <div class="record-link-picker">
                <select class="form-select form-select-sm" @bind="_linkIncidentId">
                    <option value="@Guid.Empty">— select incident to link —</option>
                    @if (_allIncidents is not null)
                    {
                        @foreach (var i in _allIncidents)
                        {
                            <option value="@i.Id">@i.RecordNumber — @i.Details.IncidentNum</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="LinkToIncidentAsync"
                        disabled="@(_linkIncidentId == Guid.Empty)">+ Link</button>
            </div>
        }
        </div>
    </div>

    @if (_modifyMode)
    {
        <div class="record-save-row mb-4">
            <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync">
                <i class="bi bi-floppy-fill me-1"></i>Save
            </button>
        </div>
    }
    <AuditInfoSection CreatedAt="@_citation.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_citation.ModifiedBy.HasValue ? _citation.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
}

@code {
    [Parameter] public long? IncidentRecordNumber { get; set; }
    [Parameter] public long RecordNumber { get; set; }

    private string DetailsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/citations/{RecordNumber}"
            : $"/citations/{RecordNumber}";

    private string RelationshipsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/citations/{RecordNumber}/relationships"
            : $"/citations/{RecordNumber}/relationships";

    private Guid _citationId;
    private CitationDto? _citation;
    private IReadOnlyList<IncidentCitationLinkDto>? _linkedIncidents;
    private IReadOnlyList<RecordChargeDto>? _charges;
    private IReadOnlyList<IncidentDto>? _allIncidents;
    private Guid _linkIncidentId = Guid.Empty;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    private string _editDescription = string.Empty;
    private DateTime _editIssueDate = DateTime.Now;
    private string _editCitationNum = string.Empty;
    private bool _generatingCitationNum;
    private Guid? _editCourtId;
    private string? _courtLabel;
    private bool _courtRequired;
    private Guid?  _editLocationId;
    private string? _editLocationDisplay;
    private bool   _showLocationModal;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;
    private readonly Dictionary<Guid, (ChargeDto Charge, DateTime LinkedAtUtc)> _pendingChargeAdds = [];
    private readonly HashSet<Guid> _pendingChargeRemoves = [];
    private readonly Dictionary<Guid, (IncidentDto Incident, DateTime LinkedAtUtc)> _pendingIncidentLinkAdds = [];
    private readonly HashSet<Guid> _pendingIncidentLinkRemoves = [];
    private readonly List<string> _createdForeignRecords = [];

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveRecordAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_citation is not null && _citation.IsLocked && _citation.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            _editDescription = _citation.Description;
            _editIssueDate   = _citation.IssueDate;
            _editCitationNum = _citation.CitationNum;
            _editCourtId     = _citation.CourtId;
            _editLocationId  = _citation.LocationId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _citation = await CitationService.GetByRecordNumberAsync(RecordNumber);
            if (_citation is not null)
                _citationId = _citation.Id;
            if (_citation is null) _error = "Citation not found.";

            if (_citation is not null && !_modifyMode)
            {
                _editDescription = _citation.Description;
                _editIssueDate   = _citation.IssueDate;
                _editCitationNum = _citation.CitationNum;
                _editCourtId     = _citation.CourtId;
                _editLocationId  = _citation.LocationId;
                await ResolveLocationDisplayAsync();
            }

            if (_citation is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_citation.CreatedBy);
                _modifiedByName = _citation.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_citation.ModifiedBy.Value)
                    : null;
                _lockedByName = _citation.IsLocked && _citation.LockedByUserId.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_citation.LockedByUserId.Value)
                    : null;

                _linkedIncidents = await CitationService.GetLinkedIncidentsAsync(_citationId);
                _charges = await ChargeService.GetByCitationAsync(_citationId);

                if (_modifyMode)
                    _allIncidents = await IncidentService.GetByJurisdictionAsync();

                // Resolve Court label for read-only display
                var setting = await PicklistService.GetSettingAsync(PicklistTypes.Court);
                _courtRequired = setting?.IsRequired ?? false;
                if (_citation.CourtId.HasValue)
                {
                    var labels = await PicklistService.GetItemsByIdsAsync([_citation.CourtId.Value]);
                    _courtLabel = labels.GetValueOrDefault(_citation.CourtId.Value);
                }
                else
                {
                    _courtLabel = null;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await CitationService.AcquireLockAsync(_citationId);
            _modifyMode = true;
            _editDescription = _citation?.Description ?? string.Empty;
            _editIssueDate   = _citation?.IssueDate ?? DateTime.Now;
            _editCitationNum = _citation?.CitationNum ?? string.Empty;
            _editCourtId     = _citation?.CourtId;
            _editLocationId  = _citation?.LocationId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        ClearPendingChanges();
        try { await CitationService.ReleaseLockAsync(_citationId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editDescription, _editIssueDate, _editCitationNum, _editCourtId, _editLocationId);

    private bool HasPendingChanges =>
        _modifyMode &&
        (_editSnapshot != ComputeEditSnapshot()
         || _pendingChargeAdds.Count > 0
         || _pendingChargeRemoves.Count > 0
         || _pendingIncidentLinkAdds.Count > 0
         || _pendingIncidentLinkRemoves.Count > 0
         || _createdForeignRecords.Count > 0);

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/citations/create");
            }
        }
        else
        {
            Nav.NavigateTo("/citations/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
    }

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await SaveRecordAsync();
        if (_actionError is null)
        {
            await ExitModifyModeAsync();
            if (navigateToNew) Nav.NavigateTo("/citations/create");
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await ExitModifyModeAsync();
        if (navigateToNew) Nav.NavigateTo("/citations/create");
    }

    private async Task GenerateCitationNumAsync()
    {
        _generatingCitationNum = true;
        try { _editCitationNum = await ConfigService.GenerateCitationNumAsync(); }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _generatingCitationNum = false; }
    }

    private void OnIssueDateChanged(ChangeEventArgs e)
    {
        if (DateTimeLocalInputHelper.TryParse(e.Value?.ToString(), out var issueDate))
        {
            _editIssueDate = issueDate;
        }
    }

    private async Task SaveRecordAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;
        try
        {
            await CitationService.SavePageAsync(
                _citationId,
                _editDescription,
                _editIssueDate,
                _editCourtId,
                _editCitationNum,
                _editLocationId,
                _pendingIncidentLinkAdds.Keys.ToArray(),
                _pendingIncidentLinkRemoves.ToArray(),
                _pendingChargeAdds.Keys.ToArray(),
                _pendingChargeRemoves.ToArray());
            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            ClearPendingChanges();
            _saveSuccessMessage = "Record saved successfully.";
            _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
            {
                _saveSuccessMessage = null;
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            try { await LoadAsync(); } catch { _actionError += " (State may be out of sync — please refresh the page.)"; }
        }
    }

    private async Task LinkToIncidentAsync()
    {
        if (_linkIncidentId == Guid.Empty) return;
        if (_pendingIncidentLinkRemoves.Remove(_linkIncidentId))
        {
            _linkIncidentId = Guid.Empty;
            return;
        }

        if ((_linkedIncidents?.Any(link => link.IncidentId == _linkIncidentId) ?? false) || _pendingIncidentLinkAdds.ContainsKey(_linkIncidentId))
        {
            _linkIncidentId = Guid.Empty;
            return;
        }

        var incident = _allIncidents?.FirstOrDefault(i => i.Id == _linkIncidentId);
        if (incident is not null)
            _pendingIncidentLinkAdds[_linkIncidentId] = (incident, DateTime.UtcNow);

        _linkIncidentId = Guid.Empty;
    }

    private Task UnlinkFromIncidentAsync(Guid incidentId)
    {
        if (_pendingIncidentLinkAdds.Remove(incidentId))
            return Task.CompletedTask;

        if (_linkedIncidents?.Any(link => link.IncidentId == incidentId) == true)
            _pendingIncidentLinkRemoves.Add(incidentId);

        return Task.CompletedTask;
    }

    private Task LinkChargeAsync(ChargeDto charge)
    {
        if (_pendingChargeRemoves.Remove(charge.Id))
            return Task.CompletedTask;

        if ((_charges?.Any(c => c.ChargeId == charge.Id) ?? false) || _pendingChargeAdds.ContainsKey(charge.Id))
            return Task.CompletedTask;

        _pendingChargeAdds[charge.Id] = (charge, DateTime.UtcNow);
        return Task.CompletedTask;
    }

    private Task UnlinkChargeAsync(Guid chargeId)
    {
        if (_pendingChargeAdds.Remove(chargeId))
            return Task.CompletedTask;

        if (_charges?.Any(c => c.ChargeId == chargeId) == true)
            _pendingChargeRemoves.Add(chargeId);

        return Task.CompletedTask;
    }

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)LockTimeout.TotalSeconds;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    private Task IssueAsync() => RunActionAsync(() => CitationService.IssueAsync(_citationId));

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        await RunActionAsync(() => CitationService.SoftDeleteAsync(_citationId));
        if (IncidentRecordNumber.HasValue)
            Nav.NavigateTo($"/incidents/{IncidentRecordNumber}");
        else
            Nav.NavigateTo("/citations");
    }

    private async Task ResolveLocationDisplayAsync()
    {
        if (_editLocationId.HasValue)
        {
            var loc = await LocationService.GetByIdAsync(_editLocationId.Value);
            _editLocationDisplay = loc is null ? null : FormatLocationDisplay(loc);
        }
        else
        {
            _editLocationDisplay = null;
        }
    }

    private void OnLocationSelected(LocationDto loc)
    {
        _editLocationId      = loc.Id;
        _editLocationDisplay = FormatLocationDisplay(loc);
        _showLocationModal   = false;
    }

    private Task OnLocationCreatedAsync(LocationDto loc)
    {
        TrackCreatedForeignRecord($"Location #{loc.RecordNumber} was created. If you discard this page, it will remain in the system but will not be linked to this citation.");
        return Task.CompletedTask;
    }

    private void OnLocationCleared()
    {
        _editLocationId      = null;
        _editLocationDisplay = null;
        _showLocationModal   = false;
    }

    private void ClearLocation()
    {
        _editLocationId      = null;
        _editLocationDisplay = null;
    }

    private static string FormatLocationDisplay(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber))  parts.Add(loc.StreetNumber);
        if (!string.IsNullOrWhiteSpace(loc.StreetAddress)) parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))          parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    private IReadOnlyList<RecordChargeDto>? VisibleCharges =>
        _charges is null
            ? null
            : _charges
                .Where(c => !_pendingChargeRemoves.Contains(c.ChargeId))
                .Concat(_pendingChargeAdds.Values
                    .Where(p => _charges.All(existing => existing.ChargeId != p.Charge.Id))
                    .Select(p => MapCharge(p.Charge, p.LinkedAtUtc)))
                .OrderByDescending(c => c.LinkedAtUtc)
                .ToList();

    private IReadOnlyList<IncidentCitationLinkDto>? VisibleLinkedIncidents =>
        _linkedIncidents is null
            ? null
            : _linkedIncidents
                .Where(link => !_pendingIncidentLinkRemoves.Contains(link.IncidentId))
                .Concat(_pendingIncidentLinkAdds.Values
                    .Where(p => _linkedIncidents.All(existing => existing.IncidentId != p.Incident.Id))
                    .Select(p => MapIncidentLink(p.Incident, p.LinkedAtUtc)))
                .OrderByDescending(link => link.LinkedAtUtc)
                .ToList();

    private static RecordChargeDto MapCharge(ChargeDto charge, DateTime linkedAtUtc) =>
        new(
            charge.Id,
            charge.OffenseName,
            charge.UcrCode,
            charge.ChargeLevel,
            charge.StateClass,
            charge.IsCitationEligible,
            charge.IsActive,
            linkedAtUtc);

    private static IncidentCitationLinkDto MapIncidentLink(IncidentDto incident, DateTime linkedAtUtc) =>
        new(
            Guid.Empty,
            incident.Id,
            incident.RecordNumber,
            string.IsNullOrWhiteSpace(incident.Details.IncidentNum) ? $"Incident #{incident.RecordNumber}" : incident.Details.IncidentNum,
            Guid.Empty,
            linkedAtUtc);

    private string? GetReleaseWarningMessage() =>
        _createdForeignRecords.Count == 0 ? null : string.Join(" ", _createdForeignRecords);

    private void TrackCreatedForeignRecord(string message)
    {
        if (!_createdForeignRecords.Contains(message, StringComparer.Ordinal))
            _createdForeignRecords.Add(message);
    }

    private void ClearPendingChanges()
    {
        _pendingChargeAdds.Clear();
        _pendingChargeRemoves.Clear();
        _pendingIncidentLinkAdds.Clear();
        _pendingIncidentLinkRemoves.Clear();
        _createdForeignRecords.Clear();
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        return ValueTask.CompletedTask;
    }
}

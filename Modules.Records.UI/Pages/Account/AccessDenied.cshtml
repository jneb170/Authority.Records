@page "/account/access-denied"
@model Modules.Records.UI.Pages.Account.AccessDeniedModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access denied — Authority Records</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="ar-auth-body">
    <div class="ar-auth-shell">
        <section class="ar-auth-card-panel">
            <div class="ar-auth-card text-center">
                <i class="bi bi-shield-lock fs-1 text-secondary"></i>
                <h1 class="ar-auth-card-title">You don't have access to that page</h1>
                <p class="ar-auth-card-text mb-4">
                    Your role doesn't include this area. An administrator can change your permissions in User Management.
                </p>
                <a href="/" class="btn btn-primary btn-lg w-100">Back to the dashboard</a>
            </div>
        </section>
    </div>
</body>
</html>

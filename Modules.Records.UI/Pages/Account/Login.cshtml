@page
@model Modules.Records.UI.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authority Records — Law-enforcement RMS demo</title>
    <meta name="description" content="Authority Records: a records management system for law-enforcement agencies, built with .NET 10 and Blazor Server. Try the live demo." />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="ar-auth-body">
    <div class="ar-auth-shell">
      <div class="ar-auth-layout @(Model.About.Enabled ? "ar-auth-layout-split" : "")">
        @if (Model.About.Enabled)
        {
            <section class="ar-auth-about" aria-labelledby="about-title">
                <span class="ar-auth-about-eyebrow">Portfolio project &middot; Live demo</span>
                <h1 id="about-title" class="ar-auth-about-title">Authority Records</h1>
                <p class="ar-auth-about-lead">
                    A records management system for law-enforcement agencies: incidents, arrests and citations,
                    and the people and places connected to them.
                </p>

                <ul class="ar-auth-about-list">
                    <li><i class="bi bi-diagram-3"></i>Incident, arrest and citation workflows with lifecycle rules (Draft &rarr; Open &rarr; Closed) and pessimistic record locking</li>
                    <li><i class="bi bi-people"></i>Master Name and Location indexes that link every record a person or place appears in</li>
                    <li><i class="bi bi-building-lock"></i>Multi-agency tenancy, role-based access and a full audit trail</li>
                    <li><i class="bi bi-file-earmark-pdf"></i>Texas citation form rendered as a server-generated PDF</li>
                </ul>

                <div class="ar-auth-about-stack" aria-label="Technology">
                    <span>.NET 10</span><span>Blazor Server</span><span>EF Core</span><span>CQRS + MediatR</span>
                    <span>Domain-driven design</span><span>Outbox &amp; read models</span><span>xUnit</span><span>Docker on AWS</span>
                </div>

                <form method="post" asp-page-handler="Demo" class="ar-auth-about-cta">
                    <button type="submit" class="btn btn-warning btn-lg fw-semibold">
                        <i class="bi bi-play-circle me-1"></i> Explore the live demo
                    </button>
                    <span class="ar-auth-about-cta-note">No sign-up. You'll be a supervisor at a fictional agency. All people and records are made up.</span>
                </form>

                @if (Model.About.GitHubUrl is not null || Model.About.LinkedInUrl is not null || Model.About.WebsiteUrl is not null || Model.About.AuthorName is not null)
                {
                    <div class="ar-auth-about-links">
                        @if (Model.About.AuthorName is not null)
                        {
                            <span class="ar-auth-about-author">Built by @Model.About.AuthorName</span>
                        }
                        @if (Model.About.GitHubUrl is not null)
                        {
                            <a href="@Model.About.GitHubUrl" target="_blank" rel="noopener"><i class="bi bi-github"></i> Source code</a>
                        }
                        @if (Model.About.LinkedInUrl is not null)
                        {
                            <a href="@Model.About.LinkedInUrl" target="_blank" rel="noopener"><i class="bi bi-linkedin"></i> LinkedIn</a>
                        }
                        @if (Model.About.WebsiteUrl is not null)
                        {
                            <a href="@Model.About.WebsiteUrl" target="_blank" rel="noopener"><i class="bi bi-globe2"></i> Website</a>
                        }
                    </div>
                }
            </section>
        }

        <section class="ar-auth-card-panel">
            <div class="ar-auth-card">
                <div class="ar-auth-brand ar-auth-brand-card">
                    <span class="ar-auth-brand-icon-wrap">
                        <img src="/favicon.svg" width="28" height="28" alt="Authority Records" />
                    </span>
                    <div>
                        <div class="ar-auth-brand-title">Authority Records</div>
                        <div class="ar-auth-brand-sub">Records Management Workspace</div>
                    </div>
                </div>

                <div class="ar-auth-card-header">
                    <span class="ar-auth-eyebrow">Secure access</span>
                    <h1 class="ar-auth-card-title">Sign in</h1>
                    <p class="ar-auth-card-text">Use your assigned credentials to enter the records workspace.</p>
                </div>

                <div class="ar-auth-card-notice">Authorized personnel only</div>

                <form method="post" class="ar-auth-form">
                    <div asp-validation-summary="ModelOnly" class="ar-auth-validation"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control form-control-lg" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Sign In</button>
                </form>

                @* The project panel has its own, more prominent demo button. *@
                @if (!Model.About.Enabled)
                {
                    <div class="ar-auth-divider">
                        <span>or</span>
                    </div>

                    <form method="post" asp-page-handler="Demo" class="ar-auth-form">
                        <button type="submit" class="btn btn-outline-secondary btn-lg w-100">
                            <i class="bi bi-eye me-1"></i> Try the demo
                        </button>
                        <p class="text-muted small mt-2 mb-0 text-center">
                            Browse a sample agency. No account required.
                        </p>
                    </form>
                }
            </div>
        </section>
      </div>
    </div>
</body>
</html>

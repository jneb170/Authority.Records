@page "/admin/test-data"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Supervisor")]
@inject INameService NameService
@inject IPicklistService PicklistService
@inject IChargeService ChargeService
@inject IGoogleMapsConfigService GoogleMapsConfig
@inject MediatR.ISender Sender
@inject IWebHostEnvironment HostEnvironment
@using Modules.Records.Application.Arrests.Commands.GenerateTestArrests

<PageTitle>Test Data Generation</PageTitle>

<div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
    <div>
        <h2 class="fw-bold mb-0">🧪 Test Data Generation</h2>
        <small class="text-muted">Seed realistic fake records for testing purposes</small>
    </div>
</div>

@* ── Step 1: Seed Picklists ──────────────────────────────────────────────── *@
<h5 class="fw-semibold mb-3">Step 1 — Seed Picklist Defaults</h5>
<p class="text-muted small mb-3">
    These buttons are idempotent — existing values are skipped. Run them once per agency before generating names.
</p>

<div class="row g-3 mb-5">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">MNI Picklists</h6>
                <p class="card-text text-muted small">
                    Seeds <strong>Sex</strong>, <strong>Race</strong>, <strong>Hair Color</strong>, and <strong>Eye Color</strong>
                    with standard values.
                </p>
                <div class="d-flex gap-3 small text-muted mb-3">
                    <span>Sex: @_sexCount items</span>
                    <span>Race: @_raceCount items</span>
                    <span>Hair: @_hairCount items</span>
                    <span>Eye: @_eyeCount items</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <button class="btn btn-outline-primary btn-sm" @onclick="SeedMniPicklistsAsync" disabled="@_seeding">
                    @if (_seedingMni) { <span class="spinner-border spinner-border-sm me-1"></span> } Seed MNI Picklists
                </button>
                @if (_mniSeedResult is not null)
                {
                    <span class="ms-2 small @(_mniSeedResult.StartsWith("✅") ? "text-success" : "text-danger")">@_mniSeedResult</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">DL States</h6>
                <p class="card-text text-muted small">
                    Seeds all <strong>50 US states</strong>, DC, and inhabited territories into the State picklist.
                </p>
                <div class="d-flex gap-3 small text-muted mb-3">
                    <span>State: @_stateCount / 56 items</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <button class="btn btn-outline-primary btn-sm" @onclick="SeedDlStatesAsync" disabled="@_seeding">
                    @if (_seedingStates) { <span class="spinner-border spinner-border-sm me-1"></span> } Seed DL States
                </button>
                @if (_stateSeedResult is not null)
                {
                    <span class="ms-2 small @(_stateSeedResult.StartsWith("✅") ? "text-success" : "text-danger")">@_stateSeedResult</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">Name Suffixes</h6>
                <p class="card-text text-muted small">
                    Seeds common name suffixes (<strong>JR, SR, II, III, IV, V, MD, DO, DDS, JD, PHD, RN, ESQ, RET</strong>) into the Suffix picklist.
                </p>
                <div class="d-flex gap-3 small text-muted mb-3">
                    <span>Suffix: @_suffixCount / 14 items</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <button class="btn btn-outline-primary btn-sm" @onclick="SeedSuffixesAsync" disabled="@_seeding">
                    @if (_seedingSuffixes) { <span class="spinner-border spinner-border-sm me-1"></span> } Seed Suffixes
                </button>
                @if (_suffixSeedResult is not null)
                {
                    <span class="ms-2 small @(_suffixSeedResult.StartsWith("✅") ? "text-success" : "text-danger")">@_suffixSeedResult</span>
                }
            </div>
        </div>
    </div>
</div>

@* ── Step 2: Seed Charges ───────────────────────────────────────────────── *@
<h5 class="fw-semibold mb-3">Step 2 — Seed Charges</h5>

<p class="text-muted small mb-3">
    Loads the initial charge catalog from <code>Documents\charges.json</code>. Existing entries are updated by offense name and UCR code.
</p>

<div class="row g-3 mb-5">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="card-title">Charge Catalog</h6>
                <p class="card-text text-muted small">
                    Seeds the violations / charges master list used by incidents, arrests, and citations.
                </p>
                <div class="d-flex gap-3 small text-muted mb-3">
                    <span>Charges: @_chargeCount item(s)</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <button class="btn btn-outline-primary btn-sm" @onclick="SeedChargesAsync" disabled="@_seeding">
                    @if (_seedingCharges) { <span class="spinner-border spinner-border-sm me-1"></span> } Seed Charges
                </button>
                @if (_chargesSeedResult is not null)
                {
                    <span class="ms-2 small @(_chargesSeedResult.StartsWith("✅") ? "text-success" : "text-danger")">@_chargesSeedResult</span>
                }
            </div>
        </div>
    </div>
</div>

@* ── Step 3: Generate Fake Names ─────────────────────────────────────────── *@
<div class="row g-3 mb-5">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">Step 3 — Generate Fake Name Records</h5>

                @if (!_canGenerate)
                {
                    <div class="alert alert-warning">
                        ⚠️ One or more required picklists are empty (Sex, Race, HairColor, EyeColor, or State). Seed them in Step 1 before generating.
                    </div>
                }

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-auto">
                        <label class="form-label fw-semibold">Number of Records</label>
                        <input type="number" class="form-control" style="width:120px"
                               min="1" max="500" @bind="_generateCount" disabled="@_generating" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary" @onclick="GenerateNamesAsync"
                                disabled="@(_generating || !_canGenerate)">
                            @if (_generating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Generate @_generateCount Name Records
                        </button>
                    </div>
                </div>

                @if (_generating || _generatedCount > 0)
                {
                    <div class="mb-2">
                        <div class="progress" style="height:22px;">
                            <div class="progress-bar progress-bar-striped @(_generating ? "progress-bar-animated" : "")"
                                 role="progressbar"
                                 style="width: @(_generateCount > 0 ? (int)((_generatedCount * 100.0) / _generateCount) : 0)%">
                                @_generatedCount / @_generateCount
                            </div>
                        </div>
                    </div>
                }

                @if (_generateResult is not null)
                {
                    <div class="alert @(_generateErrors == 0 ? "alert-success" : "alert-warning") mt-2">
                        @_generateResult
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ── Step 4: Generate Location Records ──────────────────────────────────── *@
<div class="row g-3 mb-5">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">Step 4 — Generate Location Records from Google Maps</h5>

                @if (!_hasMapsApiKey)
                {
                    <div class="alert alert-warning mb-4">
                        ⚠️ No Google Maps API key is configured for this jurisdiction. Set one under
                        <strong>Administration → Location Settings</strong> before generating location records.
                    </div>
                }

                <p class="text-muted small mb-3">
                    Searches Google Maps Places Text Search for real addresses matching your keyword and creates
                    Location (MLI) records. Picklist FKs (Direction, StreetType, State, Country) are resolved
                    automatically when the relevant picklists have been seeded.
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title">Location Picklist Status</h6>
                                <p class="card-text text-muted small">
                                    Seed these picklists first to enable FK resolution on generated records.
                                </p>
                                <div class="d-flex gap-3 flex-wrap small text-muted">
                                    <span>Direction: @_directionCount items</span>
                                    <span>StreetType: @_streetTypeCount items</span>
                                    <span>Country: @_countryCount items</span>
                                    <span>State: @_stateCount items</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Search Keyword</label>
                        <input type="text" class="form-control"
                               placeholder="e.g. police stations near Dallas TX"
                               @bind="_locKeyword"
                               disabled="@(_generatingLocations || !_hasMapsApiKey)" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label fw-semibold">Count</label>
                        <input type="number" class="form-control" style="width:100px"
                               min="1" max="60" @bind="_locCount"
                               disabled="@(_generatingLocations || !_hasMapsApiKey)" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary"
                                @onclick="GenerateLocationsAsync"
                                disabled="@(_generatingLocations || !_hasMapsApiKey || string.IsNullOrWhiteSpace(_locKeyword))">
                            @if (_generatingLocations) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Generate @_locCount Location Record@(_locCount == 1 ? "" : "s")
                        </button>
                    </div>
                </div>

                @if (_generatingLocations || _locGeneratedCount > 0)
                {
                    <div class="mb-2">
                        <div class="progress" style="height:22px;">
                            <div class="progress-bar progress-bar-striped @(_generatingLocations ? "progress-bar-animated" : "")"
                                 role="progressbar"
                                 style="width: @(_locCount > 0 ? (int)((_locGeneratedCount * 100.0) / _locCount) : 0)%">
                                @_locGeneratedCount / @_locCount
                            </div>
                        </div>
                    </div>
                }

                @if (_locResult is not null)
                {
                    <div class="alert @(_locErrors == 0 ? "alert-success" : "alert-warning") mt-2">
                        @_locResult
                    </div>
                }

                @if (_locErrorDetails.Count > 0)
                {
                    <details class="mt-2">
                        <summary class="small text-danger">@_locErrorDetails.Count error(s)</summary>
                        <ul class="small mt-1">
                            @foreach (var e in _locErrorDetails)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>
</div>

@* ── Step 5: Generate Arrest Records ─────────────────────────────────────── *@
<div class="row g-3 mb-5">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">Step 5 — Generate Arrest Records</h5>

                <p class="text-muted small mb-3">
                    Creates arrest records and links a suspect Name plus an arrest Location using the selected source
                    strategies. “Recently created” means records created earlier in this same generation run.
                </p>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-auto">
                        <label class="form-label fw-semibold">Number of Arrests</label>
                        <input type="number" class="form-control" style="width:120px"
                               min="1" max="250" @bind="_arrestCount" disabled="@_generatingArrests" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Arrested From</label>
                        <input type="datetime-local" class="form-control"
                               value="@_arrestFromInput"
                               @onchange="OnArrestFromChanged"
                               disabled="@_generatingArrests" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Arrested To</label>
                        <input type="datetime-local" class="form-control"
                               value="@_arrestToInput"
                               @onchange="OnArrestToChanged"
                               disabled="@_generatingArrests" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label fw-semibold">Max Uses per Name</label>
                        <input type="number" class="form-control" style="width:120px"
                               min="1" max="250" @bind="_arrestNameMaxUses" disabled="@_generatingArrests" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label fw-semibold">Max Uses per Location</label>
                        <input type="number" class="form-control" style="width:120px"
                               min="1" max="250" @bind="_arrestLocationMaxUses" disabled="@_generatingArrests" />
                    </div>
                </div>

                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Name source</label>
                        <InputSelect class="form-select" @bind-Value="_arrestNameStrategy" disabled="@_generatingArrests">
                            <option value="@TestDataRecordLinkStrategy.Existing">Reuse existing Name records</option>
                            <option value="@TestDataRecordLinkStrategy.CreateNew">Create a new Name per arrest</option>
                            <option value="@TestDataRecordLinkStrategy.RecentlyCreatedOrCreateNew">Reuse Names created earlier in this run, or create new</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Location source</label>
                        <InputSelect class="form-select" @bind-Value="_arrestLocationStrategy" disabled="@_generatingArrests">
                            <option value="@TestDataRecordLinkStrategy.Existing">Reuse existing Location records</option>
                            <option value="@TestDataRecordLinkStrategy.CreateNew">Create a new Location per arrest</option>
                            <option value="@TestDataRecordLinkStrategy.RecentlyCreatedOrCreateNew">Reuse Locations created earlier in this run, or create new</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Location Search Keyword</label>
                        <input type="text" class="form-control"
                               placeholder="e.g. police stations near Dallas TX"
                               @bind="_arrestLocationKeyword"
                               disabled="@(_generatingArrests || !ArrestLocationKeywordRequired || !_hasMapsApiKey)" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-primary"
                                @onclick="GenerateArrestsAsync"
                                disabled="@(_generatingArrests || (ArrestLocationKeywordRequired && (!_hasMapsApiKey || string.IsNullOrWhiteSpace(_arrestLocationKeyword))))">
                            @if (_generatingArrests) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Generate @_arrestCount Arrest Record@(_arrestCount == 1 ? "" : "s")
                        </button>
                    </div>
                </div>

                @if (ArrestLocationKeywordRequired && !_hasMapsApiKey)
                {
                    <div class="alert alert-warning mt-2">
                        ⚠️ A Google Maps API key is required to create new arrest locations from a search keyword.
                    </div>
                }

                @if (_generatingArrests || _arrestGeneratedCount > 0)
                {
                    <div class="mb-2">
                        <div class="progress" style="height:22px;">
                            <div class="progress-bar progress-bar-striped @(_generatingArrests ? "progress-bar-animated" : "")"
                                 role="progressbar"
                                 style="width: @(_arrestCount > 0 ? (int)((_arrestGeneratedCount * 100.0) / _arrestCount) : 0)%">
                                @_arrestGeneratedCount / @_arrestCount
                            </div>
                        </div>
                    </div>
                }

                @if (_arrestResult is not null)
                {
                    <div class="alert @(_arrestErrors == 0 ? "alert-success" : "alert-warning") mt-2">
                        <div>@_arrestResult</div>
                        @if (!string.IsNullOrWhiteSpace(_arrestSummary))
                        {
                            <div class="small mt-1">@_arrestSummary</div>
                        }
                    </div>
                }

                @if (_arrestErrorDetails.Count > 0)
                {
                    <details class="mt-2">
                        <summary class="small text-danger">@_arrestErrorDetails.Count error(s)</summary>
                        <ul class="small mt-1">
                            @foreach (var e in _arrestErrorDetails)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // ── Picklist counts ──────────────────────────────────────────────────────
    private int _sexCount;
    private int _raceCount;
    private int _hairCount;
    private int _eyeCount;
    private int _stateCount;
    private int _suffixCount;
    private int _chargeCount;

    // ── Picklist ID lookups (value → Guid) ───────────────────────────────────
    private Dictionary<string, Guid> _sexIds    = new();
    private Dictionary<string, Guid> _raceIds   = new();
    private List<Guid>               _hairIds   = new();
    private List<Guid>               _eyeIds    = new();
    private List<Guid>               _stateIds  = new();
    private List<Guid>               _suffixIds = new();

    // ── Seed state ───────────────────────────────────────────────────────────
    private bool    _seeding         = false;
    private bool    _seedingMni      = false;
    private bool    _seedingStates   = false;
    private bool    _seedingSuffixes = false;
    private bool    _seedingCharges  = false;
    private string? _mniSeedResult;
    private string? _stateSeedResult;
    private string? _suffixSeedResult;
    private string? _chargesSeedResult;

    // ── Generate state ───────────────────────────────────────────────────────
    private int     _generateCount   = 50;
    private bool    _generating      = false;
    private int     _generatedCount  = 0;
    private int     _generateErrors  = 0;
    private string? _generateResult;
    private bool    _canGenerate     = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPicklistCountsAsync();
        _hasMapsApiKey = !string.IsNullOrWhiteSpace(await GoogleMapsConfig.GetApiKeyAsync());
    }

    private async Task LoadPicklistCountsAsync()
    {
        var sexItems    = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.Sex,      activeOnly: false);
        var raceItems   = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.Race,     activeOnly: false);
        var hairItems   = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.HairColor, activeOnly: false);
        var eyeItems    = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.EyeColor,  activeOnly: false);
        var stateItems  = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.State,     activeOnly: false);
        var suffixItems = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.Suffix,    activeOnly: false);
        var dirItems    = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.Direction,  activeOnly: false);
        var stTypeItems = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.StreetType, activeOnly: false);
        var countryItems = await PicklistService.GetItemsAsync(Modules.Records.Domain.Common.PicklistTypes.Country,  activeOnly: false);

        _sexCount    = sexItems.Count;
        _raceCount   = raceItems.Count;
        _hairCount   = hairItems.Count;
        _eyeCount    = eyeItems.Count;
        _stateCount      = stateItems.Count;
        _suffixCount     = suffixItems.Count;
        _chargeCount     = await ChargeService.CountAsync(includeInactive: true);
        _directionCount  = dirItems.Count;
        _streetTypeCount = stTypeItems.Count;
        _countryCount    = countryItems.Count;

        _sexIds    = sexItems.ToDictionary(x => x.Value, x => x.Id);
        _raceIds   = raceItems.ToDictionary(x => x.Value, x => x.Id);
        _hairIds   = hairItems.Select(x => x.Id).ToList();
        _eyeIds    = eyeItems.Select(x => x.Id).ToList();
        _stateIds  = stateItems.Select(x => x.Id).ToList();
        _suffixIds = suffixItems.Select(x => x.Id).ToList();

        _canGenerate = _sexCount > 0 && _raceCount > 0 && _hairCount > 0 && _eyeCount > 0 && _stateCount > 0;
    }

    private async Task SeedChargesAsync()
    {
        _seeding = _seedingCharges = true;
        _chargesSeedResult = null;

        try
        {
            var path = Path.GetFullPath(Path.Combine(HostEnvironment.ContentRootPath, "..", "Documents", "charges.json"));
            if (!File.Exists(path))
                throw new InvalidOperationException($"Could not find charge seed file at '{path}'.");

            var json = await File.ReadAllTextAsync(path);
            var result = await ChargeService.SeedFromJsonAsync(json);
            _chargesSeedResult = $"✅ Inserted {result.Inserted}, updated {result.Updated}.";
            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _chargesSeedResult = $"❌ {ex.Message}";
        }
        finally
        {
            _seedingCharges = false;
            _seeding = false;
        }
    }

    // ── Seed MNI Picklists ───────────────────────────────────────────────────

    private async Task SeedMniPicklistsAsync()
    {
        _seeding = _seedingMni = true;
        _mniSeedResult = null;
        int inserted = 0;

        try
        {
            inserted += await SeedPicklistAsync(
                Modules.Records.Domain.Common.PicklistTypes.Sex,
                FakeNameData.SexDefaults.Select(d => (d.Value, d.Label, d.SortOrder)).ToArray());

            inserted += await SeedPicklistAsync(
                Modules.Records.Domain.Common.PicklistTypes.Race,
                FakeNameData.RaceDefaults.Select(d => (d.Value, d.Label, d.SortOrder)).ToArray());

            inserted += await SeedPicklistAsync(
                Modules.Records.Domain.Common.PicklistTypes.HairColor,
                FakeNameData.HairColorDefaults.Select(d => (d.Value, d.Label, d.SortOrder)).ToArray());

            inserted += await SeedPicklistAsync(
                Modules.Records.Domain.Common.PicklistTypes.EyeColor,
                FakeNameData.EyeColorDefaults.Select(d => (d.Value, d.Label, d.SortOrder)).ToArray());

            _mniSeedResult = $"✅ Done — {inserted} new item(s) inserted.";
            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _mniSeedResult = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _seeding = _seedingMni = false;
        }
    }

    // ── Seed DL States ───────────────────────────────────────────────────────

    private async Task SeedDlStatesAsync()
    {
        _seeding = _seedingStates = true;
        _stateSeedResult = null;

        try
        {
            var existing = await PicklistService.GetItemsAsync(
                Modules.Records.Domain.Common.PicklistTypes.State, activeOnly: false);
            var existingValues = existing.Select(x => x.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);

            int inserted = 0;
            int sort = existing.Count + 1;
            foreach (var (abbr, name) in FakeNameData.States)
            {
                if (existingValues.Contains(abbr)) continue;
                await PicklistService.CreateItemAsync(
                    Modules.Records.Domain.Common.PicklistTypes.State, abbr, name, sort++);
                inserted++;
            }

            _stateSeedResult = $"✅ Done — {inserted} new state(s) inserted.";
            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _stateSeedResult = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _seeding = _seedingStates = false;
        }
    }

    // ── Seed Suffixes ────────────────────────────────────────────────────────

    private async Task SeedSuffixesAsync()
    {
        _seeding = _seedingSuffixes = true;
        _suffixSeedResult = null;

        try
        {
            int inserted = await SeedPicklistAsync(
                Modules.Records.Domain.Common.PicklistTypes.Suffix,
                FakeNameData.SuffixDefaults.Select(d => (d.Value, d.Label, d.SortOrder)).ToArray());

            _suffixSeedResult = $"✅ Done — {inserted} new suffix(es) inserted.";
            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _suffixSeedResult = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _seeding = _seedingSuffixes = false;
        }
    }

    // ── Seed helper ──────────────────────────────────────────────────────────

    private async Task<int> SeedPicklistAsync(string picklistType, (string Value, string Label, int SortOrder)[] defaults)
    {
        var existing = await PicklistService.GetItemsAsync(picklistType, activeOnly: false);
        var existingByValue = existing.ToDictionary(x => x.Value, x => x, StringComparer.OrdinalIgnoreCase);

        int inserted = 0;
        foreach (var (value, label, sort) in defaults)
        {
            if (existingByValue.TryGetValue(value, out var existing_item))
            {
                if (existing_item.Label != label || existing_item.SortOrder != sort)
                    await PicklistService.UpdateItemAsync(existing_item.Id, label, sort);
            }
            else
            {
                await PicklistService.CreateItemAsync(picklistType, value, label, sort);
                inserted++;
            }
        }
        return inserted;
    }

    // ── Generate Names ───────────────────────────────────────────────────────

    private async Task GenerateNamesAsync()
    {
        _generating     = true;
        _generatedCount = 0;
        _generateErrors = 0;
        _generateResult = null;

        var count = Math.Clamp(_generateCount, 1, 500);

        for (int i = 0; i < count; i++)
        {
            try
            {
                await CreateOneFakeNameAsync();
            }
            catch
            {
                _generateErrors++;
            }
            _generatedCount++;

            // Yield to UI every 10 records to update the progress bar
            if (_generatedCount % 10 == 0)
                StateHasChanged();
        }

        _generating     = false;
        _generateResult = _generateErrors == 0
            ? $"✅ Successfully created {_generatedCount} fake Name records."
            : $"⚠️ Created {_generatedCount - _generateErrors} records; {_generateErrors} error(s).";

        StateHasChanged();
    }

    private async Task CreateOneFakeNameAsync()
    {
        var sexValue = FakeNameGenerator.GenerateSex();
        var raceValue = FakeNameGenerator.GenerateRaceValue();
        var dob      = FakeNameGenerator.GenerateDob();
        var age      = FakeNameGenerator.GetAge(dob);

        _sexIds.TryGetValue(sexValue,  out var sexId);
        _raceIds.TryGetValue(raceValue, out var raceId);

        var hairId  = FakeNameGenerator.PickRandom<Guid>(_hairIds);
        var eyeId   = FakeNameGenerator.PickRandom<Guid>(_eyeIds);
        var height  = FakeNameGenerator.GenerateHeight(sexValue);
        var weight  = FakeNameGenerator.GenerateWeight(sexValue);

        string? dlNumber    = null;
        Guid?   dlStateId   = null;
        if (age >= 17 && _stateIds.Count > 0)
        {
            dlNumber  = FakeNameGenerator.GenerateDlNumber();
            dlStateId = FakeNameGenerator.PickRandom<Guid>(_stateIds);
        }

        await NameService.CreateAsync(
            nameType:              "Person",
            lastOrBusinessName:    FakeNameGenerator.PickLastName(),
            firstName:             FakeNameGenerator.PickFirstName(sexValue),
            middleName:            FakeNameGenerator.PickMiddleName(),
            sexId:                 sexId == Guid.Empty ? null : sexId,
            raceId:                raceId == Guid.Empty ? null : raceId,
            dateOfBirth:           dob,
            driversLicenseNumber:  dlNumber,
            driversLicenseStateId: dlStateId,
            heightInches:          height,
            weightLbs:             weight,
            hairColorId:           hairId,
            eyeColorId:            eyeId);
    }

    // ── Location generation state ────────────────────────────────────────────
    private bool         _hasMapsApiKey       = false;
    private int          _directionCount      = 0;
    private int          _streetTypeCount     = 0;
    private int          _countryCount        = 0;
    private string?      _locKeyword;
    private int          _locCount            = 10;
    private bool         _generatingLocations = false;
    private int          _locGeneratedCount   = 0;
    private int          _locErrors           = 0;
    private string?      _locResult;
    private List<string> _locErrorDetails     = new();

    // ── Arrest generation state ──────────────────────────────────────────────
    private int _arrestCount = 25;
    private string _arrestFromInput = DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-ddTHH:mm");
    private string _arrestToInput = DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm");
    private TestDataRecordLinkStrategy _arrestNameStrategy = TestDataRecordLinkStrategy.RecentlyCreatedOrCreateNew;
    private TestDataRecordLinkStrategy _arrestLocationStrategy = TestDataRecordLinkStrategy.RecentlyCreatedOrCreateNew;
    private int _arrestNameMaxUses = 3;
    private int _arrestLocationMaxUses = 3;
    private string? _arrestLocationKeyword;
    private bool _generatingArrests = false;
    private int _arrestGeneratedCount = 0;
    private int _arrestErrors = 0;
    private string? _arrestResult;
    private string? _arrestSummary;
    private List<string> _arrestErrorDetails = new();

    // ── Generate Locations ───────────────────────────────────────────────────

    private async Task GenerateLocationsAsync()
    {
        _generatingLocations = true;
        _locGeneratedCount   = 0;
        _locErrors           = 0;
        _locResult           = null;
        _locErrorDetails.Clear();

        try
        {
            var apiKey = await GoogleMapsConfig.GetApiKeyAsync();
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                _locResult = "❌ No Google Maps API key configured.";
                return;
            }

            var count = Math.Clamp(_locCount, 1, 60);
            _locCount = count;

            var result = await Sender.Send(
                new Modules.Records.Application.Locations.Commands.GenerateTestLocations
                    .GenerateTestLocationsCommand(_locKeyword!, count, apiKey));

            _locGeneratedCount = result.Created + result.Failed;
            _locErrors         = result.Failed;
            _locErrorDetails   = result.Errors.ToList();

            _locResult = result.Failed == 0
                ? $"✅ Successfully created {result.Created} location record(s)."
                : $"⚠️ Created {result.Created} record(s); {result.Failed} error(s).";

            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _locResult = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _generatingLocations = false;
            StateHasChanged();
        }
    }

    private async Task GenerateArrestsAsync()
    {
        _generatingArrests = true;
        _arrestGeneratedCount = 0;
        _arrestErrors = 0;
        _arrestResult = null;
        _arrestSummary = null;
        _arrestErrorDetails.Clear();

        try
        {
            var count = Math.Clamp(_arrestCount, 1, 250);
            _arrestCount = count;
            _arrestNameMaxUses = Math.Clamp(_arrestNameMaxUses, 1, 250);
            _arrestLocationMaxUses = Math.Clamp(_arrestLocationMaxUses, 1, 250);

            if (!TryParseArrestWindow(out var arrestedFrom, out var arrestedTo, out var windowError))
            {
                _arrestResult = $"❌ {windowError}";
                return;
            }

            string? apiKey = null;

            if (ArrestLocationKeywordRequired)
            {
                if (string.IsNullOrWhiteSpace(_arrestLocationKeyword))
                {
                    _arrestResult = "❌ Enter a location search keyword before generating arrests that create new locations.";
                    return;
                }

                apiKey = await GoogleMapsConfig.GetApiKeyAsync();
                if (string.IsNullOrWhiteSpace(apiKey))
                {
                    _arrestResult = "❌ No Google Maps API key configured.";
                    return;
                }
            }

            var result = await Sender.Send(new GenerateTestArrestsCommand(
                count,
                arrestedFrom,
                arrestedTo,
                _arrestNameStrategy,
                _arrestLocationStrategy,
                _arrestNameMaxUses,
                _arrestLocationMaxUses,
                _arrestLocationKeyword,
                apiKey));

            _arrestGeneratedCount = result.Created + result.Failed;
            _arrestErrors = result.Failed;
            _arrestErrorDetails = result.Errors.ToList();
            _arrestSummary = BuildArrestSummary(result);

            _arrestResult = result.Failed == 0
                ? $"✅ Successfully created {result.Created} arrest record(s)."
                : $"⚠️ Created {result.Created} arrest record(s); {result.Failed} error(s).";

            await LoadPicklistCountsAsync();
        }
        catch (Exception ex)
        {
            _arrestResult = $"❌ Error: {ex.Message}";
        }
        finally
        {
            _generatingArrests = false;
            StateHasChanged();
        }
    }

    private static string BuildArrestSummary(GenerateTestArrestsResult result)
    {
        var nameSummary = $"Names — created {result.NamesCreated}, reused existing {result.NamesReusedFromExisting}, reused current-run {result.NamesReusedFromCurrentRun}";
        var locationSummary = $"Locations — created {result.LocationsCreated}, reused existing {result.LocationsReusedFromExisting}, reused current-run {result.LocationsReusedFromCurrentRun} across arrest and address links";
        return $"{nameSummary}. {locationSummary}.";
    }

    private bool ArrestLocationKeywordRequired => _arrestLocationStrategy != TestDataRecordLinkStrategy.Existing;

    private void OnArrestFromChanged(ChangeEventArgs args)
        => _arrestFromInput = args.Value?.ToString() ?? string.Empty;

    private void OnArrestToChanged(ChangeEventArgs args)
        => _arrestToInput = args.Value?.ToString() ?? string.Empty;

    private bool TryParseArrestWindow(out DateTime arrestedFrom, out DateTime arrestedTo, out string error)
    {
        if (!DateTime.TryParse(_arrestFromInput, out arrestedFrom))
        {
            arrestedTo = default;
            error = "Enter a valid 'Arrested From' date and time.";
            return false;
        }

        if (!DateTime.TryParse(_arrestToInput, out arrestedTo))
        {
            error = "Enter a valid 'Arrested To' date and time.";
            return false;
        }

        if (arrestedTo < arrestedFrom)
        {
            error = "'Arrested To' must be on or after 'Arrested From'.";
            return false;
        }

        error = string.Empty;
        return true;
    }
}

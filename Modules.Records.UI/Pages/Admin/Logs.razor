    <div>
        <h2 class="page-header-title"><i class="bi bi-journal-text"></i> Admin Logs</h2>
        <div class="page-header-sub">Jurisdiction-scoped audit and activity history</div>
    </div>
</div>

<AuditLogViewer IsSuperView="false" />

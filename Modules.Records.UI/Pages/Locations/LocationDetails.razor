@page "/locations/{RecordNumber:long}"
@implements IAsyncDisposable
@inject ILocationService LocationService
@inject IPicklistService PicklistService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject IGoogleMapsConfigService GoogleMapsConfig
@inject IAgencyConfigurationService AgencyConfig
@inject IGoogleMapsInterop MapsInterop
@inject IMediator Mediator
@using MediatR
@using Microsoft.JSInterop
@using Modules.Records.Application.DTOs
@using Modules.Records.Application.Picklists.Queries.GetPicklistItems
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Helpers
@using Modules.Records.UI.Interop
@using Modules.Records.UI.Services

<PageTitle>@(_location is null ? "Location Details" : $"📍 {_location.RecordNumber} - {FormatAddressTitle(_location)}")</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_location is not null)
{
    <div style="display:contents" @onchange="OnEditActivity">
    <NavigationLock ConfirmExternalNavigation="@HasPendingChanges"
                    OnBeforeInternalNavigation="HandleInternalNavigation" />
    <nav aria-label="breadcrumb" class="record-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/locations">Locations</a></li>
            <li class="breadcrumb-item active">@FormatAddressTitle(_location)</li>
        </ol>
    </nav>

    <div class="page-header record-page-header">
        <div>
            <h1 class="page-header-title"><i class="bi bi-geo-alt-fill"></i> Location Record</h1>
            <div class="page-header-sub">@FormatFullAddress(_location)</div>
        </div>
        <div class="d-flex gap-2 align-items-center record-header-meta">
            <LockBadge IsLocked="@_location.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    <RecordDetailsTabs DetailsUrl="@DetailsTabUrl"
                       RelationshipsUrl="@RelationshipsTabUrl"
                       ActiveTab="Details" />

    <StatusMessage Kind="error" Message="@_actionError" OnDismiss="() => _actionError = null" />
    <StatusMessage Kind="success" Message="@_saveSuccessMessage" OnDismiss="() => _saveSuccessMessage = null" />

    <!-- Modify Mode Bar -->
    <div class="record-toolbar mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2 record-mode-banner">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <div class="record-mode-actions">
                    <BusyButton Class="btn btn-sm btn-primary" OnClick="SaveRecordAsync" BusyText="Saving…">
                        <i class="bi bi-floppy-fill me-1"></i>Save
                    </BusyButton>
                    <button class="btn btn-sm btn-outline-dark" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release</button>
                </div>
            </div>
        }
        else if (_location.IsLocked && _location.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify</button>
        }
    </div>

    <!-- Action Bar (modify mode only) -->
    @if (_modifyMode)
    {
        <div class="action-bar record-action-bar mb-4 d-flex flex-wrap gap-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Location"
                   Message="Are you sure you want to delete this location record?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Street Address Card -->
    <div class="card record-content-card mb-3">
        <div class="card-body">
            <h6 class="card-title">Street Address</h6>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-sm-6 col-md-2">
                        <FormField Label="Street #" For="loc-streetnumber">
                            <InputText id="loc-streetnumber" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.StreetNumber" placeholder="e.g. 123" />
                            <ValidationMessage For="() => _editVm.StreetNumber" />
                        </FormField>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="@LabelClass">Pre-Direction</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Direction" @bind-Value="_editPreDirectionId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_preDirectionLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <FormField Label="Street Name" For="loc-streetname" Required="true">
                            <InputText id="loc-streetname" maxlength="200" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.StreetAddress" placeholder="e.g. Main" />
                            <ValidationMessage For="() => _editVm.StreetAddress" />
                        </FormField>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="@LabelClass">Street Type</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.StreetType" @bind-Value="_editStreetTypeId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_streetTypeLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="@LabelClass">Post-Direction</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Direction" @bind-Value="_editPostDirectionId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_postDirectionLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <FormField Label="Apt / Suite" For="loc-aptsuite">
                            <InputText id="loc-aptsuite" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.AptSuite" placeholder="Apt, Suite…" />
                            <ValidationMessage For="() => _editVm.AptSuite" />
                        </FormField>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- City / State / ZIP Card -->
    <div class="card record-content-card mb-3">
        <div class="card-body">
            <h6 class="card-title">City / State / ZIP</h6>
            <EditForm EditContext="_editContext">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4">
                        <FormField Label="City" For="loc-city" Required="true">
                            <InputText id="loc-city" maxlength="100" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.City" placeholder="City" />
                            <ValidationMessage For="() => _editVm.City" />
                        </FormField>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="@LabelClass">State</label>
                        @if (_modifyMode)
                        {
                            <StateSelect @bind-Value="_editStateId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_stateLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <FormField Label="ZIP" For="loc-zip">
                            <InputText id="loc-zip" maxlength="10" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.Zip" placeholder="ZIP" />
                            <ValidationMessage For="() => _editVm.Zip" />
                        </FormField>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <label class="@LabelClass">Country</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Country" @bind-Value="_editCountryId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_countryLabel ?? "—")</p>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Additional Info Card -->
    <div class="card record-content-card mb-3">
        <div class="card-body">
            <h6 class="card-title">Additional Info</h6>
            <EditForm EditContext="_editContext">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4">
                        <FormField Label="Common Place Name" For="loc-commonplace">
                            <InputText id="loc-commonplace" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.CommonPlaceName" placeholder="Park, school, business…" />
                            <ValidationMessage For="() => _editVm.CommonPlaceName" />
                        </FormField>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <FormField Label="GPS Coordinates" For="loc-coordinates">
                            <InputText id="loc-coordinates" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.Coordinates" placeholder="lat,lng" />
                            <ValidationMessage For="() => _editVm.Coordinates" />
                        </FormField>
                    </div>
                    <div class="col-12">
                        <FormField Label="Full Address" For="loc-address" Help="(auto-filled from map)">
                            <InputText id="loc-address" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.Address" placeholder="e.g. 3001 E Plano Pkwy #400, Plano, TX 75074, USA" />
                            <ValidationMessage For="() => _editVm.Address" />
                        </FormField>
                    </div>
                    <div class="col-12">
                        <FormField Label="Comments" For="loc-comments">
                            <InputTextArea id="loc-comments" readonly="@(!_modifyMode)"
                                           class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                           @bind-Value="_editVm.Comments" rows="3" />
                            <ValidationMessage For="() => _editVm.Comments" />
                        </FormField>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @* Google Maps Card *@
    @if (_mapsAvailable)
    {
        @if (_modifyMode)
        {
            <div class="card record-content-card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-map me-1"></i>Pick from Map</strong>
                    <button type="button" class="btn btn-sm @(_mapOpen ? "btn-outline-secondary" : "btn-outline-primary")"
                            @onclick="ToggleMapAsync">
                        @if (_mapLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi @(_mapOpen ? "bi-x-lg" : "bi-pin-map") me-1"></i>
                        @(_mapOpen ? "Close Map" : "Open Map")
                    </button>
                </div>
                @if (_mapOpen)
                {
                    <div class="card-body pb-2">
                        <p class="text-muted small mb-2">Search for an address or click the map to auto-fill the form fields above.</p>
                        <input id="map-search-input-details" type="text" class="form-control mb-2" placeholder="Search address…" autocomplete="off" />
                        <div id="location-details-map" style="height:350px; border-radius:4px;"></div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_location.Coordinates))
        {
            <div class="card record-content-card mb-3">
                <div class="card-header"><strong><i class="bi bi-map me-1"></i>Map</strong></div>
                <div class="card-body p-0">
                    <div id="location-static-map" style="height:300px; border-radius:0 0 4px 4px;"></div>
                </div>
            </div>
        }
    }

    <AuditInfoSection CreatedAt="@_location.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_location.ModifiedBy.HasValue ? _location.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />

    @if (_modifyMode)
    {
        <div class="record-save-row mb-4">
            <BusyButton Class="btn btn-sm btn-primary" OnClick="SaveRecordAsync" BusyText="Saving…">
                <i class="bi bi-floppy-fill me-1"></i>Save
            </BusyButton>
        </div>
    }
    </div>
}

@code {
    [Parameter] public long RecordNumber { get; set; }

    private string DetailsTabUrl => $"/locations/{RecordNumber}";
    private string RelationshipsTabUrl => $"/locations/{RecordNumber}/relationships";

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    private Guid _locationId;
    private LocationDto? _location;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private TimeSpan _lockTimeout = TimeSpan.FromSeconds(ConfigurationKeys.DefaultLockTimeoutSeconds);
    private DateTime _lastServerRenewUtc;
    private bool _renewing;
    private TimeSpan RenewInterval => TimeSpan.FromSeconds(Math.Max(5, _lockTimeout.TotalSeconds / 3));

    // Edit fields
    private readonly EditLocationViewModel _editVm = new();
    private EditContext _editContext = null!;
    private string? _pendingNavUri;
    private Guid?   _editPreDirectionId;
    private Guid?   _editStreetTypeId;
    private Guid?   _editPostDirectionId;
    private Guid?   _editStateId;
    private Guid?   _editCountryId;

    // Read-only picklist labels
    private string? _preDirectionLabel;
    private string? _streetTypeLabel;
    private string? _postDirectionLabel;
    private string? _stateLabel;
    private string? _countryLabel;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;

    // Google Maps state
    private bool _mapsAvailable;
    private bool _mapOpen;
    private bool _mapLoading;
    private string? _apiKey;
    private bool _staticMapRendered;
    private DotNetObjectReference<LocationDetails>? _dotnetRef;
    private IReadOnlyList<PicklistItemDto>? _directionItems;
    private IReadOnlyList<PicklistItemDto>? _streetTypeItems;
    private IReadOnlyList<PicklistItemDto>? _stateItems;
    private IReadOnlyList<PicklistItemDto>? _countryItems;

    private string LabelClass => _modifyMode
        ? "form-label mb-1"
        : "form-label mb-0 small text-muted d-block";

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_editVm);
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();
        await LoadLockTimeoutAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;

        _apiKey = await GoogleMapsConfig.GetApiKeyAsync();
        _mapsAvailable = !string.IsNullOrWhiteSpace(_apiKey);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Show static map once after initial render (read-only mode, coordinates present)
        if (_mapsAvailable && !_modifyMode && !_staticMapRendered
            && !string.IsNullOrWhiteSpace(_location?.Coordinates))
        {
            _staticMapRendered = true;
            await TryShowStaticMapAsync();
        }
    }

    private async Task TryShowStaticMapAsync()
    {
        if (_location?.Coordinates is null) return;
        var parts = _location.Coordinates.Split(',');
        if (parts.Length == 2
            && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat)
            && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
        {
            try
            {
                await MapsInterop.LoadApiAsync(_apiKey!);
                await MapsInterop.InitStaticMapAsync("location-static-map", lat, lng);
            }
            catch { /* non-critical — map just won't show */ }
        }
    }

    private async Task ToggleMapAsync()
    {
        if (_mapOpen)
            await CloseMapAsync();
        else
            await OpenMapAsync();
    }

    private async Task OpenMapAsync()
    {
        _mapLoading = true;
        _mapOpen = true;
        StateHasChanged();
        try
        {
            await MapsInterop.LoadApiAsync(_apiKey!);
            var (lat, lng) = await GetStartingCoordinatesAsync();
            _dotnetRef ??= DotNetObjectReference.Create(this);
            await Task.Delay(50);
            await MapsInterop.InitPickerAsync("location-details-map", "map-search-input-details", lat, lng, _dotnetRef);
        }
        catch (Exception ex)
        {
            _actionError = $"Map initialisation failed: {ex.Message}";
            _mapOpen = false;
        }
        finally
        {
            _mapLoading = false;
        }
    }

    private async Task CloseMapAsync()
    {
        await MapsInterop.DestroyAsync("location-details-map");
        _mapOpen = false;
    }

    private async Task<(double lat, double lng)> GetStartingCoordinatesAsync()
    {
        // If record already has coordinates, centre there
        if (!string.IsNullOrWhiteSpace(_location?.Coordinates))
        {
            var parts = _location.Coordinates.Split(',');
            if (parts.Length == 2
                && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rlat)
                && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var rlng))
                return (rlat, rlng);
        }

        const double defaultLat = 39.8283;
        const double defaultLng = -98.5795;
        try
        {
            var cfg = await AgencyConfig.GetAsync(ConfigurationKeys.MapStartCoordinates);
            if (cfg?.Value is not null)
            {
                var parts = cfg.Value.Split(',');
                if (parts.Length == 2
                    && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat)
                    && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
                    return (lat, lng);
            }
        }
        catch { /* fall through */ }
        return (defaultLat, defaultLng);
    }

    [JSInvokable]
    public async Task OnPlaceSelected(LocationCreate.PlaceSelectedPayload payload)
    {
        _editVm.StreetNumber = payload.StreetNumber ?? _editVm.StreetNumber;
        _editVm.AptSuite     = payload.AptSuite     ?? _editVm.AptSuite;
        _editVm.City         = payload.City         ?? _editVm.City;
        _editVm.Zip          = payload.Zip          ?? _editVm.Zip;
        _editVm.Address      = payload.FormattedAddress ?? _editVm.Address;

        if (payload.Lat.HasValue && payload.Lng.HasValue)
            _editVm.Coordinates = $"{payload.Lat.Value},{payload.Lng.Value}";

        // Parse route into pre-direction, street name, street type
        if (!string.IsNullOrWhiteSpace(payload.Route))
        {
            _directionItems  ??= await Mediator.Send(new GetPicklistItemsQuery(PicklistTypes.Direction,  ActiveOnly: true));
            _streetTypeItems ??= await Mediator.Send(new GetPicklistItemsQuery(PicklistTypes.StreetType, ActiveOnly: true));

            var (preId, name, typeId) = LocationParseHelper.ParseRoute(payload.Route, _directionItems, _streetTypeItems);
            if (!string.IsNullOrWhiteSpace(name))  _editVm.StreetAddress = name;
            if (preId.HasValue)                    _editPreDirectionId  = preId;
            if (typeId.HasValue)                   _editStreetTypeId    = typeId;
        }

        if (!string.IsNullOrWhiteSpace(payload.State))
        {
            _stateItems ??= await Mediator.Send(new GetPicklistItemsQuery(PicklistTypes.State, ActiveOnly: true));
            var match = _stateItems.FirstOrDefault(i => string.Equals(i.Value, payload.State, StringComparison.OrdinalIgnoreCase));
            if (match is not null) _editStateId = match.Id;
        }

        if (!string.IsNullOrWhiteSpace(payload.Country))
        {
            _countryItems ??= await Mediator.Send(new GetPicklistItemsQuery(PicklistTypes.Country, ActiveOnly: true));
            var match = _countryItems.FirstOrDefault(i => string.Equals(i.Value, payload.Country, StringComparison.OrdinalIgnoreCase));
            if (match is not null) _editCountryId = match.Id;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveRecordAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_location is not null && _location.IsLocked && _location.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            LoadEditFields();
            StartLockTimer();
        }
    }

    private void LoadEditFields()
    {
        if (_location is null) return;
        _editVm.StreetAddress   = _location.StreetAddress;
        _editVm.City            = _location.City;
        _editVm.StreetNumber    = _location.StreetNumber;
        _editPreDirectionId  = _location.PreDirectionId;
        _editStreetTypeId    = _location.StreetTypeId;
        _editPostDirectionId = _location.PostDirectionId;
        _editStateId         = _location.StateId;
        _editCountryId       = _location.CountryId;
        _editVm.Zip             = _location.Zip;
        _editVm.AptSuite        = _location.AptSuite;
        _editVm.Coordinates     = _location.Coordinates;
        _editVm.CommonPlaceName = _location.CommonPlaceName;
        _editVm.Comments        = _location.Comments;
        _editVm.Address         = _location.Address;
        _editSnapshot = ComputeEditSnapshot();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editVm.StreetAddress, _editVm.City, _editVm.StreetNumber,
            _editPreDirectionId, _editStreetTypeId, _editPostDirectionId,
            _editStateId, _editCountryId, _editVm.Zip, _editVm.AptSuite,
            _editVm.Coordinates, _editVm.CommonPlaceName, _editVm.Comments, _editVm.Address);

    private bool HasPendingChanges => _modifyMode && _editSnapshot != ComputeEditSnapshot();

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNavUri = null;
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/locations/create");
            }
        }
        else
        {
            Nav.NavigateTo("/locations/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
        _pendingNavUri = null;
    }

    // Where to go once the unsaved-changes prompt is resolved: an intercepted
    // navigation target if set, otherwise the create page for "Save & New".
    private string? PendingReleaseTarget =>
        _pendingNavUri ?? (_pendingNewRecord ? "/locations/create" : null);

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var target = PendingReleaseTarget;
        _pendingNewRecord = false;
        _pendingNavUri = null;
        if (await TrySaveAsync())
        {
            await ExitModifyModeAsync();
            if (target is not null) Nav.NavigateTo(target);
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var target = PendingReleaseTarget;
        _pendingNewRecord = false;
        _pendingNavUri = null;
        await ExitModifyModeAsync();
        if (target is not null) Nav.NavigateTo(target);
    }

    // Intercepts in-app navigation (sidebar links, back) while edits are
    // pending: cancels the navigation and shows the unsaved-changes prompt,
    // remembering where the user was trying to go. The browser-level prompt
    // (tab close / refresh / external links) is handled declaratively by
    // NavigationLock's ConfirmExternalNavigation.
    private void HandleInternalNavigation(LocationChangingContext context)
    {
        if (!HasPendingChanges) return;
        context.PreventNavigation();
        _pendingNewRecord = false;
        _pendingNavUri = context.TargetLocation;
        _showReleaseConfirm = true;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _location = await LocationService.GetByRecordNumberAsync(RecordNumber);
            if (_location is null) { _error = "Location not found."; return; }
            _locationId = _location.Id;

            if (!_modifyMode)
                LoadEditFields();

            _createdByName  = await UserLookupService.GetDisplayNameAsync(_location.CreatedBy);
            _modifiedByName = _location.ModifiedBy.HasValue
                ? await UserLookupService.GetDisplayNameAsync(_location.ModifiedBy.Value)
                : null;
            _lockedByName = _location.IsLocked && _location.LockedByUserId.HasValue
                ? await UserLookupService.GetDisplayNameAsync(_location.LockedByUserId.Value)
                : null;

            // Resolve picklist labels for read-only display
            var picklistIds = new List<Guid>();
            if (_location.PreDirectionId.HasValue)  picklistIds.Add(_location.PreDirectionId.Value);
            if (_location.StreetTypeId.HasValue)    picklistIds.Add(_location.StreetTypeId.Value);
            if (_location.PostDirectionId.HasValue) picklistIds.Add(_location.PostDirectionId.Value);
            if (_location.StateId.HasValue)         picklistIds.Add(_location.StateId.Value);
            if (_location.CountryId.HasValue)       picklistIds.Add(_location.CountryId.Value);

            if (picklistIds.Count > 0)
            {
                var labels = await PicklistService.GetItemsByIdsAsync(picklistIds);
                _preDirectionLabel  = _location.PreDirectionId.HasValue  ? labels.GetValueOrDefault(_location.PreDirectionId.Value)  : null;
                _streetTypeLabel    = _location.StreetTypeId.HasValue    ? labels.GetValueOrDefault(_location.StreetTypeId.Value)    : null;
                _postDirectionLabel = _location.PostDirectionId.HasValue ? labels.GetValueOrDefault(_location.PostDirectionId.Value) : null;
                _stateLabel         = _location.StateId.HasValue         ? labels.GetValueOrDefault(_location.StateId.Value)         : null;
                _countryLabel       = _location.CountryId.HasValue       ? labels.GetValueOrDefault(_location.CountryId.Value)       : null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await LocationService.AcquireLockAsync(_locationId);
            _modifyMode = true;
            _staticMapRendered = false; // will re-render static map when leaving modify mode
            LoadEditFields();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        if (_mapOpen)
            await CloseMapAsync();

        StopLockTimer();
        _modifyMode = false;
        try { await LocationService.ReleaseLockAsync(_locationId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private Task SaveRecordAsync() => TrySaveAsync();

    private async Task<bool> TrySaveAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;

        // Field-level client validation before the round-trip; invalid fields
        // show their error inline and the save is aborted.
        if (!_editContext.Validate())
            return false;

        try
        {
            await LocationService.UpdateDetailsAsync(
                _locationId,
                _editVm.StreetAddress,
                _editVm.City,
                _editVm.StreetNumber,
                _editPreDirectionId,
                _editStreetTypeId,
                _editPostDirectionId,
                _editStateId,
                _editCountryId,
                _editVm.Zip,
                _editVm.AptSuite,
                _editVm.Coordinates,
                _editVm.CommonPlaceName,
                _editVm.Comments,
                _editVm.Address);

            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            _saveSuccessMessage = "Record saved successfully.";
            return true;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            try { await LoadAsync(); } catch { _actionError += " (State may be out of sync — please refresh the page.)"; }
            return false;
        }
    }

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        _actionError = null;
        try
        {
            await LocationService.SoftDeleteAsync(_locationId);
            Nav.NavigateTo("/locations");
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)_lockTimeout.TotalSeconds;
        _lastServerRenewUtc = DateTime.UtcNow;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    // Called when a field commits (blur/change events bubble up to the page container).
    // Restarts the on-screen countdown immediately and renews the server-side lock on a
    // throttle, so an actively-editing user is never timed out while an idle one still is.
    private async Task OnEditActivity()
    {
        if (!_modifyMode) return;
        _lockSecondsRemaining = (int)_lockTimeout.TotalSeconds;
        var now = DateTime.UtcNow;
        if (_renewing || now - _lastServerRenewUtc < RenewInterval) return;
        _renewing = true;
        _lastServerRenewUtc = now;
        try { await LocationService.RenewLockAsync(_locationId); }
        catch { /* best-effort; the cleanup sweep honors the last successful renew */ }
        finally { _renewing = false; }
    }

    private async Task LoadLockTimeoutAsync()
    {
        var cfg = await AgencyConfig.GetAsync(ConfigurationKeys.LockTimeoutSeconds);
        _lockTimeout = LockTimeout.FromConfigValue(cfg?.Value);
    }

    public async ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();

        if (_mapOpen)
            await MapsInterop.DestroyAsync("location-details-map");

        _dotnetRef?.Dispose();
        await MapsInterop.DisposeAsync();
    }

    private static string FormatAddressTitle(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber)) parts.Add(loc.StreetNumber);
        parts.Add(loc.StreetAddress);
        parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    private static string FormatFullAddress(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber)) parts.Add(loc.StreetNumber);
        parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City)) parts.Add($"{loc.City},");
        if (!string.IsNullOrWhiteSpace(loc.Zip)) parts.Add(loc.Zip);
        return string.Join(" ", parts);
    }
}

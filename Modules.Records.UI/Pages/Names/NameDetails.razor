@page "/names/{RecordNumber:long}"
@implements IAsyncDisposable
@inject INameService NameService
@inject IPicklistService PicklistService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject ILocationService LocationService
@using Modules.Records.Application.DTOs
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Services

<PageTitle>@(_name is null ? "Name Details" : _name.NameType == NameTypes.Person ? $"👤 {_name.RecordNumber} - {_name.LastOrBusinessName}{(string.IsNullOrWhiteSpace(_name.FirstName) ? "" : ", " + _name.FirstName)}" : $"🏢 {_name.RecordNumber} - {_name.LastOrBusinessName}")</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_name is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/names">Names</a></li>
            <li class="breadcrumb-item active">@(_name.NameType == NameTypes.Person ? $"{_name.LastOrBusinessName}, {_name.FirstName}" : _name.LastOrBusinessName)</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2 class="page-header-title"><i class="bi bi-people-fill"></i> @(_name.NameType == NameTypes.Person ? "Person Record" : "Business Record")</h2>
            <div class="page-header-sub">
                @if (_name.NameType == NameTypes.Person)
                {
                    @($"{_name.LastOrBusinessName}{(string.IsNullOrEmpty(_name.FirstName) ? "" : ", " + _name.FirstName)}{(string.IsNullOrEmpty(_name.MiddleName) ? "" : " " + _name.MiddleName)}{(!string.IsNullOrEmpty(_suffixLabel) ? " " + _suffixLabel : "")}")
                    @if (ComputeAge(_name.DateOfBirth) is int age)
                    {
                        <span class="text-muted fs-5 fw-normal ms-2">(Age @age)</span>
                    }
                    @if (_name.DeceasedDate.HasValue)
                    {
                        <span class="badge bg-dark ms-2 align-middle" style="font-size: 0.55rem; letter-spacing: 0.1em; vertical-align: middle">DECEASED</span>
                    }
                }
                else
                {
                    @_name.LastOrBusinessName
                }
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge @(_name.NameType == NameTypes.Person ? "bg-primary" : "bg-secondary")">@_name.NameType</span>
            <LockBadge IsLocked="@_name.IsLocked" LockedByName="@_lockedByName" />
            <a href="/names/@RecordNumber/print" target="_blank"
               class="btn btn-outline-secondary btn-sm" title="Print / Save as PDF">
                <i class="bi bi-printer-fill me-1"></i>Print
            </a>
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <button class="btn btn-sm btn-outline-dark ms-auto" title="Release Record (Esc)" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release<ShortcutHint Action="release" /></button>
            </div>
        }
        else if (_name.IsLocked && _name.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" title="Modify (F2)" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify<ShortcutHint Action="modify" /></button>
        }
    </div>

    <!-- Action Bar (modify mode only) -->
    @if (_modifyMode)
    {
        <div class="action-bar mb-4 d-flex flex-wrap gap-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Name"
                   Message="Are you sure you want to delete this name record?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Name Type (protected field — requires switch button in modify mode) -->
    <div class="d-flex align-items-center gap-3 mb-3">
        <div>
            <span class="text-muted small">Name Type</span>
            <span class="ms-2 badge @(_editNameType == NameTypes.Person ? "bg-primary" : "bg-success") fs-6">
                @(_editNameType == NameTypes.Person ? "Person" : "Business")
            </span>
        </div>
        @if (_modifyMode)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSwitchTypeConfirm = true"
                    title="@(_editNameType == NameTypes.Person ? "Switch this record to a Business name" : "Switch this record to a Person name")">
                <i class="bi bi-arrow-left-right me-1"></i>
                @(_editNameType == NameTypes.Person ? "Switch to Business" : "Switch to Person")
            </button>
        }
    </div>

    @if (_showSwitchTypeConfirm)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                Switch this record to <strong>@(_editNameType == NameTypes.Person ? "Business" : "Person")</strong>?
                Person-specific and Business-specific fields will be retained but may not apply.
                This change will take effect when you save.
            </div>
            <div class="ms-auto d-flex gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-warning" @onclick="ConfirmSwitchNameType">Switch</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSwitchTypeConfirm = false">Cancel</button>
            </div>
        </div>
    }

    <!-- Identity Fields -->
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Identity</h6>
            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <label class="@LabelClass">@(_editNameType == NameTypes.Person ? "Last Name" : "Business Name")</label>
                    <input type="text"
                           class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editLastOrBusinessName"
                           @bind:after="() => _editLastOrBusinessName = NameCaseConverter.ToNameCase(_editLastOrBusinessName) ?? string.Empty" />
                </div>
                @if (_editNameType == NameTypes.Person)
                {
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">First Name</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editFirstName"
                               @bind:after="() => _editFirstName = NameCaseConverter.ToNameCase(_editFirstName)"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Middle Name</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editMiddleName"
                               @bind:after="() => _editMiddleName = NameCaseConverter.ToNameCase(_editMiddleName)"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Suffix</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Suffix" @bind-Value="_editSuffixId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_suffixLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Place of Birth</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editPlaceOfBirth"
                               @bind:after="() => _editPlaceOfBirth = NameCaseConverter.ToNameCase(_editPlaceOfBirth)"
                               placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Deceased Date</label>
                        @if (_modifyMode)
                        {
                            <input type="date" class="form-control form-control-sm"
                                   value="@(_editDeceasedDate.HasValue ? _editDeceasedDate.Value.ToString("yyyy-MM-dd") : "")"
                                   @onchange="@(e => _editDeceasedDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_name.DeceasedDate.HasValue ? _name.DeceasedDate.Value.ToShortDateString() : "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3 d-flex align-items-end pb-1">
                        @if (_modifyMode)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="cbCitizen" @bind="_editIsCitizen" />
                                <label class="form-check-label" for="cbCitizen">US Citizen</label>
                            </div>
                        }
                        else
                        {
                            <div>
                                <small class="text-uppercase fw-semibold text-muted d-block" style="font-size: 0.7rem; letter-spacing: 0.05em">US Citizen</small>
                                <span class="fw-medium">@(_name.IsCitizen ? "Yes" : "No")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_editNameType == NameTypes.Person)
    {
        <!-- Physical Description -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Physical Description</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Sex</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Sex" @bind-Value="_editSexId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_sexLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Race</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.Race" @bind-Value="_editRaceId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_raceLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Date of Birth</label>
                        @if (_modifyMode)
                        {
                            <input type="date" class="form-control form-control-sm"
                                   value="@(_editDateOfBirth.HasValue ? _editDateOfBirth.Value.ToString("yyyy-MM-dd") : "")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @onchange="@(e => _editDateOfBirth = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">
                                @if (_name.DateOfBirth.HasValue)
                                {
                                    @_name.DateOfBirth.Value.ToShortDateString()
                                    @if (ComputeAge(_name.DateOfBirth) is int age)
                                    {
                                        <span class="text-muted ms-1">• Age @age</span>
                                    }
                                }
                                else
                                {
                                    @("—")
                                }
                            </p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Height</label>
                        @if (_modifyMode)
                        {
                            <div class="d-flex gap-1">
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control form-control-sm" @bind="_editHeightFeet" placeholder="ft" />
                                    <span class="input-group-text">ft</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control form-control-sm" @bind="_editHeightInchesRemainder" placeholder="in" />
                                    <span class="input-group-text">in</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@HeightDisplay</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Weight (lbs)</label>
                        <input type="number"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editWeightLbs" placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Hair Color</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.HairColor" @bind-Value="_editHairColorId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_hairColorLabel ?? "—")</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="@LabelClass">Eye Color</label>
                        @if (_modifyMode)
                        {
                            <PicklistSelect PicklistType="@PicklistTypes.EyeColor" @bind-Value="_editEyeColorId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_eyeColorLabel ?? "—")</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Identification -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Identification</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4">
                        <label class="@LabelClass">SSN</label>
                        @if (_modifyMode)
                        {
                            <input type="text" class="form-control form-control-sm" @bind="_editSsn"
                                   placeholder="XXX-XX-XXXX" maxlength="11" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@SsnDisplay</p>
                        }
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="@LabelClass">FBI #</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editFbiNumber" placeholder="—" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="@LabelClass">Local #</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editLocalNumber" placeholder="—" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Driver's License -->
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Driver's License</h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="@LabelClass">DL Number</label>
                        <input type="text"
                               class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0 fw-semibold mb-0")"
                               readonly="@(!_modifyMode)"
                               @bind="_editDlNumber" placeholder="—" />
                    </div>
                    <div class="col-sm-6">
                        <label class="@LabelClass">DL State</label>
                        @if (_modifyMode)
                        {
                            <StateSelect @bind-Value="_editDlStateId" />
                        }
                        else
                        {
                            <p class="form-control-plaintext form-control-sm ps-0 fw-semibold mb-0">@(_dlStateLabel ?? "—")</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_modifyMode)
    {
        <div class="mb-4">
            <button class="btn btn-sm btn-primary" title="Save Details (Alt+S)" @onclick="SaveDetailsAsync">Save Details<ShortcutHint Action="save" /></button>
        </div>
    }

    <!-- Address Links -->
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Address Links</h6>
            <div class="row g-3">
                <div class="col-12">
                    <label class="@LabelClass">Primary Address</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold">@(_editPrimaryLocationDisplay ?? "— None —")</span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showPrimaryLocationModal = true">
                                <i class="bi bi-geo-alt me-1"></i>@(_editPrimaryLocationId.HasValue ? "Change" : "Assign")
                            </button>
                            @if (_editPrimaryLocationId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearPrimaryLocation">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                    <LocationMiniMap LocationId="_editPrimaryLocationId" />
                </div>
                <div class="col-12">
                    <label class="@LabelClass">Secondary Address</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold">@(_editSecondaryLocationDisplay ?? "— None —")</span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showSecondaryLocationModal = true">
                                <i class="bi bi-geo-alt me-1"></i>@(_editSecondaryLocationId.HasValue ? "Change" : "Assign")
                            </button>
                            @if (_editSecondaryLocationId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearSecondaryLocation">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                    <LocationMiniMap LocationId="_editSecondaryLocationId" />
                </div>
            </div>
        </div>
    </div>

    <LocationSearchModal Visible="_showPrimaryLocationModal"
                         CurrentLocationId="_editPrimaryLocationId"
                         OnSelected="OnPrimaryLocationSelected"
                         OnCleared="OnPrimaryLocationCleared"
                         OnCancelled="() => _showPrimaryLocationModal = false" />

    <LocationSearchModal Visible="_showSecondaryLocationModal"
                         CurrentLocationId="_editSecondaryLocationId"
                         OnSelected="OnSecondaryLocationSelected"
                         OnCleared="OnSecondaryLocationCleared"
                         OnCancelled="() => _showSecondaryLocationModal = false" />

    <AuditInfoSection CreatedAt="@_name.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_name.ModifiedBy.HasValue ? _name.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
}

@code {
    [Parameter] public long RecordNumber { get; set; }

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    private Guid _nameId;
    private NameDto? _name;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    // Edit fields
    private string _editNameType = NameTypes.Person;
    private string _editLastOrBusinessName = string.Empty;
    private string? _editFirstName;
    private string? _editMiddleName;
    private Guid? _editSexId;
    private Guid? _editRaceId;
    private DateTime? _editDateOfBirth;
    private string? _editDlNumber;
    private Guid? _editDlStateId;
    private int? _editHeightFeet;
    private int? _editHeightInchesRemainder;
    private int? _editWeightLbs;
    private Guid? _editHairColorId;
    private Guid? _editEyeColorId;
    private Guid? _editSuffixId;
    private string? _editPlaceOfBirth;
    private string? _editFbiNumber;
    private string? _editLocalNumber;
    private string? _editSsn;
    private bool _editIsCitizen;
    private DateTime? _editDeceasedDate;
    private bool _showSwitchTypeConfirm;
    private Guid?  _editPrimaryLocationId;
    private string? _editPrimaryLocationDisplay;
    private bool   _showPrimaryLocationModal;
    private Guid?  _editSecondaryLocationId;
    private string? _editSecondaryLocationDisplay;
    private bool   _showSecondaryLocationModal;

    // Read-only picklist labels
    private string? _sexLabel;
    private string? _raceLabel;
    private string? _hairColorLabel;
    private string? _eyeColorLabel;
    private string? _dlStateLabel;
    private string? _suffixLabel;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;

    private int? EditHeightInches =>
        (_editHeightFeet.HasValue || _editHeightInchesRemainder.HasValue)
            ? (_editHeightFeet ?? 0) * 12 + (_editHeightInchesRemainder ?? 0)
            : null;

    private string HeightDisplay
    {
        get
        {
            if (!_name!.HeightInches.HasValue) return "—";
            var ft = _name.HeightInches.Value / 12;
            var inches = _name.HeightInches.Value % 12;
            return $"{ft}′ {inches}″";
        }
    }

    /// <summary>Field label style: small muted in read mode; standard in edit mode.</summary>
    private string LabelClass => _modifyMode
        ? "form-label mb-1"
        : "form-label mb-0 small text-muted d-block";

    /// <summary>Masks SSN as ***-**-XXXX in view mode. Returns "—" when null.</summary>
    private string SsnDisplay
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_name?.SocialSecurityNumber)) return "—";
            var ssn = _name.SocialSecurityNumber.Replace("-", "");
            if (ssn.Length < 4) return "***-**-??";
            return $"***-**-{ssn[^4..]}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveDetailsAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_name is not null && _name.IsLocked && _name.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            LoadEditFields();
            StartLockTimer();
        }
    }

    private void LoadEditFields()
    {
        if (_name is null) return;
        _editNameType              = _name.NameType;
        _editLastOrBusinessName    = _name.LastOrBusinessName;
        _editFirstName             = _name.FirstName;
        _editMiddleName            = _name.MiddleName;
        _editSexId                 = _name.SexId;
        _editRaceId                = _name.RaceId;
        _editDateOfBirth           = _name.DateOfBirth;
        _editDlNumber              = _name.DriversLicenseNumber;
        _editDlStateId             = _name.DriversLicenseStateId;
        _editHeightFeet            = _name.HeightInches.HasValue ? _name.HeightInches.Value / 12 : null;
        _editHeightInchesRemainder = _name.HeightInches.HasValue ? _name.HeightInches.Value % 12 : null;
        _editWeightLbs             = _name.WeightLbs;
        _editHairColorId           = _name.HairColorId;
        _editEyeColorId            = _name.EyeColorId;
        _editSuffixId              = _name.SuffixId;
        _editPlaceOfBirth          = _name.PlaceOfBirth;
        _editFbiNumber             = _name.FbiNumber;
        _editLocalNumber           = _name.LocalNumber;
        _editSsn                   = _name.SocialSecurityNumber;
        _editIsCitizen             = _name.IsCitizen;
        _editDeceasedDate          = _name.DeceasedDate;
        _editPrimaryLocationId     = _name.PrimaryLocationId;
        _editSecondaryLocationId   = _name.SecondaryLocationId;
        _editSnapshot = ComputeEditSnapshot();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editNameType, _editLastOrBusinessName, _editFirstName, _editMiddleName,
            _editSexId, _editRaceId, _editDateOfBirth, _editDlNumber, _editDlStateId,
            _editHeightFeet, _editHeightInchesRemainder, _editWeightLbs,
            _editHairColorId, _editEyeColorId, _editSuffixId, _editPlaceOfBirth,
            _editFbiNumber, _editLocalNumber, _editSsn, _editIsCitizen, _editDeceasedDate,
            _editPrimaryLocationId, _editSecondaryLocationId);

    private bool HasPendingChanges => _modifyMode && _editSnapshot != ComputeEditSnapshot();

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/names/create");
            }
        }
        else
        {
            Nav.NavigateTo("/names/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
    }

    private void ConfirmSwitchNameType()
    {
        _editNameType = _editNameType == NameTypes.Person ? NameTypes.Business : NameTypes.Person;
        _showSwitchTypeConfirm = false;
    }

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await SaveDetailsAsync();
        if (_actionError is null)
        {
            await ExitModifyModeAsync();
            if (navigateToNew) Nav.NavigateTo("/names/create");
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await ExitModifyModeAsync();
        if (navigateToNew) Nav.NavigateTo("/names/create");
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _name = await NameService.GetByRecordNumberAsync(RecordNumber);
            if (_name is null) { _error = "Name not found."; return; }
            _nameId = _name.Id;

            if (!_modifyMode)
            {
                LoadEditFields();
                await ResolveLocationDisplaysAsync();
            }

            _createdByName  = await UserLookupService.GetDisplayNameAsync(_name.CreatedBy);
            _modifiedByName = _name.ModifiedBy.HasValue
                ? await UserLookupService.GetDisplayNameAsync(_name.ModifiedBy.Value)
                : null;
            _lockedByName = _name.IsLocked && _name.LockedByUserId.HasValue
                ? await UserLookupService.GetDisplayNameAsync(_name.LockedByUserId.Value)
                : null;

            // Resolve picklist labels for read-only display
            var picklistIds = new List<Guid>();
            if (_name.SexId.HasValue)       picklistIds.Add(_name.SexId.Value);
            if (_name.RaceId.HasValue)       picklistIds.Add(_name.RaceId.Value);
            if (_name.HairColorId.HasValue)  picklistIds.Add(_name.HairColorId.Value);
            if (_name.EyeColorId.HasValue)   picklistIds.Add(_name.EyeColorId.Value);
            if (_name.DriversLicenseStateId.HasValue) picklistIds.Add(_name.DriversLicenseStateId.Value);
            if (_name.SuffixId.HasValue)     picklistIds.Add(_name.SuffixId.Value);

            if (picklistIds.Count > 0)
            {
                var labels = await PicklistService.GetItemsByIdsAsync(picklistIds);
                _sexLabel      = _name.SexId.HasValue       ? labels.GetValueOrDefault(_name.SexId.Value) : null;
                _raceLabel     = _name.RaceId.HasValue       ? labels.GetValueOrDefault(_name.RaceId.Value) : null;
                _hairColorLabel = _name.HairColorId.HasValue ? labels.GetValueOrDefault(_name.HairColorId.Value) : null;
                _eyeColorLabel = _name.EyeColorId.HasValue  ? labels.GetValueOrDefault(_name.EyeColorId.Value) : null;
                _dlStateLabel  = _name.DriversLicenseStateId.HasValue ? labels.GetValueOrDefault(_name.DriversLicenseStateId.Value) : null;
                _suffixLabel   = _name.SuffixId.HasValue     ? labels.GetValueOrDefault(_name.SuffixId.Value) : null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try { await action(); await LoadAsync(); }
        catch (Exception ex) { _actionError = ex.Message; }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await NameService.AcquireLockAsync(_nameId);
            _modifyMode = true;
            LoadEditFields();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        _showSwitchTypeConfirm = false;
        try { await NameService.ReleaseLockAsync(_nameId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private async Task SaveDetailsAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;
        try
        {
            await NameService.UpdateDetailsAsync(
                _nameId, _editNameType, _editLastOrBusinessName,
                _editNameType == NameTypes.Person ? _editFirstName : null,
                _editNameType == NameTypes.Person ? _editMiddleName : null,
                _editNameType == NameTypes.Person ? _editSexId : null,
                _editNameType == NameTypes.Person ? _editRaceId : null,
                _editNameType == NameTypes.Person ? _editDateOfBirth : null,
                _editNameType == NameTypes.Person ? _editDlNumber : null,
                _editNameType == NameTypes.Person ? _editDlStateId : null,
                _editNameType == NameTypes.Person ? EditHeightInches : null,
                _editNameType == NameTypes.Person ? _editWeightLbs : null,
                _editNameType == NameTypes.Person ? _editHairColorId : null,
                _editNameType == NameTypes.Person ? _editEyeColorId : null,
                _editNameType == NameTypes.Person ? _editSuffixId : null,
                _editNameType == NameTypes.Person ? _editPlaceOfBirth : null,
                _editNameType == NameTypes.Person ? _editFbiNumber : null,
                _editNameType == NameTypes.Person ? _editLocalNumber : null,
                _editNameType == NameTypes.Person ? _editSsn : null,
                _editNameType == NameTypes.Person && _editIsCitizen,
                _editNameType == NameTypes.Person ? _editDeceasedDate : null,
                _editPrimaryLocationId,
                _editSecondaryLocationId);

            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            _saveSuccessMessage = "Details saved successfully.";
            _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
            {
                _saveSuccessMessage = null;
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        await RunActionAsync(() => NameService.SoftDeleteAsync(_nameId));
        Nav.NavigateTo("/names");
    }

    private async Task ResolveLocationDisplaysAsync()
    {
        if (_editPrimaryLocationId.HasValue)
        {
            var loc = await LocationService.GetByIdAsync(_editPrimaryLocationId.Value);
            _editPrimaryLocationDisplay = loc is null ? null : FormatLocationDisplay(loc);
        }
        else _editPrimaryLocationDisplay = null;

        if (_editSecondaryLocationId.HasValue)
        {
            var loc = await LocationService.GetByIdAsync(_editSecondaryLocationId.Value);
            _editSecondaryLocationDisplay = loc is null ? null : FormatLocationDisplay(loc);
        }
        else _editSecondaryLocationDisplay = null;
    }

    private void OnPrimaryLocationSelected(LocationDto loc)
    {
        _editPrimaryLocationId      = loc.Id;
        _editPrimaryLocationDisplay = FormatLocationDisplay(loc);
        _showPrimaryLocationModal   = false;
    }

    private void OnPrimaryLocationCleared()
    {
        _editPrimaryLocationId      = null;
        _editPrimaryLocationDisplay = null;
        _showPrimaryLocationModal   = false;
    }

    private void ClearPrimaryLocation()
    {
        _editPrimaryLocationId      = null;
        _editPrimaryLocationDisplay = null;
    }

    private void OnSecondaryLocationSelected(LocationDto loc)
    {
        _editSecondaryLocationId      = loc.Id;
        _editSecondaryLocationDisplay = FormatLocationDisplay(loc);
        _showSecondaryLocationModal   = false;
    }

    private void OnSecondaryLocationCleared()
    {
        _editSecondaryLocationId      = null;
        _editSecondaryLocationDisplay = null;
        _showSecondaryLocationModal   = false;
    }

    private void ClearSecondaryLocation()
    {
        _editSecondaryLocationId      = null;
        _editSecondaryLocationDisplay = null;
    }

    private static string FormatLocationDisplay(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber))  parts.Add(loc.StreetNumber);
        if (!string.IsNullOrWhiteSpace(loc.StreetAddress)) parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))          parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)LockTimeout.TotalSeconds;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        return ValueTask.CompletedTask;
    }

    private static int? ComputeAge(DateTime? dob)
    {
        if (!dob.HasValue) return null;
        var today = DateTime.Today;
        var age   = today.Year - dob.Value.Year;
        if (dob.Value.AddYears(age) > today) age--;
        return age;
    }
}

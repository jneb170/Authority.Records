@page "/names"
@implements IDisposable
@inject INameService NameService
@inject IPicklistService PicklistService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject IUserLookupService UserLookupService
@using Modules.Records.Application.DTOs
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Services

<PageTitle>Names (MNI)</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-people-fill"></i> Names</h2>
        <div class="page-header-sub">Master Name Index (MNI)</div>
    </div>
    <a class="btn btn-primary" title="New Name (Alt+N)" href="/names/create"><i class="bi bi-plus-lg me-1"></i>New Name</a>
</div>

<!-- Search / Filter Panel -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer;" @onclick="() => _filterExpanded = !_filterExpanded">
        <span class="fw-semibold text-uppercase" style="font-size:0.8rem;letter-spacing:0.05em;">
            <i class="bi bi-search me-1"></i>Search / Filter
        </span>
        <i class="bi @(_filterExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size:0.8rem;"></i>
    </div>
@if (_filterExpanded)
{
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Name Type</label>
                <select class="form-select form-select-sm" @bind="_filterNameType">
                    <option value="">All</option>
                    <option value="@NameTypes.Person">Person</option>
                    <option value="@NameTypes.Business">Business</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Name contains</label>
                <input class="form-control form-control-sm" @bind="_filterNameContains" placeholder="Last / Business name…" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Sex</label>
                <PicklistSelect PicklistType="@PicklistTypes.Sex" @bind-Value="_filterSexId" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Race</label>
                <PicklistSelect PicklistType="@PicklistTypes.Race" @bind-Value="_filterRaceId" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">DOB from</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDobFrom.HasValue ? _filterDobFrom.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDobFrom = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">DOB to</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDobTo.HasValue ? _filterDobTo.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDobTo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Age Min</label>
                <input type="number" class="form-control form-control-sm" min="0" max="120"
                       placeholder="e.g. 18" @bind="_filterAgeMin" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Age Max</label>
                <input type="number" class="form-control form-control-sm" min="0" max="120"
                       placeholder="e.g. 65" @bind="_filterAgeMax" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Hair Color</label>
                <PicklistSelect PicklistType="@PicklistTypes.HairColor" @bind-Value="_filterHairColorId" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Eye Color</label>
                <PicklistSelect PicklistType="@PicklistTypes.EyeColor" @bind-Value="_filterEyeColorId" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">DL Number</label>
                <input class="form-control form-control-sm" @bind="_filterDlNumber" placeholder="License #" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">DL State</label>
                <StateSelect @bind-Value="_filterDlStateId" />
            </div>
        </div>
        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-sm btn-primary" @onclick="RunSearchAsync">Search</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFiltersAsync">Clear</button>
        </div>
    </div>
}
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_names is not null)
{
    @if (!_names.Any())
    {
        <p class="text-muted">No names found.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th style="width:3rem"></th>
                    <SortableColumnHeader ColumnKey="num"      Label="#"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="type"     Label="Type"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="lastname" Label="Last / Business Name"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="firstname" Label="First Name"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="dob"      Label="DOB"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="age"      Label="Age"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <th>Lock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in SortedNames)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" title="Delete"
                                    @onclick="() => InitiateDelete(n.Id, n.LastOrBusinessName)"><i class="bi bi-trash3"></i></button>
                        </td>
                        <td><a href="/names/@n.RecordNumber">@n.RecordNumber</a></td>
                        <td><span class="badge @(n.NameType == NameTypes.Person ? "bg-primary" : "bg-secondary")">@n.NameType</span></td>
                        <td><a href="/names/@n.RecordNumber">@n.LastOrBusinessName</a></td>
                        <td>@(n.FirstName ?? "—")</td>
                        <td>@(n.DateOfBirth.HasValue ? n.DateOfBirth.Value.ToShortDateString() : "—")</td>
                        <td>@(ComputeAge(n.DateOfBirth)?.ToString() ?? "—")</td>
                        <td><LockBadge IsLocked="@n.IsLocked" LockedByName="@GetLockName(n.LockedByUserId)" Compact="true" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="Delete Name"
               Message="@($"Are you sure you want to delete \"{_deleteTargetName}\"?")"
               OnConfirm="ExecuteDeleteAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private bool _filterExpanded = false;
    private IReadOnlyList<NameDto>? _names;
    private Dictionary<Guid, string> _lockUserNames = [];
    private bool _loading = true;
    private string? _error;

    // Delete state
    private bool   _showDeleteConfirm;
    private Guid   _deleteTargetId;
    private string _deleteTargetName = string.Empty;

    // Sort state
    private string _sortColumn    = "num";
    private bool   _sortAscending = false;

    private IEnumerable<NameDto> SortedNames =>
        _names is null ? [] :
        (_sortColumn, _sortAscending) switch
        {
            ("num",       true)  => _names.OrderBy(x => x.RecordNumber),
            ("num",       false) => _names.OrderByDescending(x => x.RecordNumber),
            ("type",      true)  => _names.OrderBy(x => x.NameType),
            ("type",      false) => _names.OrderByDescending(x => x.NameType),
            ("lastname",  true)  => _names.OrderBy(x => x.LastOrBusinessName),
            ("lastname",  false) => _names.OrderByDescending(x => x.LastOrBusinessName),
            ("firstname", true)  => _names.OrderBy(x => x.FirstName),
            ("firstname", false) => _names.OrderByDescending(x => x.FirstName),
            ("dob",       true)  => _names.OrderBy(x => x.DateOfBirth),
            ("dob",       false) => _names.OrderByDescending(x => x.DateOfBirth),
            ("age",       true)  => _names.OrderByDescending(x => x.DateOfBirth),   // older DOB = greater age
            ("age",       false) => _names.OrderBy(x => x.DateOfBirth),
            _                    => _names.OrderByDescending(x => x.DateOfBirth),
        };

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    // Filter state
    private string _filterNameType = string.Empty;
    private string _filterNameContains = string.Empty;
    private Guid? _filterSexId;
    private Guid? _filterRaceId;
    private DateTime? _filterDobFrom;
    private DateTime? _filterDobTo;
    private int?      _filterAgeMin;
    private int?      _filterAgeMax;
    private Guid? _filterHairColorId;
    private Guid? _filterEyeColorId;
    private string _filterDlNumber = string.Empty;
    private Guid? _filterDlStateId;

    protected override async Task OnInitializedAsync()
    {
        ShortcutService.OnNew += HandleShortcutNew;
        try
        {
            _names = await NameService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleShortcutNew() => InvokeAsync(() => Nav.NavigateTo("/names/create"));

    public void Dispose() => ShortcutService.OnNew -= HandleShortcutNew;

    private string? GetLockName(Guid? userId) =>
        userId.HasValue ? _lockUserNames.GetValueOrDefault(userId.Value) : null;

    private async Task ResolveLockedNamesAsync()
    {
        if (_names is null) return;
        var ids = _names.Where(n => n.IsLocked && n.LockedByUserId.HasValue)
                        .Select(n => n.LockedByUserId!.Value).Distinct();
        _lockUserNames = await UserLookupService.GetDisplayNamesAsync(ids);
    }

    private void InitiateDelete(Guid id, string name)
    {
        _deleteTargetId   = id;
        _deleteTargetName = name;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        _showDeleteConfirm = false;
        try
        {
            await NameService.SoftDeleteAsync(_deleteTargetId);
            _names = await NameService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task RunSearchAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var today      = DateTime.Today;
            var dobFrom    = _filterDobFrom;
            var dobTo      = _filterDobTo;

            // Age filters override DOB filters when provided
            if (_filterAgeMin.HasValue) dobTo   = today.AddYears(-_filterAgeMin.Value);
            if (_filterAgeMax.HasValue) dobFrom = today.AddYears(-(_filterAgeMax.Value + 1)).AddDays(1);

            _names = await NameService.SearchAsync(
                nameType:              string.IsNullOrWhiteSpace(_filterNameType) ? null : _filterNameType,
                nameContains:          string.IsNullOrWhiteSpace(_filterNameContains) ? null : _filterNameContains,
                sexId:                 _filterSexId,
                raceId:                _filterRaceId,
                dateOfBirthFrom:       dobFrom,
                dateOfBirthTo:         dobTo,
                hairColorId:           _filterHairColorId,
                eyeColorId:            _filterEyeColorId,
                driversLicenseNumber:  string.IsNullOrWhiteSpace(_filterDlNumber) ? null : _filterDlNumber,
                driversLicenseStateId: _filterDlStateId);
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearFiltersAsync()
    {
        _filterNameType = string.Empty;
        _filterNameContains = string.Empty;
        _filterSexId = null;
        _filterRaceId = null;
        _filterDobFrom = null;
        _filterDobTo = null;
        _filterAgeMin = null;
        _filterAgeMax = null;
        _filterHairColorId = null;
        _filterEyeColorId = null;
        _filterDlNumber = string.Empty;
        _filterDlStateId = null;
        _loading = true;
        _error = null;
        try
        {
            _names = await NameService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static int? ComputeAge(DateTime? dob)
    {
        if (!dob.HasValue) return null;
        var today = DateTime.Today;
        var age   = today.Year - dob.Value.Year;
        if (dob.Value.AddYears(age) > today) age--;
        return age;
    }
}

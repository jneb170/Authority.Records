@page "/names/create"
@implements IAsyncDisposable
@inject INameService NameService
@inject IKeyboardShortcutService ShortcutService
@inject NavigationManager Nav
@using Modules.Records.Domain.Common

<PageTitle>New Name</PageTitle>

<div class="page-header record-page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-people-fill"></i> New Name</h2>
        <div class="page-header-sub">Create a person or business record for use across incidents, arrests, and citations.</div>
    </div>
</div>

@if (_vm.ErrorMessage is not null)
{
    <div class="alert alert-danger">@_vm.ErrorMessage</div>
}

<div class="record-form-shell">
<EditForm Model="_vm" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="record-validation-summary" />

    <div class="card record-form-card mb-3">
        <div class="card-body">
            <h6 class="card-title">Identity</h6>
            <p class="record-form-note">Start with the primary identity fields. Additional descriptors can be completed now or added later during case work.</p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label">Name Type <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="_vm.NameType">
                        <option value="@NameTypes.Person">Person</option>
                        <option value="@NameTypes.Business">Business</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label">
                        @(_vm.IsPerson ? "Last Name" : "Business Name")
                        <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="_vm.LastOrBusinessName"
                               @bind-Value:after="() => _vm.LastOrBusinessName = NameCaseConverter.ToNameCase(_vm.LastOrBusinessName) ?? string.Empty"
                               placeholder="@(_vm.IsPerson ? "Last name" : "Business name")" />
                    <ValidationMessage For="() => _vm.LastOrBusinessName" />
                </div>

                @if (_vm.IsPerson)
                {
                    <div class="col-sm-6">
                        <label class="form-label">First Name</label>
                        <InputText class="form-control" @bind-Value="_vm.FirstName"
                                   @bind-Value:after="() => _vm.FirstName = NameCaseConverter.ToNameCase(_vm.FirstName)" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Middle Name</label>
                        <InputText class="form-control" @bind-Value="_vm.MiddleName"
                                   @bind-Value:after="() => _vm.MiddleName = NameCaseConverter.ToNameCase(_vm.MiddleName)" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Suffix</label>
                        <PicklistSelect PicklistType="@PicklistTypes.Suffix" @bind-Value="_vm.SuffixId" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Place of Birth</label>
                        <InputText class="form-control" @bind-Value="_vm.PlaceOfBirth"
                                   @bind-Value:after="() => _vm.PlaceOfBirth = NameCaseConverter.ToNameCase(_vm.PlaceOfBirth)"
                                   placeholder="City, State" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Deceased Date</label>
                        <input type="date" class="form-control"
                               value="@(_vm.DeceasedDate.HasValue ? _vm.DeceasedDate.Value.ToString("yyyy-MM-dd") : "")"
                               @onchange="@(e => _vm.DeceasedDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                    </div>
                    <div class="col-sm-6 col-md-3 d-flex align-items-end pb-1">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_vm.IsCitizen" id="cbCitizenCreate" />
                            <label class="form-check-label" for="cbCitizenCreate">US Citizen</label>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card record-form-card mb-3">
        <div class="card-body">
            <h6 class="card-title">Phone Numbers</h6>
            <div class="row g-3">
                <div class="col-lg-4">
                    <PhoneNumberField Label="Primary Phone"
                                      ModifyMode="true"
                                      Number="@_vm.PrimaryPhone"
                                      NumberChanged="@(value => _vm.PrimaryPhone = value)"
                                      Extension="@_vm.PrimaryPhoneExtension"
                                      ExtensionChanged="@(value => _vm.PrimaryPhoneExtension = value)" />
                </div>
                <div class="col-lg-4">
                    <PhoneNumberField Label="@(_vm.IsPerson ? "Work Phone" : "Secondary Phone")"
                                      ModifyMode="true"
                                      Number="@_vm.WorkPhone"
                                      NumberChanged="@(value => _vm.WorkPhone = value)"
                                      Extension="@_vm.WorkPhoneExtension"
                                      ExtensionChanged="@(value => _vm.WorkPhoneExtension = value)" />
                </div>
                <div class="col-lg-4">
                    <PhoneNumberField Label="Other Phone"
                                      ModifyMode="true"
                                      Number="@_vm.OtherPhone"
                                      NumberChanged="@(value => _vm.OtherPhone = value)"
                                      Extension="@_vm.OtherPhoneExtension"
                                      ExtensionChanged="@(value => _vm.OtherPhoneExtension = value)" />
                </div>
            </div>
        </div>
    </div>

    @if (_vm.IsPerson)
    {
        <div class="card record-form-card mb-3">
            <div class="card-body">
                <h6 class="card-title">Physical Description</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Sex</label>
                        <PicklistSelect PicklistType="@PicklistTypes.Sex" @bind-Value="_vm.SexId" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Race</label>
                        <PicklistSelect PicklistType="@PicklistTypes.Race" @bind-Value="_vm.RaceId" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" class="form-control"
                               value="@(_vm.DateOfBirth.HasValue ? _vm.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               @onchange="@(e => _vm.DateOfBirth = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Height</label>
                        <div class="d-flex gap-1">
                            <div class="input-group input-group-sm">
                                <InputNumber class="form-control" @bind-Value="_vm.HeightFeet" placeholder="ft" />
                                <span class="input-group-text">ft</span>
                            </div>
                            <div class="input-group input-group-sm">
                                <InputNumber class="form-control" @bind-Value="_vm.HeightInchesRemainder" placeholder="in" />
                                <span class="input-group-text">in</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Weight (lbs)</label>
                        <InputNumber class="form-control" @bind-Value="_vm.WeightLbs" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Hair Color</label>
                        <PicklistSelect PicklistType="@PicklistTypes.HairColor" @bind-Value="_vm.HairColorId" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label class="form-label">Eye Color</label>
                        <PicklistSelect PicklistType="@PicklistTypes.EyeColor" @bind-Value="_vm.EyeColorId" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card record-form-card mb-3">
            <div class="card-body">
                <h6 class="card-title">Driver's License</h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">DL Number</label>
                        <InputText class="form-control" @bind-Value="_vm.DriversLicenseNumber" placeholder="License #" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">DL State</label>
                        <StateSelect @bind-Value="_vm.DriversLicenseStateId" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card record-form-card mb-3">
            <div class="card-body">
                <h6 class="card-title">Identification</h6>
                <div class="row g-3">
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label">SSN</label>
                        <InputText class="form-control" @bind-Value="_vm.SocialSecurityNumber" placeholder="XXX-XX-XXXX" maxlength="11" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label">FBI #</label>
                        <InputText class="form-control" @bind-Value="_vm.FbiNumber" placeholder="FBI identifier" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label">Local #</label>
                        <InputText class="form-control" @bind-Value="_vm.LocalNumber" placeholder="Local ID" />
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="record-form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_submitting">
            @(_submitting ? "Creating…" : "Create Name")
        </button>
        <a class="btn btn-secondary" href="/names">Cancel</a>
    </div>
</EditForm>
</div>

<UnsavedChangesDialog Visible="_showCancelConfirm"
                      SaveLabel="Submit Record"
                      DiscardLabel="Discard"
                      ActionDescription="leaving the form"
                      OnSaveAndRelease="SubmitFromDialogAsync"
                      OnDiscard="DiscardAndCancelAsync"
                      OnCancel="() => _showCancelConfirm = false" />

@code {
    private readonly CreateNameViewModel _vm = new();
    private bool _submitting;
    private bool _showCancelConfirm;

    private bool HasEnteredData => !string.IsNullOrEmpty(_vm.LastOrBusinessName);
    private string CancelUrl => "/names";

    protected override Task OnInitializedAsync()
    {
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
        return Task.CompletedTask;
    }

    private void HandleShortcutSave()
        => InvokeAsync(async () => { await SubmitAsync(); StateHasChanged(); });

    private void HandleShortcutRelease()
        => InvokeAsync(() => { HandleEscape(); StateHasChanged(); });

    private void HandleEscape()
    {
        if (HasEnteredData)
            _showCancelConfirm = true;
        else
            Nav.NavigateTo(CancelUrl);
    }

    private async Task SubmitFromDialogAsync()
    {
        _showCancelConfirm = false;
        await SubmitAsync();
    }

    private void DiscardAndCancelAsync() => Nav.NavigateTo(CancelUrl);

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        return ValueTask.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _vm.ErrorMessage = null;
        try
        {
            var recordNumber = await NameService.CreateAsync(
                _vm.NameType,
                _vm.LastOrBusinessName,
                _vm.IsPerson ? _vm.FirstName : null,
                _vm.IsPerson ? _vm.MiddleName : null,
                _vm.IsPerson ? _vm.SexId : null,
                _vm.IsPerson ? _vm.RaceId : null,
                _vm.IsPerson ? _vm.DateOfBirth : null,
                _vm.IsPerson ? _vm.DriversLicenseNumber : null,
                _vm.IsPerson ? _vm.DriversLicenseStateId : null,
                _vm.IsPerson ? _vm.HeightInches : null,
                _vm.IsPerson ? _vm.WeightLbs : null,
                _vm.IsPerson ? _vm.HairColorId : null,
                _vm.IsPerson ? _vm.EyeColorId : null,
                _vm.IsPerson ? _vm.SuffixId : null,
                _vm.IsPerson ? _vm.PlaceOfBirth : null,
                _vm.IsPerson ? _vm.FbiNumber : null,
                _vm.IsPerson ? _vm.LocalNumber : null,
                _vm.IsPerson ? _vm.SocialSecurityNumber : null,
                _vm.IsPerson && _vm.IsCitizen,
                _vm.IsPerson ? _vm.DeceasedDate : null,
                _vm.PrimaryPhone,
                _vm.PrimaryPhoneExtension,
                _vm.WorkPhone,
                _vm.WorkPhoneExtension,
                _vm.OtherPhone,
                _vm.OtherPhoneExtension);

            Nav.NavigateTo($"/names/{recordNumber}?autoModify=true");
        }
        catch (Exception ex)
        {
            _vm.ErrorMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}

@page "/Error/{statusCode:int?}"
@model Modules.Records.UI.Pages.ErrorModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@Model.Title — Authority Records</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="ar-auth-body">
    <div class="ar-auth-shell">
        <section class="ar-auth-card-panel">
            <div class="ar-auth-card text-center" data-status-code="@Model.StatusCode">
                <i class="bi @Model.Icon fs-1 text-secondary" aria-hidden="true"></i>
                <h1 class="ar-auth-card-title">@Model.Title</h1>
                <p class="ar-auth-card-text mb-4">@Model.Message</p>
                <a href="/" class="btn btn-primary btn-lg w-100">Back to the dashboard</a>
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small mt-3 mb-0">Request ID: <code>@Model.RequestId</code></p>
                }
            </div>
        </section>
    </div>
</body>
</html>

@page "/arrests/{RecordNumber:long}/relationships"
@page "/incidents/{IncidentRecordNumber:long}/arrests/{RecordNumber:long}/relationships"
@using Modules.Records.Application.Relationships.Queries.GetRecordRelationships

<RecordRelationshipsPanel RecordType="@RecordRelationshipRecordTypes.Arrest"
                          RecordNumber="@RecordNumber"
                          ListUrl="/arrests"
                          ListLabel="Arrests"
                          DetailsUrl="@DetailsUrl"
                          RelationshipsUrl="@RelationshipsUrl" />

@code {
    [Parameter] public long RecordNumber { get; set; }
    [Parameter] public long? IncidentRecordNumber { get; set; }

    private string DetailsUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/arrests/{RecordNumber}"
            : $"/arrests/{RecordNumber}";

    private string RelationshipsUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/arrests/{RecordNumber}/relationships"
            : $"/arrests/{RecordNumber}/relationships";
}

    private async Task CopyCurrentNameToAtTimeOfAsync()
    {
        if (!_editNameId.HasValue)
        {
            _actionError = "Select a linked name before copying At Time Of data.";
            return;
        }

        var name = await NameService.GetByIdAsync(_editNameId.Value);
        if (name is null)
        {
            _actionError = "Linked name not found.";
            return;
        }

        await PopulateAtTimeOfFromNameAsync(name);
    }

    private async Task PopulateAtTimeOfFromNameAsync(NameDto name)
    {
        _editAtTimeOfNameType = name.NameType;
        _editAtTimeOfLastOrBusinessName = name.LastOrBusinessName;
        _editAtTimeOfFirstName = name.FirstName;
        _editAtTimeOfMiddleName = name.MiddleName;
        _editAtTimeOfSexId = name.SexId;
        _editAtTimeOfRaceId = name.RaceId;
        _editAtTimeOfDateOfBirth = name.DateOfBirth;
        _editAtTimeOfDriversLicenseNumber = name.DriversLicenseNumber;
        _editAtTimeOfDriversLicenseStateId = name.DriversLicenseStateId;
        _editAtTimeOfHeightInches = name.HeightInches;
        _editAtTimeOfWeightLbs = name.WeightLbs;
        _editAtTimeOfHairColorId = name.HairColorId;
        _editAtTimeOfEyeColorId = name.EyeColorId;
        _editAtTimeOfSuffixId = name.SuffixId;
        _editAtTimeOfPlaceOfBirth = name.PlaceOfBirth;
        _editAtTimeOfFbiNumber = name.FbiNumber;
        _editAtTimeOfLocalNumber = name.LocalNumber;
        _editAtTimeOfPrimaryPhone = name.PrimaryPhone;
        _editAtTimeOfPrimaryPhoneExtension = name.PrimaryPhoneExtension;
        _editAtTimeOfWorkPhone = name.WorkPhone;
        _editAtTimeOfWorkPhoneExtension = name.WorkPhoneExtension;
        _editAtTimeOfOtherPhone = name.OtherPhone;
        _editAtTimeOfOtherPhoneExtension = name.OtherPhoneExtension;
        _editAtTimeOfSocialSecurityNumber = name.SocialSecurityNumber;
        _editAtTimeOfIsCitizen = name.IsCitizen;
        _editAtTimeOfDeceasedDate = name.DeceasedDate;
        _editAtTimeOfCopiedAtUtc = null;
        _editAtTimeOfCopiedByName = null;

        await PopulateAtTimeOfAddressAsync(
            name.PrimaryLocationId,
            isPrimary: true);
        await PopulateAtTimeOfAddressAsync(
            name.SecondaryLocationId,
            isPrimary: false);

        await ResolveAtTimeOfLabelsAsync();
    }

    private async Task PopulateAtTimeOfAddressAsync(Guid? locationId, bool isPrimary)
    {
        var location = locationId.HasValue
            ? await LocationService.GetByIdAsync(locationId.Value)
            : null;

        if (isPrimary)
        {
            _editAtTimeOfPrimaryLocationId = location?.Id;
            _editAtTimeOfPrimaryLocationRecordNumber = location?.RecordNumber;
            _editAtTimeOfPrimaryLocationAddress = location?.Address ?? (location is null ? null : FormatLocationDisplay(location));
            return;
        }

        _editAtTimeOfSecondaryLocationId = location?.Id;
        _editAtTimeOfSecondaryLocationRecordNumber = location?.RecordNumber;
        _editAtTimeOfSecondaryLocationAddress = location?.Address ?? (location is null ? null : FormatLocationDisplay(location));
    }


@page "/incidents/{IncidentId:guid}/arrests/{Id:guid}"
@implements IAsyncDisposable
@inject IArrestService ArrestService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav

<PageTitle>Arrest Details</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_arrest is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/incidents/@IncidentId">Incident</a></li>
            <li class="breadcrumb-item active">Arrest</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Arrest</h1>
        <div class="d-flex gap-2">
            <StatusBadge Status="@_arrest.Status" />
            <LockBadge IsLocked="@_arrest.IsLocked" LockedByUserId="@_arrest.LockedByUserId" />
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2">
                <span>✏️ <strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <button class="btn btn-sm btn-outline-dark ms-auto" @onclick="ExitModifyModeAsync">🔓 Release Record</button>
            </div>
        }
        else if (_arrest.IsLocked && _arrest.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                🔒 Record is locked by another user — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync">✏️ Modify</button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar mb-4 d-flex flex-wrap gap-2">
            @if (_arrest.Status == "Draft")
            {
                <button class="btn btn-success btn-sm" @onclick="OpenAsync">Open</button>
            }
            @if (_arrest.Status == "Open")
            {
                <button class="btn btn-info btn-sm" @onclick="FinalizeAsync">Finalize</button>
                <button class="btn btn-warning btn-sm" @onclick="CloseAsync">Close</button>
            }
            @if (_arrest.Status is "Closed")
            {
                <button class="btn btn-secondary btn-sm" @onclick="ArchiveAsync">Archive</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Arrest"
                   Message="Are you sure you want to delete this arrest record?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <!-- Arrest Fields (always visible; inputs become editable in modify mode) -->
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Arrest Details</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label mb-1">Suspect Name @if (_modifyMode) { <span class="text-danger">*</span> }</label>
                    <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editSuspectName" placeholder="@(_modifyMode ? "Required" : "—")" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label mb-1">Arrested At</label>
                    <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editArrestedAt" />
                </div>
            </div>
            @if (_modifyMode)
            {
                <div class="mt-3">
                    <button class="btn btn-sm btn-primary" @onclick="SaveDetailsAsync">Save Details</button>
                </div>
            }
        </div>
    </div>

    <AuditInfoSection CreatedAt="@_arrest.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_arrest.ModifiedBy.HasValue ? _arrest.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
}

@code {
    [Parameter] public Guid IncidentId { get; set; }
    [Parameter] public Guid Id { get; set; }

    private ArrestDto? _arrest;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    private string _editSuspectName = string.Empty;
    private DateTime _editArrestedAt = DateTime.Now;

    private string? _createdByName;
    private string? _modifiedByName;

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();
    }

    private void RestoreModifyModeIfOwner()
    {
        if (_arrest is not null && _arrest.IsLocked && _arrest.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            _editSuspectName = _arrest.SuspectName;
            _editArrestedAt  = _arrest.ArrestedAt;
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _arrest = await ArrestService.GetByIdAsync(Id);
            if (_arrest is null) _error = "Arrest not found.";

            if (_arrest is not null && !_modifyMode)
            {
                _editSuspectName = _arrest.SuspectName;
                _editArrestedAt  = _arrest.ArrestedAt;
            }

            if (_arrest is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_arrest.CreatedBy);
                _modifiedByName = _arrest.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_arrest.ModifiedBy.Value)
                    : null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await ArrestService.AcquireLockAsync(Id);
            _modifyMode = true;
            _editSuspectName = _arrest?.SuspectName ?? string.Empty;
            _editArrestedAt  = _arrest?.ArrestedAt ?? DateTime.Now;
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        try { await ArrestService.ReleaseLockAsync(Id); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private async Task SaveDetailsAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;
        try
        {
            await ArrestService.UpdateDetailsAsync(Id, _editSuspectName, _editArrestedAt);
            await LoadAsync();
            _saveSuccessMessage = "Details saved successfully.";
            _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
            {
                _saveSuccessMessage = null;
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)LockTimeout.TotalSeconds;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    private Task OpenAsync()        => RunActionAsync(() => ArrestService.OpenAsync(Id));
    private Task CloseAsync()       => RunActionAsync(() => ArrestService.CloseAsync(Id));
    private Task ArchiveAsync()     => RunActionAsync(() => ArrestService.ArchiveAsync(Id));
    private Task FinalizeAsync()    => RunActionAsync(() => ArrestService.FinalizeAsync(Id));

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        await RunActionAsync(() => ArrestService.SoftDeleteAsync(Id));
        Nav.NavigateTo($"/incidents/{IncidentId}");
    }

    public ValueTask DisposeAsync()
    {
        StopLockTimer();
        return ValueTask.CompletedTask;
    }
}

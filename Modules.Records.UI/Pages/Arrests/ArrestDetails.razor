    private static string FormatLocationDisplay(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber))  parts.Add(loc.StreetNumber);
        if (!string.IsNullOrWhiteSpace(loc.StreetAddress)) parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))          parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    private static string FormatNameDisplay(NameDto name)
    {
        if (name.NameType == NameTypes.Business)
            return name.LastOrBusinessName;

        return string.IsNullOrWhiteSpace(name.FirstName)
            ? name.LastOrBusinessName
            : $"{name.LastOrBusinessName}, {name.FirstName}";
    }

    private static string? FormatIncidentDisplay(ArrestDto arrest)
    {
        if (!string.IsNullOrWhiteSpace(arrest.PrimaryIncidentNum))
            return arrest.PrimaryIncidentNum;

        return arrest.PrimaryIncidentRecordNumber.HasValue
            ? $"Incident #{arrest.PrimaryIncidentRecordNumber.Value}"
            : null;
    }

    private static string FormatIncidentDisplay(IncidentDto incident)
    {
        if (!string.IsNullOrWhiteSpace(incident.Details.IncidentNum))
            return incident.Details.IncidentNum;

        return $"Incident #{incident.RecordNumber}";
    }

    private IReadOnlyList<RecordChargeDto>? VisibleCharges =>
        _charges is null
            ? null
            : _charges
                .Where(c => !_pendingChargeRemoves.Contains(c.ChargeId))
                .Concat(_pendingChargeAdds.Values
                    .Where(p => _charges.All(existing => existing.ChargeId != p.Charge.Id))
                    .Select(p => MapCharge(p.Charge, p.LinkedAtUtc)))
                .OrderByDescending(c => c.LinkedAtUtc)
                .ToList();

    private IReadOnlyList<IncidentArrestLinkDto>? VisibleLinkedIncidents =>
        _linkedIncidents is null
            ? null
            : _linkedIncidents
                .Where(link => !_pendingIncidentLinkRemoves.Contains(link.IncidentId))
                .Concat(_pendingIncidentLinkAdds.Values
                    .Where(p => _linkedIncidents.All(existing => existing.IncidentId != p.Incident.Id))
                    .Select(p => MapIncidentLink(p.Incident, p.LinkedAtUtc)))
                .OrderByDescending(link => link.LinkedAtUtc)
                .ToList();

    private async Task ApplyPendingChargeChangesAsync()
    {
        foreach (var chargeId in _pendingChargeRemoves.ToList())
        {
            await ChargeService.UnlinkFromArrestAsync(_arrestId, chargeId);
            _pendingChargeRemoves.Remove(chargeId);
        }

        foreach (var chargeId in _pendingChargeAdds.Keys.ToList())
        {
            await ChargeService.LinkToArrestAsync(_arrestId, _pendingChargeAdds[chargeId].Charge.Id);
            _pendingChargeAdds.Remove(chargeId);
        }
    }

    private async Task ApplyPendingIncidentLinkChangesAsync()
    {
        foreach (var incidentId in _pendingIncidentLinkRemoves.ToList())
        {
            await ArrestService.UnlinkFromIncidentAsync(_arrestId, incidentId);
            _pendingIncidentLinkRemoves.Remove(incidentId);
        }

        foreach (var incidentId in _pendingIncidentLinkAdds.Keys.ToList())
        {
            await ArrestService.LinkToIncidentAsync(_arrestId, _pendingIncidentLinkAdds[incidentId].Incident.Id);
            _pendingIncidentLinkAdds.Remove(incidentId);
        }
    }

    private static RecordChargeDto MapCharge(ChargeDto charge, DateTime linkedAtUtc) =>
        new(
            charge.Id,
            charge.OffenseName,
            charge.UcrCode,
            charge.ChargeLevel,
            charge.StateClass,
            charge.IsCitationEligible,
            charge.IsActive,
            linkedAtUtc);

    private static IncidentArrestLinkDto MapIncidentLink(IncidentDto incident, DateTime linkedAtUtc) =>
        new(
            Guid.Empty,
            incident.Id,
            incident.RecordNumber,
            FormatIncidentDisplay(incident),
            Guid.Empty,
            linkedAtUtc);

    private string? GetReleaseWarningMessage() =>
        _createdForeignRecords.Count == 0 ? null : string.Join(" ", _createdForeignRecords);

    private void TrackCreatedForeignRecord(string message)
    {
        if (!_createdForeignRecords.Contains(message, StringComparer.Ordinal))
            _createdForeignRecords.Add(message);
    }

    private void ClearPendingChanges()
    {
        _pendingChargeAdds.Clear();
        _pendingChargeRemoves.Clear();
        _pendingIncidentLinkAdds.Clear();
        _pendingIncidentLinkRemoves.Clear();
        _createdForeignRecords.Clear();
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        return ValueTask.CompletedTask;
    }


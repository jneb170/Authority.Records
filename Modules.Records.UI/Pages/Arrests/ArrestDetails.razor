    private async Task ResolveAtTimeOfLabelsAsync()
    {
        if (_editAtTimeOfCopiedAtUtc.HasValue && _arrest?.AtTimeOfName?.LastCopiedByUserId is Guid copiedBy)
        {
            _editAtTimeOfCopiedByName = await UserLookupService.GetDisplayNameAsync(copiedBy);
        }
        else
        {
            _editAtTimeOfCopiedByName = null;
        }

        var ids = new[]
        {
            _editAtTimeOfSuffixId,
            _editAtTimeOfSexId,
            _editAtTimeOfRaceId,
            _editAtTimeOfHairColorId,
            _editAtTimeOfEyeColorId,
            _editAtTimeOfDriversLicenseStateId
        }
        .Where(id => id.HasValue)
        .Select(id => id!.Value)
        .Distinct()
        .ToArray();

        if (ids.Length == 0)
        {
            _atTimeOfSuffixLabel = null;
            _atTimeOfSexLabel = null;
            _atTimeOfRaceLabel = null;
            _atTimeOfHairColorLabel = null;
            _atTimeOfEyeColorLabel = null;
            _atTimeOfDriversLicenseStateLabel = null;
            return;
        }

        var labels = await PicklistService.GetItemsByIdsAsync(ids);
        _atTimeOfSuffixLabel = _editAtTimeOfSuffixId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfSuffixId.Value) : null;
        _atTimeOfSexLabel = _editAtTimeOfSexId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfSexId.Value) : null;
        _atTimeOfRaceLabel = _editAtTimeOfRaceId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfRaceId.Value) : null;
        _atTimeOfHairColorLabel = _editAtTimeOfHairColorId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfHairColorId.Value) : null;
        _atTimeOfEyeColorLabel = _editAtTimeOfEyeColorId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfEyeColorId.Value) : null;
        _atTimeOfDriversLicenseStateLabel = _editAtTimeOfDriversLicenseStateId.HasValue ? labels.GetValueOrDefault(_editAtTimeOfDriversLicenseStateId.Value) : null;
    }

    private IReadOnlyList<RecordChargeDto>? VisibleCharges =>
        _charges is null
            ? null
            : _charges
                .Where(c => !_pendingChargeRemoves.Contains(c.ChargeId))
                .Concat(_pendingChargeAdds.Values
                    .Where(p => _charges.All(existing => existing.ChargeId != p.Charge.Id))
                    .Select(p => MapCharge(p.Charge, p.LinkedAtUtc)))
                .OrderByDescending(c => c.LinkedAtUtc)
                .ToList();

    private IReadOnlyList<IncidentArrestLinkDto>? VisibleLinkedIncidents =>
        _linkedIncidents is null
            ? null
            : _linkedIncidents
                .Where(link => !_pendingIncidentLinkRemoves.Contains(link.IncidentId))
                .Concat(_pendingIncidentLinkAdds.Values
                    .Where(p => _linkedIncidents.All(existing => existing.IncidentId != p.Incident.Id))
                    .Select(p => MapIncidentLink(p.Incident, p.LinkedAtUtc)))
                .OrderByDescending(link => link.LinkedAtUtc)
                .ToList();

    private static RecordChargeDto MapCharge(ChargeDto charge, DateTime linkedAtUtc) =>
        new(
            charge.Id,
            charge.OffenseName,
            charge.UcrCode,
            charge.ChargeLevel,
            charge.StateClass,
            charge.IsCitationEligible,
            charge.IsActive,
            linkedAtUtc);

    private static IncidentArrestLinkDto MapIncidentLink(IncidentDto incident, DateTime linkedAtUtc) =>
        new(
            Guid.Empty,
            incident.Id,
            incident.RecordNumber,
            FormatIncidentDisplay(incident),
            Guid.Empty,
            linkedAtUtc);

    private string? GetReleaseWarningMessage() =>
        _createdForeignRecords.Count == 0 ? null : string.Join(" ", _createdForeignRecords);

    private void TrackCreatedForeignRecord(string message)
    {
        if (!_createdForeignRecords.Contains(message, StringComparer.Ordinal))
            _createdForeignRecords.Add(message);
    }

    private void ClearPendingChanges()
    {
        _pendingChargeAdds.Clear();
        _pendingChargeRemoves.Clear();
        _pendingIncidentLinkAdds.Clear();
        _pendingIncidentLinkRemoves.Clear();
        _createdForeignRecords.Clear();
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        ReleaseAgencySelectionLock();
        return ValueTask.CompletedTask;
    }


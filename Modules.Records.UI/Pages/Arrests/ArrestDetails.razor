@page "/arrests/{RecordNumber:long}"
@page "/incidents/{IncidentRecordNumber:long}/arrests/{RecordNumber:long}"
@implements IAsyncDisposable
@inject IArrestService ArrestService
@inject IIncidentService IncidentService
@inject IChargeService ChargeService
@inject IPicklistService PicklistService
@inject IAgencyConfigurationService ConfigService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject ILocationService LocationService
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Services

<PageTitle>Arrest Details</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_arrest is not null)
{
    <nav aria-label="breadcrumb" class="record-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/arrests">Arrests</a></li>
            @if (IncidentRecordNumber.HasValue)
            {
                <li class="breadcrumb-item"><a href="/incidents/@IncidentRecordNumber">Incident</a></li>
            }
            <li class="breadcrumb-item active">Arrest #@RecordNumber</li>
        </ol>
    </nav>

    <div class="page-header record-page-header">
        <div>
            <h2 class="page-header-title"><i class="bi bi-person-badge-fill"></i> Arrest Record</h2>
            <div class="page-header-sub">
                @(string.IsNullOrWhiteSpace(_arrest.ArrestNum)
                    ? $"Arrest #{RecordNumber}"
                    : _arrest.ArrestNum)
            </div>
        </div>
        <div class="d-flex gap-2 record-header-meta">
            <div class="record-header-thumb" title="Primary mugshot">
                <MugshotThumbnail ImageUrl="@_arrest.PrimaryMugshotUrl"
                                  Alt="@($"Primary mugshot for arrest record {RecordNumber}")"
                                  Compact="true" />
            </div>
            <StatusBadge Status="@_arrest.Status" />
            <LockBadge IsLocked="@_arrest.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    <RecordDetailsTabs DetailsUrl="@DetailsTabUrl"
                       RelationshipsUrl="@RelationshipsTabUrl"
                       ActiveTab="Details" />

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" aria-label="Dismiss message" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="record-toolbar mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2 record-mode-banner">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <div class="record-mode-actions">
                    <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync"><i class="bi bi-floppy-fill me-1"></i>Save</button>
                    <button class="btn btn-sm btn-outline-dark" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release</button>
                </div>
            </div>
        }
        else if (_arrest.IsLocked && _arrest.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify</button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar record-action-bar mb-4 d-flex flex-wrap gap-2">
            @if (_arrest.Status == "Draft")
            {
                <button class="btn btn-success btn-sm" @onclick="OpenAsync">Open</button>
            }
            @if (_arrest.Status == "Open")
            {
                <button class="btn btn-info btn-sm" @onclick="FinalizeAsync">Finalize</button>
                <button class="btn btn-warning btn-sm" @onclick="CloseAsync">Close</button>
            }
            @if (_arrest.Status is "Closed")
            {
                <button class="btn btn-secondary btn-sm" @onclick="ArchiveAsync">Archive</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Arrest"
                   Message="Are you sure you want to delete this arrest record?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          WarningMessage="@GetReleaseWarningMessage()"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Arrest Fields (always visible; inputs become editable in modify mode) -->
    <div class="card record-content-card mb-4">
        <div class="card-body">
            <h6 class="card-title">Arrest Details</h6>
            <div class="record-grid-3">
                <div class="record-field-span-2">
                    <label class="form-label mb-1">Suspect</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">
                            @if (!_modifyMode && _editNameRecordNumber.HasValue)
                            {
                                <a href="/names/@_editNameRecordNumber" class="record-reference-link">@(_editNameDisplay ?? "— None —")</a>
                            }
                            else
                            {
                                @(_editNameDisplay ?? "— None —")
                            }
                        </span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showNameModal = true">
                                <i class="bi bi-people me-1"></i>@(_editNameId.HasValue ? "Change" : "Assign") Name
                            </button>
                            @if (_editNameId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned name" title="Clear assigned name" @onclick="ClearName">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                </div>
                <div>
                    <label class="form-label mb-1">Arrested At</label>
                    <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           value="@DateTimeLocalInputHelper.Format(_editArrestedAt)"
                           @onchange="OnArrestedAtChanged" />
                </div>
                <div>
                    <label class="form-label mb-1">Arrest Number</label>
                    @if (_modifyMode)
                    {
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control form-control-sm"
                                   @bind="_editArrestNum" placeholder="e.g. AR-2026-000001" />
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="GenerateArrestNumAsync" disabled="@_generatingArrestNum">
                                @(_generatingArrestNum ? "…" : "🔁")
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(string.IsNullOrWhiteSpace(_arrest.ArrestNum) ? "—" : _arrest.ArrestNum)</p>
                    }
                </div>
                <div>
                    <label class="form-label mb-1">Arrest Type</label>
                    @if (_modifyMode)
                    {
                        <PicklistSelect PicklistType="@PicklistTypes.ArrestType"
                                        @bind-Value="_editArrestTypeId"
                                        IsRequired="@_arrestTypeRequired" />
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(_arrestTypeLabel ?? "—")</p>
                    }
                </div>
                <div class="record-field-span-full">
                    <label class="form-label mb-1">Primary Incident</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">
                            @if (!_modifyMode && _editPrimaryIncidentRecordNumber.HasValue)
                            {
                                <a href="/incidents/@_editPrimaryIncidentRecordNumber" class="record-reference-link">@(_editPrimaryIncidentDisplay ?? "— None —")</a>
                            }
                            else
                            {
                                @(_editPrimaryIncidentDisplay ?? "— None —")
                            }
                        </span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showPrimaryIncidentModal = true">
                                <i class="bi bi-clipboard2-pulse me-1"></i>@(_editPrimaryIncidentId.HasValue ? "Change" : "Assign") Incident
                            </button>
                            @if (_editPrimaryIncidentId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear primary incident" title="Clear primary incident" @onclick="ClearPrimaryIncident">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="record-field-span-full">
                    <label class="form-label mb-1">Location</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">@if (!_modifyMode && _editLocationRecordNumber.HasValue) {
                            <a href="/locations/@_editLocationRecordNumber" class="record-reference-link">@_editLocationDisplay</a>
                        } else { @(_editLocationDisplay ?? "— None —") }</span>
                        @if (_modifyMode)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showLocationModal = true">
                                <i class="bi bi-geo-alt me-1"></i>@(_editLocationId.HasValue ? "Change" : "Assign") Location
                            </button>
                            @if (_editLocationId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned location" title="Clear assigned location" @onclick="ClearLocation">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        }
                    </div>
                    <LocationMiniMap LocationId="_editLocationId" />
                </div>
            </div>
        </div>
    </div>

    <LocationSearchModal Visible="_showLocationModal"
                         CurrentLocationId="_editLocationId"
                         OnSelected="OnLocationSelected"
                         OnCreated="OnLocationCreatedAsync"
                         OnCleared="OnLocationCleared"
                         OnCancelled="() => _showLocationModal = false" />

    <NameSearchModal Visible="_showNameModal"
                     CurrentNameId="_editNameId"
                     OnSelected="OnNameSelected"
                     OnCreated="OnNameCreatedAsync"
                     OnCleared="OnNameCleared"
                     OnCancelled="() => _showNameModal = false" />

    <IncidentSearchModal Visible="_showPrimaryIncidentModal"
                         CurrentIncidentId="_editPrimaryIncidentId"
                         OnSelected="OnPrimaryIncidentSelected"
                         OnCreated="OnIncidentCreatedAsync"
                         OnCleared="OnPrimaryIncidentCleared"
                         OnCancelled="() => _showPrimaryIncidentModal = false" />

    <RecordChargesSection Title="Charges"
                          EmptyTitle="No charges linked."
                          EmptyHint="Add one or more charges in modify mode for this arrest."
                          Charges="VisibleCharges"
                          ModifyMode="_modifyMode"
                          OnChargeSelected="LinkChargeAsync"
                          OnChargeRemoved="UnlinkChargeAsync" />

    <!-- Linked Incidents -->
    <div class="record-related-section">
        <div class="record-related-header">
            <h4 class="record-related-title">Linked Incidents</h4>
        </div>
        <div class="record-related-body">
        @if (VisibleLinkedIncidents is null)
        {
            <LoadingSpinner Message="Loading linked incidents..." />
        }
        else if (!VisibleLinkedIncidents.Any())
        {
            <div class="record-related-empty-state">
                <div class="empty-state">
                    <i class="bi bi-link-45deg"></i>
                    <div class="fw-medium">No linked incidents.</div>
                    <div class="small mt-1">Link this arrest to an incident in modify mode when case association is needed.</div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>#</th><th>Incident</th><th>Linked At</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in VisibleLinkedIncidents)
                    {
                        <tr>
                            <td>@link.IncidentRecordNumber</td>
                            <td>@link.IncidentNum</td>
                            <td>@link.LinkedAtUtc.ToShortDateString()</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" href="/incidents/@link.IncidentRecordNumber">View</a>
                                @if (_modifyMode)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => UnlinkFromIncidentAsync(link.IncidentId)">Unlink</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_modifyMode)
        {
            <div class="record-link-picker">
                <select class="form-select form-select-sm" @bind="_linkIncidentId">
                    <option value="@Guid.Empty">— select incident to link —</option>
                    @if (_allIncidents is not null)
                    {
                        @foreach (var i in _allIncidents)
                        {
                            <option value="@i.Id">@i.RecordNumber — @i.Details.IncidentNum</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="LinkToIncidentAsync"
                        disabled="@(_linkIncidentId == Guid.Empty)">+ Link</button>
            </div>
        }
        </div>
    </div>

    <MugshotGallery ArrestId="_arrest.Id" CanModify="_modifyMode" />

    @if (_modifyMode)
    {
        <div class="record-save-row mb-4">
            <button class="btn btn-sm btn-primary" @onclick="SaveRecordAsync">
                <i class="bi bi-floppy-fill me-1"></i>Save
            </button>
        </div>
    }
    <AuditInfoSection CreatedAt="@_arrest.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_arrest.ModifiedBy.HasValue ? _arrest.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
}

@code {
    [Parameter] public long? IncidentRecordNumber { get; set; }
    [Parameter] public long RecordNumber { get; set; }

    private string DetailsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/arrests/{RecordNumber}"
            : $"/arrests/{RecordNumber}";

    private string RelationshipsTabUrl =>
        IncidentRecordNumber.HasValue
            ? $"/incidents/{IncidentRecordNumber.Value}/arrests/{RecordNumber}/relationships"
            : $"/arrests/{RecordNumber}/relationships";

    private Guid _arrestId;
    private ArrestDto? _arrest;
    private IReadOnlyList<IncidentArrestLinkDto>? _linkedIncidents;
    private IReadOnlyList<RecordChargeDto>? _charges;
    private IReadOnlyList<IncidentDto>? _allIncidents;
    private Guid _linkIncidentId = Guid.Empty;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    private Guid? _editNameId;
    private string? _editNameDisplay;
    private long? _editNameRecordNumber;
    private DateTime _editArrestedAt = DateTime.Now;
    private string _editArrestNum = string.Empty;
    private bool _generatingArrestNum;
    private Guid? _editArrestTypeId;
    private string? _arrestTypeLabel;
    private bool _arrestTypeRequired;
    private Guid? _editPrimaryIncidentId;
    private string? _editPrimaryIncidentDisplay;
    private long? _editPrimaryIncidentRecordNumber;
    private bool _showNameModal;
    private bool _showPrimaryIncidentModal;
    private Guid?  _editLocationId;
    private string? _editLocationDisplay;
    private long?  _editLocationRecordNumber;
    private bool   _showLocationModal;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;
    private readonly Dictionary<Guid, (ChargeDto Charge, DateTime LinkedAtUtc)> _pendingChargeAdds = [];
    private readonly HashSet<Guid> _pendingChargeRemoves = [];
    private readonly Dictionary<Guid, (IncidentDto Incident, DateTime LinkedAtUtc)> _pendingIncidentLinkAdds = [];
    private readonly HashSet<Guid> _pendingIncidentLinkRemoves = [];
    private readonly List<string> _createdForeignRecords = [];

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveRecordAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_arrest is not null && _arrest.IsLocked && _arrest.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            _editNameId                   = _arrest.NameId;
            _editNameDisplay              = _arrest.SuspectName;
            _editNameRecordNumber         = _arrest.NameRecordNumber;
            _editArrestedAt               = _arrest.ArrestedAt;
            _editArrestNum                = _arrest.ArrestNum;
            _editArrestTypeId             = _arrest.ArrestTypeId;
            _editPrimaryIncidentId        = _arrest.PrimaryIncidentId;
            _editPrimaryIncidentDisplay   = FormatIncidentDisplay(_arrest);
            _editPrimaryIncidentRecordNumber = _arrest.PrimaryIncidentRecordNumber;
            _editLocationId               = _arrest.LocationId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _arrest = await ArrestService.GetByRecordNumberAsync(RecordNumber);
            if (_arrest is not null)
                _arrestId = _arrest.Id;
            if (_arrest is null) _error = "Arrest not found.";

            if (_arrest is not null && !_modifyMode)
            {
                _editNameId                    = _arrest.NameId;
                _editNameDisplay               = _arrest.SuspectName;
                _editNameRecordNumber          = _arrest.NameRecordNumber;
                _editArrestedAt                = _arrest.ArrestedAt;
                _editArrestNum                 = _arrest.ArrestNum;
                _editArrestTypeId              = _arrest.ArrestTypeId;
                _editPrimaryIncidentId         = _arrest.PrimaryIncidentId;
                _editPrimaryIncidentDisplay    = FormatIncidentDisplay(_arrest);
                _editPrimaryIncidentRecordNumber = _arrest.PrimaryIncidentRecordNumber;
                _editLocationId                = _arrest.LocationId;
                await ResolveLocationDisplayAsync();
            }

            if (_arrest is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_arrest.CreatedBy);
                _modifiedByName = _arrest.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_arrest.ModifiedBy.Value)
                    : null;
                _lockedByName = _arrest.IsLocked && _arrest.LockedByUserId.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_arrest.LockedByUserId.Value)
                    : null;

                _linkedIncidents = await ArrestService.GetLinkedIncidentsAsync(_arrestId);
                _charges = await ChargeService.GetByArrestAsync(_arrestId);

                if (_modifyMode)
                    _allIncidents = await IncidentService.GetByJurisdictionAsync();

                // Resolve ArrestType label for read-only display
                var setting = await PicklistService.GetSettingAsync(PicklistTypes.ArrestType);
                _arrestTypeRequired = setting?.IsRequired ?? false;
                if (_arrest.ArrestTypeId.HasValue)
                {
                    var labels = await PicklistService.GetItemsByIdsAsync([_arrest.ArrestTypeId.Value]);
                    _arrestTypeLabel = labels.GetValueOrDefault(_arrest.ArrestTypeId.Value);
                }
                else
                {
                    _arrestTypeLabel = null;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await ArrestService.AcquireLockAsync(_arrestId);
            _modifyMode = true;
            _editNameId                    = _arrest?.NameId;
            _editNameDisplay               = _arrest?.SuspectName;
            _editNameRecordNumber          = _arrest?.NameRecordNumber;
            _editArrestedAt                = _arrest?.ArrestedAt ?? DateTime.Now;
            _editArrestNum                 = _arrest?.ArrestNum ?? string.Empty;
            _editArrestTypeId              = _arrest?.ArrestTypeId;
            _editPrimaryIncidentId         = _arrest?.PrimaryIncidentId;
            _editPrimaryIncidentDisplay    = _arrest is null ? null : FormatIncidentDisplay(_arrest);
            _editPrimaryIncidentRecordNumber = _arrest?.PrimaryIncidentRecordNumber;
            _editLocationId                = _arrest?.LocationId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        ClearPendingChanges();
        try { await ArrestService.ReleaseLockAsync(_arrestId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editNameId, _editArrestedAt, _editArrestNum, _editArrestTypeId, _editPrimaryIncidentId, _editLocationId);

    private bool HasPendingChanges =>
        _modifyMode &&
        (_editSnapshot != ComputeEditSnapshot()
         || _pendingChargeAdds.Count > 0
         || _pendingChargeRemoves.Count > 0
         || _pendingIncidentLinkAdds.Count > 0
         || _pendingIncidentLinkRemoves.Count > 0
         || _createdForeignRecords.Count > 0);

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/arrests/create");
            }
        }
        else
        {
            Nav.NavigateTo("/arrests/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
    }

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await SaveRecordAsync();
        if (_actionError is null)
        {
            await ExitModifyModeAsync();
            if (navigateToNew) Nav.NavigateTo("/arrests/create");
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await ExitModifyModeAsync();
        if (navigateToNew) Nav.NavigateTo("/arrests/create");
    }

    private async Task GenerateArrestNumAsync()
    {
        _generatingArrestNum = true;
        try { _editArrestNum = await ConfigService.GenerateArrestNumAsync(); }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _generatingArrestNum = false; }
    }

    private void OnArrestedAtChanged(ChangeEventArgs e)
    {
        if (DateTimeLocalInputHelper.TryParse(e.Value?.ToString(), out var arrestedAt))
        {
            _editArrestedAt = arrestedAt;
        }
    }

    private async Task SaveRecordAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;
        if (!_editNameId.HasValue)
        {
            _actionError = "A linked name is required before saving.";
            return;
        }
        try
        {
            await ArrestService.UpdateDetailsAsync(_arrestId, _editNameId.Value, _editArrestedAt, _editArrestTypeId, _editArrestNum, _editLocationId, _editPrimaryIncidentId);
            await ApplyPendingIncidentLinkChangesAsync();
            await ApplyPendingChargeChangesAsync();
            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            ClearPendingChanges();
            _saveSuccessMessage = "Record saved successfully.";
            _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
            {
                _saveSuccessMessage = null;
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            try { await LoadAsync(); } catch { _actionError += " (State may be out of sync — please refresh the page.)"; }
        }
    }

    private async Task LinkToIncidentAsync()
    {
        if (_linkIncidentId == Guid.Empty) return;
        if (_pendingIncidentLinkRemoves.Remove(_linkIncidentId))
        {
            _linkIncidentId = Guid.Empty;
            return;
        }

        if ((_linkedIncidents?.Any(link => link.IncidentId == _linkIncidentId) ?? false) || _pendingIncidentLinkAdds.ContainsKey(_linkIncidentId))
        {
            _linkIncidentId = Guid.Empty;
            return;
        }

        var incident = _allIncidents?.FirstOrDefault(i => i.Id == _linkIncidentId);
        if (incident is not null)
            _pendingIncidentLinkAdds[_linkIncidentId] = (incident, DateTime.UtcNow);

        _linkIncidentId = Guid.Empty;
    }

    private Task UnlinkFromIncidentAsync(Guid incidentId)
    {
        if (_pendingIncidentLinkAdds.Remove(incidentId))
            return Task.CompletedTask;

        if (_linkedIncidents?.Any(link => link.IncidentId == incidentId) == true)
            _pendingIncidentLinkRemoves.Add(incidentId);

        return Task.CompletedTask;
    }

    private Task LinkChargeAsync(ChargeDto charge)
    {
        if (_pendingChargeRemoves.Remove(charge.Id))
            return Task.CompletedTask;

        if ((_charges?.Any(c => c.ChargeId == charge.Id) ?? false) || _pendingChargeAdds.ContainsKey(charge.Id))
            return Task.CompletedTask;

        _pendingChargeAdds[charge.Id] = (charge, DateTime.UtcNow);
        return Task.CompletedTask;
    }

    private Task UnlinkChargeAsync(Guid chargeId)
    {
        if (_pendingChargeAdds.Remove(chargeId))
            return Task.CompletedTask;

        if (_charges?.Any(c => c.ChargeId == chargeId) == true)
            _pendingChargeRemoves.Add(chargeId);

        return Task.CompletedTask;
    }


@page "/arrests/{RecordNumber:long}"
@page "/incidents/{IncidentRecordNumber:long}/arrests/{RecordNumber:long}"
@implements IAsyncDisposable
@inject IArrestService ArrestService
@inject IIncidentService IncidentService
@inject IPicklistService PicklistService
@inject IAgencyConfigurationService ConfigService
@inject ITenantProvider TenantProvider
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@using Modules.Records.Domain.Common
@using Modules.Records.UI.Services

<PageTitle>Arrest Details</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_arrest is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/arrests">Arrests</a></li>
            @if (IncidentRecordNumber.HasValue)
            {
                <li class="breadcrumb-item"><a href="/incidents/@IncidentRecordNumber">Incident</a></li>
            }
            <li class="breadcrumb-item active">Arrest #@RecordNumber</li>
        </ol>
    </nav>

    <div class="page-header">
        <div>
            <h2 class="page-header-title"><i class="bi bi-person-badge-fill"></i> Arrest Record</h2>
            <div class="page-header-sub">
                @(string.IsNullOrWhiteSpace(_arrest.ArrestNum)
                    ? $"Arrest #{RecordNumber}"
                    : _arrest.ArrestNum)
            </div>
        </div>
        <div class="d-flex gap-2">
            <StatusBadge Status="@_arrest.Status" />
            <LockBadge IsLocked="@_arrest.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    @if (_actionError is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_actionError
            <button type="button" class="btn-close" @onclick="() => _actionError = null"></button>
        </div>
    }

    @if (_saveSuccessMessage is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @_saveSuccessMessage
            <button type="button" class="btn-close" @onclick="() => _saveSuccessMessage = null"></button>
        </div>
    }

    <!-- Modify Mode Bar -->
    <div class="mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <button class="btn btn-sm btn-outline-dark ms-auto" title="Release Record (Esc)" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release<ShortcutHint Action="release" /></button>
            </div>
        }
        else if (_arrest.IsLocked && _arrest.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" title="Modify (F2)" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify<ShortcutHint Action="modify" /></button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar mb-4 d-flex flex-wrap gap-2">
            @if (_arrest.Status == "Draft")
            {
                <button class="btn btn-success btn-sm" @onclick="OpenAsync">Open</button>
            }
            @if (_arrest.Status == "Open")
            {
                <button class="btn btn-info btn-sm" @onclick="FinalizeAsync">Finalize</button>
                <button class="btn btn-warning btn-sm" @onclick="CloseAsync">Close</button>
            }
            @if (_arrest.Status is "Closed")
            {
                <button class="btn btn-secondary btn-sm" @onclick="ArchiveAsync">Archive</button>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Arrest"
                   Message="Are you sure you want to delete this arrest record?"
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Arrest Fields (always visible; inputs become editable in modify mode) -->
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Arrest Details</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label mb-1">Suspect Name</label>
                    <input type="text" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editSuspectName" placeholder="—" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label mb-1">Arrested At</label>
                    <input type="datetime-local" class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                           readonly="@(!_modifyMode)"
                           @bind="_editArrestedAt" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label mb-1">Arrest Number</label>
                    @if (_modifyMode)
                    {
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control form-control-sm"
                                   @bind="_editArrestNum" placeholder="e.g. AR-2026-000001" />
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="GenerateArrestNumAsync" disabled="@_generatingArrestNum">
                                @(_generatingArrestNum ? "…" : "🔁")
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(string.IsNullOrWhiteSpace(_arrest.ArrestNum) ? "—" : _arrest.ArrestNum)</p>
                    }
                </div>
                <div class="col-sm-6">
                    <label class="form-label mb-1">Arrest Type</label>
                    @if (_modifyMode)
                    {
                        <PicklistSelect PicklistType="@PicklistTypes.ArrestType"
                                        @bind-Value="_editArrestTypeId"
                                        IsRequired="@_arrestTypeRequired" />
                    }
                    else
                    {
                        <p class="form-control-plaintext form-control-sm ps-0">@(_arrestTypeLabel ?? "—")</p>
                    }
                </div>
            </div>
            @if (_modifyMode)
            {
                <div class="mt-3">
                    <button class="btn btn-sm btn-primary" title="Save Details (Alt+S)" @onclick="SaveDetailsAsync">Save Details<ShortcutHint Action="save" /></button>
                </div>
            }
        </div>
    </div>

    <AuditInfoSection CreatedAt="@_arrest.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_arrest.ModifiedBy.HasValue ? _arrest.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />

    <!-- Linked Incidents -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4>Linked Incidents</h4>
        </div>
        @if (_linkedIncidents is null)
        {
            <p>Loading…</p>
        }
        else if (!_linkedIncidents.Any())
        {
            <p class="text-muted">Not linked to any incidents.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr><th>#</th><th>Incident</th><th>Linked At</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var link in _linkedIncidents)
                    {
                        <tr>
                            <td>@link.IncidentRecordNumber</td>
                            <td>@link.IncidentNum</td>
                            <td>@link.LinkedAtUtc.ToShortDateString()</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary" href="/incidents/@link.IncidentRecordNumber">View</a>
                                @if (_modifyMode)
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => UnlinkFromIncidentAsync(link.IncidentId)">Unlink</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (_modifyMode)
        {
            <div class="d-flex gap-2 mt-2 align-items-center">
                <select class="form-select form-select-sm" style="max-width:300px" @bind="_linkIncidentId">
                    <option value="@Guid.Empty">— select incident to link —</option>
                    @if (_allIncidents is not null)
                    {
                        @foreach (var i in _allIncidents)
                        {
                            <option value="@i.Id">@i.RecordNumber — @i.Details.IncidentNum</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="LinkToIncidentAsync"
                        disabled="@(_linkIncidentId == Guid.Empty)">+ Link</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public long? IncidentRecordNumber { get; set; }
    [Parameter] public long RecordNumber { get; set; }

    private Guid _arrestId;
    private ArrestDto? _arrest;
    private IReadOnlyList<IncidentArrestLinkDto>? _linkedIncidents;
    private IReadOnlyList<IncidentDto>? _allIncidents;
    private Guid _linkIncidentId = Guid.Empty;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private string? _saveSuccessMessage;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private static readonly TimeSpan LockTimeout = TimeSpan.FromMinutes(10);

    private string _editSuspectName = string.Empty;
    private DateTime _editArrestedAt = DateTime.Now;
    private string _editArrestNum = string.Empty;
    private bool _generatingArrestNum;
    private Guid? _editArrestTypeId;
    private string? _arrestTypeLabel;
    private bool _arrestTypeRequired;

    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveDetailsAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_arrest is not null && _arrest.IsLocked && _arrest.LockedByUserId == _currentUserId)
        {
            _modifyMode = true;
            _editSuspectName  = _arrest.SuspectName;
            _editArrestedAt   = _arrest.ArrestedAt;
            _editArrestNum    = _arrest.ArrestNum;
            _editArrestTypeId = _arrest.ArrestTypeId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _arrest = await ArrestService.GetByRecordNumberAsync(RecordNumber);
            if (_arrest is not null)
                _arrestId = _arrest.Id;
            if (_arrest is null) _error = "Arrest not found.";

            if (_arrest is not null && !_modifyMode)
            {
                _editSuspectName  = _arrest.SuspectName;
                _editArrestedAt   = _arrest.ArrestedAt;
                _editArrestNum    = _arrest.ArrestNum;
                _editArrestTypeId = _arrest.ArrestTypeId;
            }

            if (_arrest is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_arrest.CreatedBy);
                _modifiedByName = _arrest.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_arrest.ModifiedBy.Value)
                    : null;
                _lockedByName = _arrest.IsLocked && _arrest.LockedByUserId.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_arrest.LockedByUserId.Value)
                    : null;

                _linkedIncidents = await ArrestService.GetLinkedIncidentsAsync(_arrestId);

                if (_modifyMode)
                    _allIncidents = await IncidentService.GetByJurisdictionAsync();

                // Resolve ArrestType label for read-only display
                var setting = await PicklistService.GetSettingAsync(PicklistTypes.ArrestType);
                _arrestTypeRequired = setting?.IsRequired ?? false;
                if (_arrest.ArrestTypeId.HasValue)
                {
                    var labels = await PicklistService.GetItemsByIdsAsync([_arrest.ArrestTypeId.Value]);
                    _arrestTypeLabel = labels.GetValueOrDefault(_arrest.ArrestTypeId.Value);
                }
                else
                {
                    _arrestTypeLabel = null;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _actionError = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await ArrestService.AcquireLockAsync(_arrestId);
            _modifyMode = true;
            _editSuspectName  = _arrest?.SuspectName ?? string.Empty;
            _editArrestedAt   = _arrest?.ArrestedAt ?? DateTime.Now;
            _editArrestNum    = _arrest?.ArrestNum ?? string.Empty;
            _editArrestTypeId = _arrest?.ArrestTypeId;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        try { await ArrestService.ReleaseLockAsync(_arrestId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editSuspectName, _editArrestedAt, _editArrestNum, _editArrestTypeId);

    private bool HasPendingChanges => _modifyMode && _editSnapshot != ComputeEditSnapshot();

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/arrests/create");
            }
        }
        else
        {
            Nav.NavigateTo("/arrests/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
    }

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await SaveDetailsAsync();
        if (_actionError is null)
        {
            await ExitModifyModeAsync();
            if (navigateToNew) Nav.NavigateTo("/arrests/create");
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var navigateToNew = _pendingNewRecord;
        _pendingNewRecord = false;
        await ExitModifyModeAsync();
        if (navigateToNew) Nav.NavigateTo("/arrests/create");
    }

    private async Task GenerateArrestNumAsync()
    {
        _generatingArrestNum = true;
        try { _editArrestNum = await ConfigService.GenerateArrestNumAsync(); }
        catch (Exception ex) { _actionError = ex.Message; }
        finally { _generatingArrestNum = false; }
    }

    private async Task SaveDetailsAsync()
    {
        _actionError = null;
        _saveSuccessMessage = null;
        try
        {
            await ArrestService.UpdateDetailsAsync(_arrestId, _editSuspectName, _editArrestedAt, _editArrestTypeId, _editArrestNum);
            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            _saveSuccessMessage = "Details saved successfully.";
            _ = Task.Delay(3000).ContinueWith(_ => InvokeAsync(() =>
            {
                _saveSuccessMessage = null;
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task LinkToIncidentAsync()
    {
        if (_linkIncidentId == Guid.Empty) return;
        await RunActionAsync(() => ArrestService.LinkToIncidentAsync(_arrestId, _linkIncidentId));
        _linkIncidentId = Guid.Empty;
    }

    private Task UnlinkFromIncidentAsync(Guid incidentId) =>
        RunActionAsync(() => ArrestService.UnlinkFromIncidentAsync(_arrestId, incidentId));

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)LockTimeout.TotalSeconds;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    private Task OpenAsync()        => RunActionAsync(() => ArrestService.OpenAsync(_arrestId));
    private Task CloseAsync()       => RunActionAsync(() => ArrestService.CloseAsync(_arrestId));
    private Task ArchiveAsync()     => RunActionAsync(() => ArrestService.ArchiveAsync(_arrestId));
    private Task FinalizeAsync()    => RunActionAsync(() => ArrestService.FinalizeAsync(_arrestId));

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        await RunActionAsync(() => ArrestService.SoftDeleteAsync(_arrestId));
        if (IncidentRecordNumber.HasValue)
            Nav.NavigateTo($"/incidents/{IncidentRecordNumber}");
        else
            Nav.NavigateTo("/arrests");
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        StopLockTimer();
        return ValueTask.CompletedTask;
    }

}

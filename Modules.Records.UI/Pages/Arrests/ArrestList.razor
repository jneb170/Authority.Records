@page "/arrests"
@implements IDisposable
@inject IArrestService ArrestService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject IUserLookupService UserLookupService
@using Modules.Records.UI.Services

<PageTitle>Arrests</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-person-badge-fill"></i> Arrests</h2>
        <div class="page-header-sub">Arrest Records</div>
    </div>
    <a class="btn btn-primary" href="/arrests/create"><i class="bi bi-plus-lg me-1"></i>New Arrest</a>
</div>

<!-- Search / Filter Panel -->
<div class="card list-filter-card mb-3">
    <div class="card-header list-filter-card-header" @onclick="() => _filterExpanded = !_filterExpanded">
        <span class="list-filter-card-title">
            <i class="bi bi-search me-1"></i>Search / Filter
        </span>
        <i class="bi @(_filterExpanded ? "bi-chevron-up" : "bi-chevron-down") list-filter-card-chevron"></i>
    </div>
@if (_filterExpanded)
{
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-6 col-md-4">
                <label class="form-label mb-1">Suspect name contains</label>
                <input class="form-control form-control-sm" @bind="_filterSuspect" placeholder="Suspect name…" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Arrested from</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateFrom.HasValue ? _filterDateFrom.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateFrom = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Arrested to</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateTo.HasValue ? _filterDateTo.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateTo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label mb-1">Status</label>
                <input class="form-control form-control-sm" @bind="_filterStatus" placeholder="Status…" />
            </div>
        </div>
        <div class="list-filter-actions">
            <button class="btn btn-sm btn-primary" @onclick="ApplySearch">Search</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    </div>
}
</div>

@if (!_loading && _error is null && _arrests is not null)
{
    <div class="list-results-summary">
        <div class="list-results-count">
            <strong>@VisibleCount</strong> arrest record@(VisibleCount == 1 ? string.Empty : "s")
        </div>
        <div class="list-results-flags">
            @if (ActiveFilterCount > 0)
            {
                <span class="list-summary-chip">
                    <i class="bi bi-funnel-fill"></i>
                    <span>@ActiveFilterCount filter@(ActiveFilterCount == 1 ? string.Empty : "s") applied</span>
                </span>
            }
        </div>
    </div>
}

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_arrests is not null)
{
    @if (!_arrests.Any())
    {
        <div class="table-responsive list-table-shell">
            <div class="empty-state">
                <i class="bi bi-person-x"></i>
                <div class="fw-medium">No arrests recorded.</div>
                <div class="small mt-1">Create an arrest record to begin tracking custodial actions.</div>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive list-table-shell">
        <table class="table table-hover list-page-table">
            <thead>
                <tr>
                    <th style="width:3rem"></th>
                    <SortableColumnHeader ColumnKey="num"       Label="#"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="arrestnum" Label="Arrest #"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="suspect"   Label="Suspect"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="arrestedat" Label="Arrested At"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <SortableColumnHeader ColumnKey="status"    Label="Status"
                        CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                    <th>Lock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in SortedArrests)
                {
                    <tr>
                        <td>
                            <button class="btn btn-sm row-delete-button" title="Delete arrest" aria-label="Delete arrest"
                                    @onclick="() => InitiateDelete(a.Id, a.ArrestNum)"><i class="bi bi-trash3"></i></button>
                        </td>
                        <td><a href="/arrests/@a.RecordNumber">@a.RecordNumber</a></td>
                        <td><a href="/arrests/@a.RecordNumber">@a.ArrestNum</a></td>
                        <td>@a.SuspectName</td>
                        <td>@a.ArrestedAt.ToShortDateString()</td>
                        <td><StatusBadge Status="@a.Status" /></td>
                        <td><LockBadge IsLocked="@a.IsLocked" LockedByName="@GetLockName(a.LockedByUserId)" Compact="true" /></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="Delete Arrest"
               Message="@($"Are you sure you want to delete arrest \"{_deleteTargetName}\"?")"
               OnConfirm="ExecuteDeleteAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private bool _filterExpanded = false;
    private IReadOnlyList<ArrestDto>? _arrests;
    private Dictionary<Guid, string> _lockUserNames = [];
    private bool _loading = true;
    private string? _error;

    // Delete state
    private bool   _showDeleteConfirm;
    private Guid   _deleteTargetId;
    private string _deleteTargetName = string.Empty;

    private string _sortColumn    = "num";
    private bool   _sortAscending = false;

    // Filter state
    private string    _filterSuspect  = string.Empty;
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;
    private string    _filterStatus   = string.Empty;
    private int VisibleCount => FilteredArrests.Count();
    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(_filterSuspect) ? 0 : 1) +
        (_filterDateFrom.HasValue ? 1 : 0) +
        (_filterDateTo.HasValue ? 1 : 0) +
        (string.IsNullOrWhiteSpace(_filterStatus) ? 0 : 1);

    private IEnumerable<ArrestDto> FilteredArrests =>
        _arrests is null ? [] :
        _arrests.Where(a =>
            (string.IsNullOrWhiteSpace(_filterSuspect)  || (a.SuspectName?.Contains(_filterSuspect, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!_filterDateFrom.HasValue || a.ArrestedAt.Date >= _filterDateFrom.Value.Date) &&
            (!_filterDateTo.HasValue   || a.ArrestedAt.Date <= _filterDateTo.Value.Date) &&
            (string.IsNullOrWhiteSpace(_filterStatus)   || (a.Status?.Contains(_filterStatus, StringComparison.OrdinalIgnoreCase) ?? false)));

    private IEnumerable<ArrestDto> SortedArrests =>
        (_sortColumn, _sortAscending) switch
        {
            ("num",        true)  => FilteredArrests.OrderBy(x => x.RecordNumber),
            ("num",        false) => FilteredArrests.OrderByDescending(x => x.RecordNumber),
            ("arrestnum",  true)  => FilteredArrests.OrderBy(x => x.ArrestNum),
            ("arrestnum",  false) => FilteredArrests.OrderByDescending(x => x.ArrestNum),
            ("suspect",    true)  => FilteredArrests.OrderBy(x => x.SuspectName),
            ("suspect",    false) => FilteredArrests.OrderByDescending(x => x.SuspectName),
            ("arrestedat", true)  => FilteredArrests.OrderBy(x => x.ArrestedAt),
            ("arrestedat", false) => FilteredArrests.OrderByDescending(x => x.ArrestedAt),
            ("status",     true)  => FilteredArrests.OrderBy(x => x.Status),
            _                     => FilteredArrests.OrderByDescending(x => x.Status),
        };

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    protected override async Task OnInitializedAsync()
    {
        ShortcutService.OnNew += HandleShortcutNew;
        try
        {
            _arrests = await ArrestService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleShortcutNew() => InvokeAsync(() => Nav.NavigateTo("/arrests/create"));

    public void Dispose() => ShortcutService.OnNew -= HandleShortcutNew;

    private string? GetLockName(Guid? userId) =>
        userId.HasValue ? _lockUserNames.GetValueOrDefault(userId.Value) : null;

    private async Task ResolveLockedNamesAsync()
    {
        if (_arrests is null) return;
        var ids = _arrests.Where(a => a.IsLocked && a.LockedByUserId.HasValue)
                          .Select(a => a.LockedByUserId!.Value).Distinct();
        _lockUserNames = await UserLookupService.GetDisplayNamesAsync(ids);
    }

    private void InitiateDelete(Guid id, string name)
    {
        _deleteTargetId    = id;
        _deleteTargetName  = name;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        _showDeleteConfirm = false;
        try
        {
            await ArrestService.SoftDeleteAsync(_deleteTargetId);
            _arrests = await ArrestService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void ApplySearch() => StateHasChanged();

    private void ClearFilters()
    {
        _filterSuspect  = string.Empty;
        _filterDateFrom = null;
        _filterDateTo   = null;
        _filterStatus   = string.Empty;
        StateHasChanged();
    }
}

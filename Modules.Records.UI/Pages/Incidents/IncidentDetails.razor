@page "/incidents/{RecordNumber:long}"
@implements IAsyncDisposable
@using IncidentDetailsVo = Modules.Records.Domain.ValueObjects.IncidentDetails
@using Modules.Records.Application.Abstractions
@using Modules.Records.Domain.Abstractions
@inject IIncidentService IncidentService
@inject IArrestService ArrestService
@inject ICitationService CitationService
@inject IChargeService ChargeService
@inject ILocationService LocationService
@inject IAgencyConfigurationService ConfigService
@inject ITenantProvider TenantProvider
@inject IActiveAgencyContext ActiveAgencyContext
@inject IUserLookupService UserLookupService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@using Modules.Records.UI.Services
@using Modules.Records.Domain.Common.Exceptions

<PageTitle>Incident Details</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_incident is not null)
{
    <div style="display:contents" @onchange="OnEditActivity">
    <NavigationLock ConfirmExternalNavigation="@HasPendingChanges"
                    OnBeforeInternalNavigation="HandleInternalNavigation" />
    <nav aria-label="breadcrumb" class="record-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/incidents">Incidents</a></li>
            <li class="breadcrumb-item active">Incident #@RecordNumber</li>
        </ol>
    </nav>

    <div class="page-header record-page-header">
        <div>
            <h1 class="page-header-title"><i class="bi bi-clipboard2-pulse-fill"></i> Incident Report</h1>
            <div class="page-header-sub">
                @(string.IsNullOrWhiteSpace(_incident.Details.IncidentNum)
                    ? $"Incident #{RecordNumber}"
                    : _incident.Details.IncidentNum)
            </div>
        </div>
        <div class="d-flex gap-2 record-header-meta">
            <StatusBadge Status="@_incident.Status" />
            <LockBadge IsLocked="@_incident.IsLocked" LockedByName="@_lockedByName" />
        </div>
    </div>

    <RecordDetailsTabs DetailsUrl="@DetailsTabUrl"
                       RelationshipsUrl="@RelationshipsTabUrl"
                       ActiveTab="Details" />

    <StatusMessage Kind="error" Message="@_actionError" OnDismiss="() => _actionError = null" />
    <StatusMessage Kind="success" Message="@_successMessage" OnDismiss="() => _successMessage = null" />

    <!-- Modify Mode Bar -->
    <div class="record-toolbar mb-3">
        @if (_modifyMode)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 py-2 mb-2 record-mode-banner">
                <span><i class="bi bi-pencil-fill me-1"></i><strong>Modify mode</strong> — lock expires in @_lockSecondsRemaining s</span>
                <div class="record-mode-actions">
                    <BusyButton Class="btn btn-sm btn-primary" OnClick="SaveRecordAsync" BusyText="Saving…">
                        <i class="bi bi-floppy-fill me-1"></i>Save
                    </BusyButton>
                    <button class="btn btn-sm btn-outline-dark" @onclick="RequestReleaseAsync"><i class="bi bi-unlock-fill me-1"></i>Release</button>
                </div>
            </div>
        }
        else if (_incident.IsLocked && _incident.LockedByUserId != _currentUserId)
        {
            <div class="alert alert-secondary py-2 mb-2">
                <i class="bi bi-lock-fill me-1"></i>Record is locked by @(_lockedByName ?? "another user") — read only
            </div>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="EnterModifyModeAsync"><i class="bi bi-pencil-fill me-1"></i>Modify</button>
        }
    </div>

    <!-- Action Bar (only in modify mode) -->
    @if (_modifyMode)
    {
        <div class="action-bar record-action-bar mb-4 d-flex flex-wrap gap-2">
            @if (_incident.Status == "Draft")
            {
                <BusyButton Class="btn btn-success btn-sm" OnClick="OpenAsync" BusyText="Opening…">Open</BusyButton>
            }
            @if (_incident.Status == "Open")
            {
                <BusyButton Class="btn btn-warning btn-sm" OnClick="CloseAsync" BusyText="Closing…">Close</BusyButton>
            }
            @if (_incident.Status is "Closed")
            {
                <BusyButton Class="btn btn-secondary btn-sm" OnClick="ArchiveAsync" BusyText="Archiving…">Archive</BusyButton>
            }
            @if (!_incident.IsDeleted)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="() => _showDeleteConfirm = true">Delete</button>
            }
            else
            {
                <BusyButton Class="btn btn-outline-success btn-sm" OnClick="RestoreAsync" BusyText="Restoring…">Restore</BusyButton>
            }
        </div>
    }

    <ConfirmDialog Visible="_showDeleteConfirm"
                   Title="Delete Incident"
                   Message="Are you sure you want to delete this incident? This action can be reversed."
                   OnConfirm="SoftDeleteAsync"
                   OnCancel="() => _showDeleteConfirm = false" />

    <UnsavedChangesDialog Visible="_showReleaseConfirm"
                          SaveLabel="@(_pendingNewRecord ? "Save & New" : "Save & Release")"
                          DiscardLabel="@(_pendingNewRecord ? "Discard & New" : "Discard")"
                          ActionDescription="@(_pendingNewRecord ? "creating a new record" : "releasing the record")"
                          WarningMessage="@GetReleaseWarningMessage()"
                          OnSaveAndRelease="SaveAndReleaseAsync"
                          OnDiscard="DiscardAndReleaseAsync"
                          OnCancel="CancelRelease" />

    <!-- Incident Fields (always visible; inputs become editable in modify mode) -->
    <div class="card record-content-card mb-4">
        <div class="card-body">
            <h6 class="card-title">Incident Details</h6>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="record-grid-3">
                    <FormField Label="Incident Number" For="inc-num" Required="true">
                        <InputText id="inc-num" maxlength="30" readonly="@(!_modifyMode)"
                                   class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   @bind-Value="_editVm.IncidentNum" placeholder="@(_modifyMode ? "(required)" : "—")" />
                        <ValidationMessage For="() => _editVm.IncidentNum" />
                    </FormField>
                    <div class="record-field-span-2">
                        <FormField Label="Description" For="inc-desc">
                            <InputText id="inc-desc" readonly="@(!_modifyMode)"
                                       class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                       @bind-Value="_editVm.Description" placeholder="—" />
                            <ValidationMessage For="() => _editVm.Description" />
                        </FormField>
                    </div>
                    <FormField Label="CFS Number" For="inc-cfs">
                        <InputText id="inc-cfs" maxlength="30" readonly="@(!_modifyMode)"
                                   class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   @bind-Value="_editVm.CFSNum" placeholder="@(_modifyMode ? "(optional)" : "—")" />
                        <ValidationMessage For="() => _editVm.CFSNum" />
                    </FormField>
                    <FormField Label="Local Number" For="inc-local">
                        <InputText id="inc-local" maxlength="30" readonly="@(!_modifyMode)"
                                   class="@(_modifyMode ? "form-control form-control-sm" : "form-control-plaintext form-control-sm ps-0")"
                                   @bind-Value="_editVm.LocalNum" placeholder="@(_modifyMode ? "(optional)" : "—")" />
                        <ValidationMessage For="() => _editVm.LocalNum" />
                    </FormField>
                    <FormField Label="Occurred On" For="inc-occurred">
                        @if (_modifyMode)
                        {
                            <input id="inc-occurred" type="datetime-local" class="form-control form-control-sm"
                                   value="@DateTimeLocalInputHelper.FormatLocal(_editOccurredOn)"
                                   @onchange="OnOccurredOnChanged" />
                        }
                        else
                        {
                            <div class="form-control-plaintext form-control-sm ps-0">
                                @(_editOccurredOn.HasValue ? _editOccurredOn.Value.ToLocalTime().ToString("MM/dd/yyyy HH:mm") : "—")
                            </div>
                        }
                    </FormField>
                    <div class="record-field-span-full">
                        <FormField Label="Location">
                            <div class="d-flex align-items-center gap-2">
                                <span class="@(_modifyMode ? "fw-semibold" : "record-reference-display")">@if (!_modifyMode && _editLocationRecordNumber.HasValue) {
                                    <a href="/locations/@_editLocationRecordNumber" class="record-reference-link">@_editLocationDisplay</a>
                                } else { @(_editLocationDisplay ?? "— None —") }</span>
                                @if (_modifyMode)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showLocationModal = true">
                                        <i class="bi bi-geo-alt me-1"></i>@(_editLocationId.HasValue ? "Change" : "Assign") Location
                                    </button>
                                    @if (_editLocationId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Clear assigned location" title="Clear assigned location" @onclick="ClearLocation">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                }
                            </div>
                            <LocationMiniMap LocationId="_editLocationId" />
                        </FormField>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <LocationSearchModal Visible="_showLocationModal"
                         CurrentLocationId="_editLocationId"
                         OnSelected="OnLocationSelected"
                         OnCreated="OnLocationCreatedAsync"
                         OnCleared="OnLocationCleared"
                         OnCancelled="() => _showLocationModal = false" />

    <!-- Arrests -->
    <div class="record-related-section">
        <div class="record-related-header">
            <h4 class="record-related-title">Arrests</h4>
            @if (_modifyMode)
            {
                <a class="btn btn-sm btn-outline-primary" href="/incidents/@RecordNumber/arrests/create">+ Add Arrest</a>
            }
        </div>
        <div class="record-related-body">
        @if (_arrests is null)
        {
            <LoadingSpinner Message="Loading arrests..." />
        }
        else if (!_arrests.Any())
        {
            <div class="record-related-empty-state">
                <div class="empty-state">
                    <i class="bi bi-person-x"></i>
                    <div class="fw-medium">No arrests recorded.</div>
                    <div class="small mt-1">Add an arrest from modify mode when this incident results in a custodial action.</div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Suspect</th>
                        <th>Arrested At</th>
                        <th>Status</th>
                        <th>Lock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in _arrests)
                    {
                        <tr>
                            <td>@a.SuspectName</td>
                            <td>@a.ArrestedAt.ToShortDateString()</td>
                            <td><StatusBadge Status="@a.Status" /></td>
                            <td><LockBadge IsLocked="@a.IsLocked" LockedByName="@(a.LockedByUserId.HasValue ? _linkLockNames.GetValueOrDefault(a.LockedByUserId.Value) : null)" Compact="true" /></td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/arrests/@a.RecordNumber">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        </div>
    </div>

    <!-- Citations -->
    <div class="record-related-section">
        <div class="record-related-header">
            <h4 class="record-related-title">Citations</h4>
            @if (_modifyMode)
            {
                <a class="btn btn-sm btn-outline-primary" href="/incidents/@RecordNumber/citations/create">+ Add Citation</a>
            }
        </div>
        <div class="record-related-body">
        @if (_citations is null)
        {
            <LoadingSpinner Message="Loading citations..." />
        }
        else if (!_citations.Any())
        {
            <div class="record-related-empty-state">
                <div class="empty-state">
                    <i class="bi bi-file-earmark-minus"></i>
                    <div class="fw-medium">No citations recorded.</div>
                    <div class="small mt-1">Add a citation from modify mode when an enforcement action is issued for this incident.</div>
                </div>
            </div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Issue Date</th>
                        <th>Issued</th>
                        <th>Lock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _citations)
                    {
                        <tr>
                            <td>@c.Description</td>
                            <td>@c.IssueDate.ToShortDateString()</td>
                            <td>
                                <span class="record-pill @(c.IsIssued ? "record-pill-success" : "record-pill-warning")">
                                    <i class="bi @(c.IsIssued ? "bi-check2-circle" : "bi-hourglass-split")" aria-hidden="true"></i>
                                    <span>@(c.IsIssued ? "Issued" : "Pending")</span>
                                </span>
                            </td>
                            <td><LockBadge IsLocked="@c.IsLocked" LockedByName="@(c.LockedByUserId.HasValue ? _linkLockNames.GetValueOrDefault(c.LockedByUserId.Value) : null)" Compact="true" /></td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/citations/@c.RecordNumber">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        </div>
    </div>

    <RecordChargesSection Title="Charges"
                          EmptyTitle="No charges linked."
                          EmptyHint="Add one or more charges in modify mode when the incident needs offense tracking."
                          Charges="VisibleCharges"
                          ModifyMode="_modifyMode"
                          OnChargeSelected="LinkChargeAsync"
                          OnChargeRemoved="UnlinkChargeAsync" />

    @if (_modifyMode)
    {
        <div class="record-save-row mb-4">
            <BusyButton Class="btn btn-sm btn-primary" OnClick="SaveRecordAsync" BusyText="Saving…">
                <i class="bi bi-floppy-fill me-1"></i>Save
            </BusyButton>
        </div>
    }

    <NarrativesSection OwnerType="@NarrativeOwnerTypes.Incident" OwnerId="_incident.Id" CanModify="_modifyMode" />

    <AuditInfoSection CreatedAt="@_incident.CreatedAtUtc"
                      CreatedByName="@_createdByName"
                      ModifiedAt="@(_incident.ModifiedBy.HasValue ? _incident.UpdatedAtUtc : null)"
                      ModifiedByName="@_modifiedByName" />
    </div>
}

@code {
    [Parameter] public long RecordNumber { get; set; }

    private string DetailsTabUrl => $"/incidents/{RecordNumber}";
    private string RelationshipsTabUrl => $"/incidents/{RecordNumber}/relationships";

    private Guid _incidentId;
    private IncidentDto? _incident;
    private IReadOnlyList<ArrestDto>? _arrests;
    private IReadOnlyList<CitationDto>? _citations;
    private IReadOnlyList<RecordChargeDto>? _charges;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;

    private bool _modifyMode;
    private bool _showReleaseConfirm;
    private bool _pendingNewRecord;
    private string _editSnapshot = string.Empty;
    private Guid _currentUserId;
    private int _lockSecondsRemaining;
    private System.Threading.Timer? _lockTimer;
    private TimeSpan _lockTimeout = TimeSpan.FromSeconds(ConfigurationKeys.DefaultLockTimeoutSeconds);
    private DateTime _lastServerRenewUtc;
    private bool _renewing;
    private TimeSpan RenewInterval => TimeSpan.FromSeconds(Math.Max(5, _lockTimeout.TotalSeconds / 3));
    private readonly EditIncidentViewModel _editVm = new();
    private EditContext _editContext = null!;
    private ValidationMessageStore? _serverMessages;
    private Guid?  _editLocationId;
    private string? _editLocationDisplay;
    private long?  _editLocationRecordNumber;
    private bool   _showLocationModal;
    private DateTime? _editOccurredOn;
    private string? _successMessage;
    private string? _pendingNavUri;
    private string? _createdByName;
    private string? _modifiedByName;
    private string? _lockedByName;
    private Dictionary<Guid, string> _linkLockNames = [];
    private readonly Dictionary<Guid, (ChargeDto Charge, DateTime LinkedAtUtc)> _pendingChargeAdds = [];
    private readonly HashSet<Guid> _pendingChargeRemoves = [];
    private readonly List<string> _createdForeignRecords = [];
    private IDisposable? _agencySelectionLock;

    [SupplyParameterFromQuery(Name = "autoModify")]
    public bool AutoModify { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_editVm);
        _serverMessages = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += HandleFieldChanged;

        await ActiveAgencyContext.EnsureLoadedAsync();
        _currentUserId = TenantProvider.GetUserId();
        await LoadAsync();
        await LoadLockTimeoutAsync();

        if (AutoModify)
            await EnterModifyModeAsync();
        else
            RestoreModifyModeIfOwner();

        ShortcutService.OnNew     += HandleShortcutNew;
        ShortcutService.OnModify  += HandleShortcutModify;
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
    }

    private void HandleShortcutNew()
        => InvokeAsync(async () => { await RequestNewAsync(); StateHasChanged(); });

    private void HandleShortcutModify()
        => InvokeAsync(async () => { if (!_modifyMode) { await EnterModifyModeAsync(); StateHasChanged(); } });

    private void HandleShortcutRelease()
        => InvokeAsync(async () => { if (_modifyMode) { await RequestReleaseAsync(); StateHasChanged(); } });

    private void HandleShortcutSave()
        => InvokeAsync(async () => { if (_modifyMode) { await SaveRecordAsync(); StateHasChanged(); } });

    private void RestoreModifyModeIfOwner()
    {
        if (_incident is not null && _incident.IsLocked && _incident.LockedByUserId == _currentUserId)
        {
            EnsureAgencySelectionLock();
            _modifyMode = true;
            _editVm.IncidentNum = _incident.Details.IncidentNum;
            _editVm.LocalNum = _incident.Details.LocalNum;
            _editVm.Description = _incident.Details.Description;
            _editVm.CFSNum = _incident.Details.CFSNum;
            _editLocationId = _incident.LocationId;
            _editOccurredOn = _incident.OccurredOn;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _incident = await IncidentService.GetByRecordNumberAsync(RecordNumber);
            if (_incident is not null)
            {
                _incidentId = _incident.Id;
                var t2 = ArrestService.GetByIncidentAsync(_incidentId);
                var t3 = CitationService.GetByIncidentAsync(_incidentId);
                var t4 = ChargeService.GetByIncidentAsync(_incidentId);
                await Task.WhenAll(t2, t3, t4);
                _arrests   = t2.Result;
                _citations = t3.Result;
                _charges   = t4.Result;
            }

            // Keep edit fields in sync so the unified card always shows current values
            if (_incident is not null && !_modifyMode)
            {
                _editVm.IncidentNum = _incident.Details.IncidentNum;
                _editVm.Description = _incident.Details.Description;
                _editVm.CFSNum      = _incident.Details.CFSNum;
                _editVm.LocalNum    = _incident.Details.LocalNum;
                _editLocationId  = _incident.LocationId;
                _editOccurredOn  = _incident.OccurredOn;
                await ResolveLocationDisplayAsync();
            }

            // Resolve audit display names
            if (_incident is not null)
            {
                _createdByName  = await UserLookupService.GetDisplayNameAsync(_incident.CreatedBy);
                _modifiedByName = _incident.ModifiedBy.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_incident.ModifiedBy.Value)
                    : null;
                _lockedByName = _incident.IsLocked && _incident.LockedByUserId.HasValue
                    ? await UserLookupService.GetDisplayNameAsync(_incident.LockedByUserId.Value)
                    : null;

                // Bulk-resolve lock names for linked arrests and citations
                var linkedIds = (_arrests ?? []).Where(a => a.IsLocked && a.LockedByUserId.HasValue)
                                               .Select(a => a.LockedByUserId!.Value)
                    .Concat((_citations ?? []).Where(c => c.IsLocked && c.LockedByUserId.HasValue)
                                             .Select(c => c.LockedByUserId!.Value))
                    .Distinct();
                _linkLockNames = await UserLookupService.GetDisplayNamesAsync(linkedIds);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunActionAsync(Func<Task> action, string successMessage)
    {
        _actionError = null;
        _successMessage = null;
        try
        {
            await action();
            await LoadAsync();
            _successMessage = successMessage;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task EnterModifyModeAsync()
    {
        _actionError = null;
        try
        {
            await IncidentService.AcquireLockAsync(_incidentId);
            EnsureAgencySelectionLock();
            _modifyMode = true;
            _editVm.IncidentNum = _incident?.Details.IncidentNum ?? string.Empty;
            _editVm.Description = _incident?.Details.Description ?? string.Empty;
            _editVm.CFSNum = _incident?.Details.CFSNum ?? string.Empty;
            _editVm.LocalNum = _incident?.Details.LocalNum ?? string.Empty;
            _editLocationId = _incident?.LocationId;
            _editOccurredOn = _incident?.OccurredOn;
            _editSnapshot = ComputeEditSnapshot();
            StartLockTimer();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private async Task ExitModifyModeAsync()
    {
        StopLockTimer();
        _modifyMode = false;
        ReleaseAgencySelectionLock();
        ClearPendingChanges();
        try { await IncidentService.ReleaseLockAsync(_incidentId); } catch { /* best-effort */ }
        await LoadAsync();
    }

    private void EnsureAgencySelectionLock()
        => _agencySelectionLock ??= ActiveAgencyContext.AcquireSelectionLock();

    private void ReleaseAgencySelectionLock()
    {
        _agencySelectionLock?.Dispose();
        _agencySelectionLock = null;
    }

    private string ComputeEditSnapshot() =>
        string.Join("§", _editVm.IncidentNum, _editVm.Description, _editVm.CFSNum, _editVm.LocalNum, _editLocationId, _editOccurredOn);

    private bool HasPendingChanges =>
        _modifyMode &&
        (_editSnapshot != ComputeEditSnapshot()
         || _pendingChargeAdds.Count > 0
         || _pendingChargeRemoves.Count > 0
         || _createdForeignRecords.Count > 0);

    private async Task RequestReleaseAsync()
    {
        if (HasPendingChanges)
            _showReleaseConfirm = true;
        else
            await ExitModifyModeAsync();
    }

    private async Task RequestNewAsync()
    {
        if (_modifyMode)
        {
            if (HasPendingChanges)
            {
                _pendingNavUri = null;
                _pendingNewRecord = true;
                _showReleaseConfirm = true;
            }
            else
            {
                await ExitModifyModeAsync();
                Nav.NavigateTo("/incidents/create");
            }
        }
        else
        {
            Nav.NavigateTo("/incidents/create");
        }
    }

    private void CancelRelease()
    {
        _showReleaseConfirm = false;
        _pendingNewRecord = false;
        _pendingNavUri = null;
    }

    // Where to go once the unsaved-changes prompt is resolved: an intercepted
    // navigation target if set, otherwise the create page for "Save & New".
    private string? PendingReleaseTarget =>
        _pendingNavUri ?? (_pendingNewRecord ? "/incidents/create" : null);

    private async Task SaveAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var target = PendingReleaseTarget;
        _pendingNewRecord = false;
        _pendingNavUri = null;
        if (await TrySaveAsync())
        {
            await ExitModifyModeAsync();
            if (target is not null) Nav.NavigateTo(target);
        }
    }

    private async Task DiscardAndReleaseAsync()
    {
        _showReleaseConfirm = false;
        var target = PendingReleaseTarget;
        _pendingNewRecord = false;
        _pendingNavUri = null;
        await ExitModifyModeAsync();
        if (target is not null) Nav.NavigateTo(target);
    }

    // Intercepts in-app navigation (sidebar links, back) while edits are
    // pending: cancels the navigation and shows the unsaved-changes prompt,
    // remembering where the user was trying to go. The browser-level prompt
    // (tab close / refresh / external links) is handled declaratively by
    // NavigationLock's ConfirmExternalNavigation.
    private void HandleInternalNavigation(LocationChangingContext context)
    {
        if (!HasPendingChanges) return;
        context.PreventNavigation();
        _pendingNewRecord = false;
        _pendingNavUri = context.TargetLocation;
        _showReleaseConfirm = true;
    }

    private void StartLockTimer()
    {
        StopLockTimer();
        _lockSecondsRemaining = (int)_lockTimeout.TotalSeconds;
        _lastServerRenewUtc = DateTime.UtcNow;
        _lockTimer = new System.Threading.Timer(async _ =>
        {
            _lockSecondsRemaining--;
            if (_lockSecondsRemaining <= 0)
            {
                await InvokeAsync(async () =>
                {
                    await ExitModifyModeAsync();
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLockTimer()
    {
        _lockTimer?.Dispose();
        _lockTimer = null;
    }

    // Called when a field commits (blur/change events bubble up to the page container).
    // Restarts the on-screen countdown immediately and renews the server-side lock on a
    // throttle, so an actively-editing user is never timed out while an idle one still is.
    private async Task OnEditActivity()
    {
        if (!_modifyMode) return;
        _lockSecondsRemaining = (int)_lockTimeout.TotalSeconds;
        var now = DateTime.UtcNow;
        if (_renewing || now - _lastServerRenewUtc < RenewInterval) return;
        _renewing = true;
        _lastServerRenewUtc = now;
        try { await IncidentService.RenewLockAsync(_incidentId); }
        catch { /* best-effort; the cleanup sweep honors the last successful renew */ }
        finally { _renewing = false; }
    }

    private async Task LoadLockTimeoutAsync()
    {
        var cfg = await ConfigService.GetAsync(ConfigurationKeys.LockTimeoutSeconds);
        _lockTimeout = LockTimeout.FromConfigValue(cfg?.Value);
    }

    private Task OpenAsync()    => RunActionAsync(() => IncidentService.OpenAsync(_incidentId), "Incident opened.");
    private Task CloseAsync()   => RunActionAsync(() => IncidentService.CloseAsync(_incidentId), "Incident closed.");
    private Task ArchiveAsync() => RunActionAsync(() => IncidentService.ArchiveAsync(_incidentId), "Incident archived.");
    private Task LinkChargeAsync(ChargeDto charge)
    {
        if (_pendingChargeRemoves.Remove(charge.Id))
            return Task.CompletedTask;

        if ((_charges?.Any(c => c.ChargeId == charge.Id) ?? false) || _pendingChargeAdds.ContainsKey(charge.Id))
            return Task.CompletedTask;

        _pendingChargeAdds[charge.Id] = (charge, DateTime.UtcNow);
        return Task.CompletedTask;
    }

    private Task UnlinkChargeAsync(Guid chargeId)
    {
        if (_pendingChargeAdds.Remove(chargeId))
            return Task.CompletedTask;

        if (_charges?.Any(c => c.ChargeId == chargeId) == true)
            _pendingChargeRemoves.Add(chargeId);

        return Task.CompletedTask;
    }

    private void OnOccurredOnChanged(ChangeEventArgs e)
    {
        if (DateTimeLocalInputHelper.TryParseUtcFromLocal(e.Value?.ToString(), out var occurredOn))
        {
            _editOccurredOn = occurredOn;
        }
    }

    private Task SaveRecordAsync() => TrySaveAsync();

    private async Task<bool> TrySaveAsync()
    {
        _actionError = null;
        _successMessage = null;
        _serverMessages?.Clear();
        _editContext.NotifyValidationStateChanged();

        // Field-level client validation before the round-trip; invalid fields
        // show their error inline and the save is aborted.
        if (!_editContext.Validate())
            return false;

        try
        {
            await IncidentService.SavePageAsync(
                _incidentId,
                new IncidentDetailsVo
                {
                    IncidentNum = _editVm.IncidentNum,
                    LocalNum = _editVm.LocalNum,
                    Description = _editVm.Description,
                    CFSNum = _editVm.CFSNum
                },
                _editLocationId,
                _editOccurredOn,
                _pendingChargeAdds.Keys.ToArray(),
                _pendingChargeRemoves.ToArray());
            await LoadAsync();
            _editSnapshot = ComputeEditSnapshot();
            ClearPendingChanges();
            _successMessage = "Record saved successfully.";
            return true;
        }
        catch (DomainException dex)
        {
            if (TryMapDomainErrorToField(dex))
                return false; // surfaced inline at the field; nothing persisted

            _actionError = dex.Message;
            try { await LoadAsync(); } catch { _actionError += " (State may be out of sync — please refresh the page.)"; }
            return false;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            try { await LoadAsync(); } catch { _actionError += " (State may be out of sync — please refresh the page.)"; }
            return false;
        }
    }

    // Maps a domain-rule violation (thrown from the IncidentDetails value object)
    // back onto the field that caused it, so the user sees the error in place
    // instead of a page-level banner. Returns false for codes that aren't
    // field-specific (e.g. lock/concurrency), letting the generic handler show them.
    private bool TryMapDomainErrorToField(DomainException dex)
    {
        if (_serverMessages is null) return false;

        var code = dex.Code;
        var field =
            code.StartsWith("incident.incidentnum", StringComparison.OrdinalIgnoreCase) ? nameof(EditIncidentViewModel.IncidentNum) :
            code.StartsWith("incident.cfsnum", StringComparison.OrdinalIgnoreCase)      ? nameof(EditIncidentViewModel.CFSNum) :
            code.StartsWith("incident.localnum", StringComparison.OrdinalIgnoreCase)    ? nameof(EditIncidentViewModel.LocalNum) :
            code.StartsWith("incident.description", StringComparison.OrdinalIgnoreCase) ? nameof(EditIncidentViewModel.Description) :
            null;

        if (field is null) return false;

        _serverMessages.Add(_editContext.Field(field), dex.Message);
        _editContext.NotifyValidationStateChanged();
        return true;
    }

    // Clear stale server-side field errors as soon as the user edits a field.
    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (_serverMessages is null) return;
        _serverMessages.Clear(e.FieldIdentifier);
        _editContext.NotifyValidationStateChanged();
    }

    private IReadOnlyList<RecordChargeDto>? VisibleCharges =>
        _charges is null
            ? null
            : _charges
                .Where(c => !_pendingChargeRemoves.Contains(c.ChargeId))
                .Concat(_pendingChargeAdds.Values
                    .Where(p => _charges.All(existing => existing.ChargeId != p.Charge.Id))
                    .Select(p => MapCharge(p.Charge, p.LinkedAtUtc)))
                .OrderByDescending(c => c.LinkedAtUtc)
                .ToList();

    private static RecordChargeDto MapCharge(ChargeDto charge, DateTime linkedAtUtc) =>
        new(
            charge.Id,
            charge.OffenseName,
            charge.UcrCode,
            charge.ChargeLevel,
            charge.StateClass,
            charge.IsCitationEligible,
            charge.IsActive,
            linkedAtUtc);

    private async Task SoftDeleteAsync()
    {
        _showDeleteConfirm = false;
        await RunActionAsync(() => IncidentService.SoftDeleteAsync(_incidentId), "Incident deleted.");
    }

    private Task RestoreAsync() => RunActionAsync(() => IncidentService.RestoreAsync(_incidentId), "Incident restored.");

    private async Task ResolveLocationDisplayAsync()
    {
        if (_editLocationId.HasValue)
        {
            var loc = await LocationService.GetByIdAsync(_editLocationId.Value);
            _editLocationDisplay      = loc is null ? null : FormatLocationDisplay(loc);
            _editLocationRecordNumber = loc?.RecordNumber;
        }
        else
        {
            _editLocationDisplay      = null;
            _editLocationRecordNumber = null;
        }
    }

    private void OnLocationSelected(LocationDto loc)
    {
        _editLocationId           = loc.Id;
        _editLocationDisplay      = FormatLocationDisplay(loc);
        _editLocationRecordNumber = loc.RecordNumber;
        _showLocationModal        = false;
    }

    private Task OnLocationCreatedAsync(LocationDto loc)
    {
        TrackCreatedForeignRecord($"Location #{loc.RecordNumber} was created. If you discard this page, it will remain in the system but will not be linked to this incident.");
        return Task.CompletedTask;
    }

    private void OnLocationCleared()
    {
        _editLocationId           = null;
        _editLocationDisplay      = null;
        _editLocationRecordNumber = null;
        _showLocationModal        = false;
    }

    private void ClearLocation()
    {
        _editLocationId           = null;
        _editLocationDisplay      = null;
        _editLocationRecordNumber = null;
    }

    private string? GetReleaseWarningMessage() =>
        _createdForeignRecords.Count == 0 ? null : string.Join(" ", _createdForeignRecords);

    private void TrackCreatedForeignRecord(string message)
    {
        if (!_createdForeignRecords.Contains(message, StringComparer.Ordinal))
            _createdForeignRecords.Add(message);
    }

    private void ClearPendingChanges()
    {
        _pendingChargeAdds.Clear();
        _pendingChargeRemoves.Clear();
        _createdForeignRecords.Clear();
    }

    private static string FormatLocationDisplay(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber))  parts.Add(loc.StreetNumber);
        if (!string.IsNullOrWhiteSpace(loc.StreetAddress)) parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))          parts.Add(loc.City);
        return string.Join(" ", parts);
    }

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnNew     -= HandleShortcutNew;
        ShortcutService.OnModify  -= HandleShortcutModify;
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        if (_editContext is not null)
            _editContext.OnFieldChanged -= HandleFieldChanged;
        // Only clean up the timer. The lock is intentionally NOT released here because
        // the user may be navigating to a child page (e.g. ArrestCreate) that still
        // requires the lock. The lock is released explicitly via "Release Record" or
        // automatically when the 10-minute timeout elapses.
        StopLockTimer();
        ReleaseAgencySelectionLock();
        return ValueTask.CompletedTask;
    }
}

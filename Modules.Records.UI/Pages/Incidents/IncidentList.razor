@page "/incidents"
@implements IDisposable
@inject IIncidentService IncidentService
@inject NavigationManager Nav
@inject IKeyboardShortcutService ShortcutService
@inject IUserLookupService UserLookupService
@using Modules.Records.UI.Services

<PageTitle>Incidents</PageTitle>

<PageHeader Icon="bi-clipboard2-pulse-fill" Title="Incidents" Subtitle="Incident Reports">
    <Actions>
        <a class="btn btn-primary" href="/incidents/create"><i class="bi bi-plus-lg me-1"></i>New Incident</a>
    </Actions>
</PageHeader>

<!-- Search / Filter Panel -->
<div class="card list-filter-card mb-3">
    <div class="card-header list-filter-card-header" role="button" tabindex="0"
         aria-expanded="@(_filterExpanded ? "true" : "false")" aria-controls="incident-filter-body"
         @onclick="ToggleFilter" @onkeydown="HandleFilterKey">
        <span class="list-filter-card-title">
            <i class="bi bi-search me-1"></i>Search / Filter
        </span>
        <i class="bi @(_filterExpanded ? "bi-chevron-up" : "bi-chevron-down") list-filter-card-chevron"></i>
    </div>
@if (_filterExpanded)
{
    <div class="card-body" id="incident-filter-body">
        <div class="row g-2">
            <div class="col-sm-6 col-md-4">
                <label class="form-label mb-1">Incident # contains</label>
                <input class="form-control form-control-sm" @bind="_filterIncidentNum" placeholder="Incident #…" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label class="form-label mb-1">Status</label>
                <input class="form-control form-control-sm" @bind="_filterStatus" placeholder="Status…" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Created from</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateFrom.HasValue ? _filterDateFrom.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateFrom = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label class="form-label mb-1">Created to</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(_filterDateTo.HasValue ? _filterDateTo.Value.ToString("yyyy-MM-dd") : "")"
                       @onchange="@(e => _filterDateTo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            </div>
        </div>
        <div class="list-filter-actions">
            <button class="btn btn-sm btn-primary" @onclick="ApplySearch">Search</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    </div>
}
</div>

@if (!_loading && _error is null && _incidents is not null)
{
    <div class="list-results-summary">
        <div class="list-results-count">
            <strong>@VisibleCount</strong> incident record@(VisibleCount == 1 ? string.Empty : "s")
        </div>
        <div class="list-results-flags">
            @if (ActiveFilterCount > 0)
            {
                <span class="list-summary-chip">
                    <i class="bi bi-funnel-fill"></i>
                    <span>@ActiveFilterCount filter@(ActiveFilterCount == 1 ? string.Empty : "s") applied</span>
                </span>
            }
        </div>
    </div>
}

<StatusMessage Kind="error" Message="@_error" OnDismiss="() => _error = null" />
<StatusMessage Kind="success" Message="@_successMessage" OnDismiss="() => _successMessage = null" />

@if (_loading)
{
    <LoadingSpinner />
}
else if (_incidents is not null)
{
    <div class="table-responsive list-table-shell">
    <table class="table table-hover list-page-table">
        <caption class="visually-hidden">Incidents, sortable by column. Use the search and filter controls above to narrow results.</caption>
        <thead>
            <tr>
                <th style="width:3rem"></th>
                <SortableColumnHeader ColumnKey="id"        Label="ID"
                    CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                <SortableColumnHeader ColumnKey="incident"  Label="Incident #"
                    MobileLabel="Inc #"
                    CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                <SortableColumnHeader ColumnKey="status"    Label="Status"
                    CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                <SortableColumnHeader ColumnKey="arrests"   Label="Arrests"
                    CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
                <th>Lock</th>
                <SortableColumnHeader ColumnKey="created"   Label="Created"
                    MobileLabel="Created"
                    CurrentSortColumn="@_sortColumn" SortAscending="@_sortAscending" OnSort="SortBy" />
            </tr>
        </thead>
        <tbody>
            @if (!SortedIncidents.Any())
            {
                <EmptyState Columns="7"
                            Message="@(ActiveFilterCount > 0 ? "No incidents match your filters." : "No incidents recorded.")"
                            SubMessage="@(ActiveFilterCount > 0 ? "Adjust or clear the filters above to see more results." : "Create an incident record to begin tracking public-safety events.")" />
            }
            @foreach (var i in SortedIncidents)
            {
                <tr>
                    <td>
                        <button class="btn btn-sm row-delete-button" title="Delete incident" aria-label="Delete incident"
                                @onclick="() => InitiateDelete(i.Id, i.Details.IncidentNum)"><i class="bi bi-trash3"></i></button>
                    </td>
                    <td><a href="/incidents/@i.RecordNumber">@i.RecordNumber</a></td>
                    <td><a href="/incidents/@i.RecordNumber">@i.Details.IncidentNum</a></td>
                    <td><StatusBadge Status="@i.Status" /></td>
                    <td>@i.ArrestCount</td>
                    <td><LockBadge IsLocked="@i.IsLocked" LockedByName="@GetLockName(i.LockedByUserId)" Compact="true" /></td>
                    <td>@i.CreatedAtUtc.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="Delete Incident"
               Message="@($"Are you sure you want to delete incident \"{_deleteTargetName}\"?")"
               OnConfirm="ExecuteDeleteAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private bool _filterExpanded = false;
    private IReadOnlyList<IncidentDto>? _incidents;
    private Dictionary<Guid, string> _lockUserNames = [];
    private bool _loading = true;
    private string? _error;
    private string? _successMessage;

    // Delete state
    private bool   _showDeleteConfirm;
    private Guid   _deleteTargetId;
    private string _deleteTargetName = string.Empty;

    private string _sortColumn    = "created";
    private bool   _sortAscending = false;

    // Filter state
    private string    _filterIncidentNum = string.Empty;
    private string    _filterStatus      = string.Empty;
    private DateTime? _filterDateFrom;
    private DateTime? _filterDateTo;
    private int VisibleCount => FilteredIncidents.Count();
    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(_filterIncidentNum) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_filterStatus) ? 0 : 1) +
        (_filterDateFrom.HasValue ? 1 : 0) +
        (_filterDateTo.HasValue ? 1 : 0);

    private IEnumerable<IncidentDto> FilteredIncidents =>
        _incidents is null ? [] :
        _incidents.Where(i =>
            (string.IsNullOrWhiteSpace(_filterIncidentNum) || (i.Details.IncidentNum?.Contains(_filterIncidentNum, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrWhiteSpace(_filterStatus)      || (i.Status?.Contains(_filterStatus, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (!_filterDateFrom.HasValue || i.CreatedAtUtc.Date >= _filterDateFrom.Value.Date) &&
            (!_filterDateTo.HasValue   || i.CreatedAtUtc.Date <= _filterDateTo.Value.Date));

    private IEnumerable<IncidentDto> SortedIncidents =>
        (_sortColumn, _sortAscending) switch
        {
            ("id",       true)  => FilteredIncidents.OrderBy(x => x.RecordNumber),
            ("id",       false) => FilteredIncidents.OrderByDescending(x => x.RecordNumber),
            ("incident", true)  => FilteredIncidents.OrderBy(x => x.Details.IncidentNum),
            ("incident", false) => FilteredIncidents.OrderByDescending(x => x.Details.IncidentNum),
            ("status",   true)  => FilteredIncidents.OrderBy(x => x.Status),
            ("status",   false) => FilteredIncidents.OrderByDescending(x => x.Status),
            ("arrests",  true)  => FilteredIncidents.OrderBy(x => x.ArrestCount),
            ("arrests",  false) => FilteredIncidents.OrderByDescending(x => x.ArrestCount),
            ("created",  true)  => FilteredIncidents.OrderBy(x => x.CreatedAtUtc),
            _                   => FilteredIncidents.OrderByDescending(x => x.CreatedAtUtc),
        };

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    protected override async Task OnInitializedAsync()
    {
        ShortcutService.OnNew += HandleShortcutNew;
        try
        {
            _incidents = await IncidentService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleShortcutNew() => InvokeAsync(() => Nav.NavigateTo("/incidents/create"));

    public void Dispose() => ShortcutService.OnNew -= HandleShortcutNew;

    private string? GetLockName(Guid? userId) =>
        userId.HasValue ? _lockUserNames.GetValueOrDefault(userId.Value) : null;

    private async Task ResolveLockedNamesAsync()
    {
        if (_incidents is null) return;
        var ids = _incidents.Where(i => i.IsLocked && i.LockedByUserId.HasValue)
                            .Select(i => i.LockedByUserId!.Value).Distinct();
        _lockUserNames = await UserLookupService.GetDisplayNamesAsync(ids);
    }

    private void ToggleFilter() => _filterExpanded = !_filterExpanded;

    private void HandleFilterKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
            _filterExpanded = !_filterExpanded;
    }

    private void InitiateDelete(Guid id, string name)
    {
        _error           = null;
        _successMessage  = null;
        _deleteTargetId    = id;
        _deleteTargetName  = name;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        _showDeleteConfirm = false;
        try
        {
            await IncidentService.SoftDeleteAsync(_deleteTargetId);
            _incidents = await IncidentService.GetByJurisdictionAsync();
            await ResolveLockedNamesAsync();
            _successMessage = string.IsNullOrWhiteSpace(_deleteTargetName)
                ? "Incident deleted."
                : $"Incident \"{_deleteTargetName}\" deleted.";
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void ApplySearch() => StateHasChanged();

    private void ClearFilters()
    {
        _filterIncidentNum = string.Empty;
        _filterStatus      = string.Empty;
        _filterDateFrom    = null;
        _filterDateTo      = null;
        StateHasChanged();
    }
}

@page "/incidents/create"
@implements IAsyncDisposable
@inject IIncidentService IncidentService
@inject IAgencyConfigurationService ConfigService
@inject IKeyboardShortcutService ShortcutService
@inject NavigationManager Nav
@using IncidentDetailsVo = Modules.Records.Domain.ValueObjects.IncidentDetails

<PageTitle>New Incident</PageTitle>

<div class="page-header record-page-header">
    <div>
        <h2 class="page-header-title"><i class="bi bi-clipboard2-pulse-fill"></i> New Incident</h2>
        <div class="page-header-sub">Create the initial report and open the incident record for follow-up work.</div>
    </div>
</div>

@if (_vm.ErrorMessage is not null)
{
    <div class="alert alert-danger">@_vm.ErrorMessage</div>
}

<div class="record-form-shell">
<EditForm Model="_vm" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="record-validation-summary" />
    <div class="card record-form-card mb-3">
        <div class="card-body">
            <div class="record-form-header">
                <h6 class="card-title">Incident Details</h6>
                <p class="record-form-note">Capture the primary incident identifiers first. Linked arrests, citations, and location details can be added after the report is opened.</p>
            </div>
            <div class="record-grid-2">
            <div class="mb-0">
                <label class="form-label">Incident Number</label>
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="_vm.IncidentNum"
                               placeholder="@(_hasFormat ? "Leave blank to auto-generate" : "")" />
                    @if (_hasFormat)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="GenerateAsync"
                                disabled="@_generating" title="Generate next incident number">
                            @(_generating ? "…" : "🔁 Generate")
                        </button>
                    }
                </div>
                <ValidationMessage For="() => _vm.IncidentNum" />
                @if (_hasFormat)
                {
                    <div class="form-text text-muted">A number will be auto-generated if you leave this blank.</div>
                }
            </div>
            <div class="mb-0 record-field-span-2">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="_vm.Description" rows="3" />
                <ValidationMessage For="() => _vm.Description" />
            </div>
            <div class="mb-0">
                <label class="form-label">CFS Number <span class="text-muted">(optional, max 30 chars)</span></label>
                <InputText class="form-control" @bind-Value="_vm.CFSNum" maxlength="30" />
                <ValidationMessage For="() => _vm.CFSNum" />
            </div>
            <div class="mb-0">
                <label class="form-label">Local Number <span class="text-muted">(optional)</span></label>
                <InputText class="form-control" @bind-Value="_vm.LocalNum" />
                <ValidationMessage For="() => _vm.LocalNum" />
            </div>
            </div>
        </div>
    </div>
    <div class="record-form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_submitting">
            @(_submitting ? "Creating…" : "Create Incident")
        </button>
        <a class="btn btn-secondary" href="/incidents">Cancel</a>
    </div>
</EditForm>
</div>

<UnsavedChangesDialog Visible="_showCancelConfirm"
                      SaveLabel="Submit Record"
                      DiscardLabel="Discard"
                      ActionDescription="leaving the form"
                      OnSaveAndRelease="SubmitFromDialogAsync"
                      OnDiscard="DiscardAndCancelAsync"
                      OnCancel="() => _showCancelConfirm = false" />

@code {
    private readonly CreateIncidentViewModel _vm = new();
    private bool _submitting;
    private bool _hasFormat;
    private bool _generating;
    private bool _showCancelConfirm;

    private bool HasEnteredData =>
        !string.IsNullOrEmpty(_vm.IncidentNum) ||
        !string.IsNullOrEmpty(_vm.Description) ||
        !string.IsNullOrEmpty(_vm.CFSNum)      ||
        !string.IsNullOrEmpty(_vm.LocalNum);

    protected override async Task OnInitializedAsync()
    {
        ShortcutService.OnRelease += HandleShortcutRelease;
        ShortcutService.OnSave    += HandleShortcutSave;
        _hasFormat = true;
        await Task.CompletedTask;
    }

    private void HandleShortcutSave()
        => InvokeAsync(async () => { await SubmitAsync(); StateHasChanged(); });

    private void HandleShortcutRelease()
        => InvokeAsync(() => { HandleEscape(); StateHasChanged(); });

    private void HandleEscape()
    {
        if (HasEnteredData)
            _showCancelConfirm = true;
        else
            Nav.NavigateTo("/incidents");
    }

    private async Task SubmitFromDialogAsync()
    {
        _showCancelConfirm = false;
        await SubmitAsync();
    }

    private void DiscardAndCancelAsync() => Nav.NavigateTo("/incidents");

    public ValueTask DisposeAsync()
    {
        ShortcutService.OnRelease -= HandleShortcutRelease;
        ShortcutService.OnSave    -= HandleShortcutSave;
        return ValueTask.CompletedTask;
    }

    private async Task GenerateAsync()
    {
        _generating = true;
        _vm.ErrorMessage = null;
        try
        {
            _vm.IncidentNum = await ConfigService.GenerateIncidentNumAsync();
        }
        catch (Exception ex)
        {
            _vm.ErrorMessage = ex.Message;
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _vm.ErrorMessage = null;

        try
        {
            var id = await IncidentService.CreateAsync(new IncidentDetailsVo
            {
                IncidentNum = _vm.IncidentNum,
                Description = _vm.Description,
                CFSNum      = _vm.CFSNum,
                LocalNum    = _vm.LocalNum
            });
            Nav.NavigateTo($"/incidents/{id}?autoModify=true");
        }
        catch (Exception ex)
        {
            _vm.ErrorMessage = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}

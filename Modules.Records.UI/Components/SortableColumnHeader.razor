<th class="sortable-column-header" aria-sort="@AriaSort" style="white-space:nowrap;">
    <button type="button" class="sortable-column-header-btn" @onclick="HandleClick"
            title="Sort by @Label" aria-label="Sort by @Label">
        <span class="sortable-column-header-full">@Label</span><span class="sortable-column-header-short">@DisplayMobileLabel</span>
        @if (CurrentSortColumn == ColumnKey)
        {
            <span class="ms-1 text-muted small" aria-hidden="true">@(SortAscending ? "▲" : "▼")</span>
        }
        else
        {
            <span class="ms-1 text-muted small opacity-25" aria-hidden="true">⇅</span>
        }
    </button>
</th>

@code {
    [Parameter, EditorRequired] public string ColumnKey          { get; set; } = "";
    [Parameter, EditorRequired] public string Label              { get; set; } = "";
    [Parameter]                 public string? MobileLabel       { get; set; }
    [Parameter]                 public string CurrentSortColumn  { get; set; } = "";
    [Parameter]                 public bool   SortAscending      { get; set; }
    [Parameter]                 public EventCallback<string> OnSort { get; set; }

    private string DisplayMobileLabel => string.IsNullOrWhiteSpace(MobileLabel) ? Label : MobileLabel;

    // Announces the current sort state of this column to assistive tech.
    private string AriaSort =>
        CurrentSortColumn == ColumnKey ? (SortAscending ? "ascending" : "descending") : "none";

    private Task HandleClick() => OnSort.InvokeAsync(ColumnKey);
}

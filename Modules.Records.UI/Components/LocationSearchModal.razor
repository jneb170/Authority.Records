@inject ILocationService LocationService
@using Modules.Records.Application.DTOs
@using Modules.Records.UI.Services

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background:rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt-fill me-2"></i>Search Locations</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Inputs -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-5">
                            <input class="form-control form-control-sm" @bind="_searchAddress" @bind:event="oninput"
                                   placeholder="Address contains…" @onkeydown="HandleKeyDown" />
                        </div>
                        <div class="col-sm-3">
                            <input class="form-control form-control-sm" @bind="_searchCity" @bind:event="oninput"
                                   placeholder="City…" @onkeydown="HandleKeyDown" />
                        </div>
                        <div class="col-sm-2">
                            <input class="form-control form-control-sm" @bind="_searchZip" @bind:event="oninput"
                                   placeholder="ZIP…" maxlength="10" @onkeydown="HandleKeyDown" />
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-sm btn-primary w-100" @onclick="RunSearchAsync">Search</button>
                        </div>
                    </div>

                    @if (_loading)
                    {
                        <LoadingSpinner />
                    }
                    else if (_error is not null)
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }
                    else if (_results is not null)
                    {
                        @if (!_results.Any())
                        {
                            <p class="text-muted small">No locations found.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var loc in _results)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action py-2"
                                            @onclick="() => Select(loc)">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <span class="fw-semibold">@FormatAddress(loc)</span>
                                                @if (!string.IsNullOrWhiteSpace(loc.CommonPlaceName))
                                                {
                                                    <span class="text-muted ms-2 small">(@loc.CommonPlaceName)</span>
                                                }
                                            </div>
                                            <span class="text-muted small ms-3 text-nowrap">#@loc.RecordNumber</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">Enter search criteria above and press Search.</p>
                    }
                </div>
                <div class="modal-footer">
                    @if (AllowClear && CurrentLocationId.HasValue)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm me-auto" @onclick="Clear">
                            <i class="bi bi-x-lg me-1"></i>Clear Location
                        </button>
                    }
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Guid? CurrentLocationId { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public EventCallback<LocationDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnCleared { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _searchAddress = string.Empty;
    private string _searchCity    = string.Empty;
    private string _searchZip     = string.Empty;
    private IReadOnlyList<LocationDto>? _results;
    private bool _loading;
    private string? _error;

    private async Task RunSearchAsync()
    {
        _loading = true;
        _error   = null;
        _results = null;
        try
        {
            _results = await LocationService.SearchAsync(
                addressContains: string.IsNullOrWhiteSpace(_searchAddress) ? null : _searchAddress,
                city:            string.IsNullOrWhiteSpace(_searchCity)    ? null : _searchCity,
                zip:             string.IsNullOrWhiteSpace(_searchZip)     ? null : _searchZip);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await RunSearchAsync();
    }

    private async Task Select(LocationDto loc)
    {
        Reset();
        await OnSelected.InvokeAsync(loc);
    }

    private async Task Clear()
    {
        Reset();
        await OnCleared.InvokeAsync();
    }

    private async Task Cancel()
    {
        Reset();
        await OnCancelled.InvokeAsync();
    }

    private void Reset()
    {
        _searchAddress = string.Empty;
        _searchCity    = string.Empty;
        _searchZip     = string.Empty;
        _results       = null;
        _error         = null;
    }

    private static string FormatAddress(LocationDto loc)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(loc.StreetNumber)) parts.Add(loc.StreetNumber);
        parts.Add(loc.StreetAddress);
        if (!string.IsNullOrWhiteSpace(loc.City))
        {
            parts.Add($"{loc.City},");
        }
        if (!string.IsNullOrWhiteSpace(loc.Zip)) parts.Add(loc.Zip);
        return string.Join(" ", parts);
    }
}

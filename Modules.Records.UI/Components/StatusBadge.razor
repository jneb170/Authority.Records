@using Modules.Records.Domain.Common

<span class="record-pill @BadgeClass">
    <i class="@BadgeIcon" aria-hidden="true"></i>
    <span>@Status</span>
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;

    private string BadgeClass => Status switch
    {
        nameof(RecordStatus.Draft)     => "record-pill-neutral",
        nameof(RecordStatus.Open)      => "record-pill-primary",
        nameof(RecordStatus.Closed)    => "record-pill-success",
        nameof(RecordStatus.Archived)  => "record-pill-warning",
        _                              => "record-pill-neutral"
    };

    private string BadgeIcon => Status switch
    {
        nameof(RecordStatus.Draft)     => "bi bi-pencil-square",
        nameof(RecordStatus.Open)      => "bi bi-unlock-fill",
        nameof(RecordStatus.Closed)    => "bi bi-check2-circle",
        nameof(RecordStatus.Archived)  => "bi bi-archive-fill",
        _                              => "bi bi-circle-fill"
    };
}

<div class="mugshot-thumb @(Compact ? "mugshot-thumb-compact" : string.Empty)">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="@Alt" class="mugshot-thumb-image" />
    }
    else
    {
        <div class="mugshot-thumb-placeholder" aria-label="@Alt">
            <i class="bi bi-person-bounding-box" aria-hidden="true"></i>
        </div>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string Alt { get; set; } = "Mugshot preview";
    [Parameter] public bool Compact { get; set; }
}

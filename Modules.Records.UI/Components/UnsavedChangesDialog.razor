@if (Visible)
{
    <div class="modal d-block ar-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content ar-modal-content ar-modal-content-warning">
                <div class="modal-header ar-modal-header">
                    <div class="ar-modal-title-wrap">
                        <span class="ar-modal-icon ar-modal-icon-warning">
                            <i class="bi bi-floppy-fill" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-semibold mb-0">Unsaved Changes</h5>
                            <div class="ar-modal-subtitle">Save or discard your edits before continuing.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-body ar-modal-body">
                    <p class="mb-0">You have unsaved changes. Would you like to save before @ActionDescription?</p>
                </div>
                <div class="modal-footer ar-modal-footer gap-2">
                    <button class="btn btn-secondary btn-sm" @onclick="Cancel">Cancel</button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="Discard">@DiscardLabel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveAndRelease">@SaveLabel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string SaveLabel { get; set; } = "Save & Release";
    [Parameter] public string DiscardLabel { get; set; } = "Discard";
    [Parameter] public string ActionDescription { get; set; } = "releasing the record";
    [Parameter] public EventCallback OnSaveAndRelease { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task SaveAndRelease() => OnSaveAndRelease.InvokeAsync();
    private Task Discard() => OnDiscard.InvokeAsync();
    private Task Cancel() => OnCancel.InvokeAsync();
}
